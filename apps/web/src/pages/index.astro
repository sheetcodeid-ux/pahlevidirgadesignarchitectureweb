<script>
  import { bentukLogo } from "../lib/logoBentuk";
  import { pantauStrip, type Kendali } from "../lib/strip";

  (() => {
    "use strict";
    const diam = matchMedia("(prefers-reduced-motion: reduce)").matches;

    /* ── Ukuran logo klien ────────────────────────────────────────────
     *
     * Satu batas tinggi untuk semua logo TERLIHAT tidak konsisten, dan itu
     * bukan perasaan: wordmark panjang berhenti di batas lebar 150px sementara
     * logo petak berhenti di batas tinggi 34px, jadi yang petak tampil sebagai
     * benda mungil di sebelah tetangganya walau berkas aslinya sama besar.
     * Yang menyamakan bukan satu angka melainkan angka per bentuk.
     *
     * Bentuknya dibaca dari berkasnya sendiri, bukan disimpan di database.
     * Alasannya: rasio adalah sifat gambarnya, bukan keputusan yang perlu
     * diurus siapa pun — menyimpannya berarti satu kolom yang bisa menyimpang
     * dari berkas yang diwakilinya, plus migrasi dan pengisian ulang untuk
     * delapan logo yang sudah telanjur diunggah. Di sini ia selalu benar,
     * termasuk untuk logo yang diunggah besok.
     *
     * Menghentikan animasi dan membesarkan saat disentuh TIDAK ada di sini —
     * keduanya CSS murni, jadi tetap bekerja walau skrip ini gagal dimuat. */
    document.querySelectorAll<HTMLImageElement>(".mq__logo").forEach((img) => {
      // naturalWidth baru terisi setelah berkasnya sampai. Gambar yang sudah
      // ada di cache peramban melewatkan peristiwa "load" sepenuhnya, jadi
      // `complete` diperiksa lebih dulu — tanpa itu, memuat ulang halaman
      // justru membuat separuh logonya tidak pernah dikelompokkan.
      const pasang = () => {
        if (!img.naturalWidth || !img.naturalHeight) return;
        img.classList.add(`mq__logo--${bentukLogo(img.naturalWidth, img.naturalHeight)}`);
      };
      if (img.complete) pasang();
      else img.addEventListener("load", pasang, { once: true });
    });

    /* ── Marquee dijeda saat tidak terlihat ───────────────────────────
       Animasi CSS tidak berhenti sendiri begitu elemennya keluar layar; ia
       terus berjalan selama halaman terbuka. Untuk baris logo setinggi 74px
       di bagian atas halaman, itu berarti compositor tetap disuruh bekerja
       walau pengunjung sudah membaca bagian paling bawah — pekerjaan yang
       tidak pernah dilihat siapa pun, dan justru jenis pekerjaan yang
       membuat perangkat menghangat.

       rootMargin 200px: dijalankan sedikit SEBELUM terlihat, supaya tidak
       ada yang menangkapnya dalam keadaan diam lalu tiba-tiba bergerak. */
    const mqWadah = document.querySelector<HTMLElement>(".mq");
    if (mqWadah && "IntersectionObserver" in window) {
      mqWadah.classList.add("mq--diam");
      new IntersectionObserver(
        ([e]) => mqWadah.classList.toggle("mq--diam", !e.isIntersecting),
        { rootMargin: "200px 0px" },
      ).observe(mqWadah);
    }

    /* ── Showcase: tab + strip per proyek ─────────────────────────────── */
    const tabs = document.getElementById("swTabs");
    const ind = document.getElementById("swInd");
    if (tabs && ind) {
      const tombol = [...tabs.querySelectorAll<HTMLButtonElement>(".tab")];
      const blokSorot = [...document.querySelectorAll<HTMLElement>("[data-sorot]")];
      const blokStrip = [...document.querySelectorAll<HTMLElement>("[data-strip]")];

      /* Gambar proyek yang belum pernah ditampilkan baru dipasang di sini.
         Sekali jalan per blok: setelah `src` terisi, `data-src` dibuang, jadi
         memilih tab yang sama dua kali tidak memicu apa-apa. */
      const pasangGambar = (blok: HTMLElement | undefined) => {
        blok?.querySelectorAll<HTMLImageElement>("img[data-src]").forEach((g) => {
          g.src = g.dataset.src!;
          delete g.dataset.src;
        });
      };
      const bawaKeTampak = (b: HTMLElement) => {
        const kiri = b.offsetLeft;
        const kanan = kiri + b.offsetWidth;
        if (kiri < tabs.scrollLeft) tabs.scrollLeft = kiri - 24;
        else if (kanan > tabs.scrollLeft + tabs.clientWidth) tabs.scrollLeft = kanan - tabs.clientWidth + 24;
      };
      const geserInd = (b: HTMLElement) => {
        ind.style.width = b.offsetWidth + "px";
        ind.style.transform = `translateX(${b.offsetLeft}px)`;
      };
      const pilih = (i: number) => {
        tombol.forEach((b, k) => {
          b.setAttribute("aria-selected", String(k === i));
          b.tabIndex = k === i ? 0 : -1;
        });
        blokSorot.forEach((b, k) => (b.hidden = k !== i));
        blokStrip.forEach((b, k) => (b.hidden = k !== i));
        geserInd(tombol[i]);
        // Bilah tab bisa lebih panjang daripada layarnya sejak showcase
        // memuat SELURUH proyek. Tab yang dipilih lewat papan tuts bisa
        // berada di luar tampak, dan tab aktif yang tak terlihat membuat
        // bilahnya tampak tidak merespons. scrollIntoView tidak dipakai:
        // ia ikut menggulir HALAMAN walau diberi block:"nearest".
        bawaKeTampak(tombol[i]);
        tandaLuber();
        pasangGambar(blokStrip[i]);
        // Strip yang baru muncul belum pernah dihitung lebarnya selagi
        // tersembunyi — scrollWidth-nya 0 dan bar kemajuannya salah.
        hitungSemua();
      };
      tombol.forEach((b, i) => b.addEventListener("click", () => pilih(i)));
      /* role="tablist" menjanjikan panah kiri/kanan berpindah tab — itu
         perjanjian ARIA, bukan tambahan. Selama showcase cuma tiga tab dan
         semuanya terlihat, ketiadaannya tidak kentara; dengan enam tab yang
         sebagian di luar layar, ia jadi satu-satunya cara berpindah tanpa
         tetikus. */
      tabs.addEventListener("keydown", (e) => {
        const arah = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
        if (!arah) return;
        e.preventDefault();
        const kini = tombol.findIndex((b) => b.getAttribute("aria-selected") === "true");
        const ke = (kini + arah + tombol.length) % tombol.length;
        pilih(ke);
        tombol[ke].focus();
      });
      if (tombol.length) geserInd(tombol[0]);
      /* Penanda "masih ada tab di sebelah sana". Dipasang dari JS, bukan
         CSS: yang menentukan meluber atau tidak adalah scrollWidth, dan CSS
         tidak bisa membacanya. Tanpa ini, di ponsel enam tab terpotong di
         tepi layar tanpa satu pun tanda bahwa ia bisa digeser — dan tab
         yang terpotong rata terbaca sebagai daftar yang memang segitu. */
      const tandaLuber = () => {
        tabs.dataset.kiri = String(tabs.scrollLeft > 4);
        tabs.dataset.kanan = String(tabs.scrollLeft + tabs.clientWidth < tabs.scrollWidth - 4);
      };
      tandaLuber();
      tabs.addEventListener("scroll", tandaLuber, { passive: true });
      addEventListener("resize", tandaLuber);
      addEventListener("resize", () => {
        const aktif = tombol.find((b) => b.getAttribute("aria-selected") === "true");
        if (aktif) geserInd(aktif);
      });
    }

    /* ── Strip foto (dipakai tiap blok showcase) ──────────────────────── */
    const strips = [...document.querySelectorAll<HTMLElement>("[data-gulir]")];
    /* Satu kendali per strip, dibuat sekali. Strip yang tersembunyi tetap
       dipasang — yang tidak sah cuma ANGKA-nya, dan itu diperbarui lewat
       `ukur()` begitu tabnya dibuka. */
    const kendali = new Map<HTMLElement, Kendali>();
    strips.forEach((strip) => {
      const induk = strip.parentElement!;
      const kartu = [...strip.children] as HTMLElement[];
      if (!kartu.length) return;
      /* Keterangan foto dibaca SEKALI di sini, bukan tiap kali penandanya
         berpindah: isinya tidak pernah berubah, dan membacanya dari DOM di
         tengah gerakan jari berarti menyentuh pohon yang sedang digulir. */
      const ket = kartu.map((k) => k.querySelector(".foto__ket")?.textContent?.trim() ?? "");
      kendali.set(strip, pantauStrip({
        strip,
        prog: induk.querySelector<HTMLElement>("[data-prog]"),
        film: induk.querySelector<HTMLElement>("[data-film]"),
        info: induk.querySelector<HTMLElement>("[data-info]"),
        teks: (ke, jumlah) => `${ke + 1} / ${jumlah}${ket[ke] ? ` — ${ket[ke]}` : ""}`,
      }));
    });
    function hitungSemua() {
      strips.forEach((s) => {
        const blok = s.closest<HTMLElement>("[data-strip]");
        if (blok && !blok.hidden) kendali.get(s)?.ukur();
      });
    }
    strips.forEach((strip) => {
      const induk = strip.parentElement!;
      const kartu = [...strip.children] as HTMLElement[];
      induk.querySelector("[data-film]")?.addEventListener("click", (e) => {
        const b = (e.target as HTMLElement).closest("button");
        if (!b) return;
        strip.scrollTo({ left: kartu[Number(b.dataset.ke)].offsetLeft, behavior: diam ? "auto" : "smooth" });
      });
      let seret = false;
      let mx = 0;
      let kiri = 0;
      strip.addEventListener("pointerdown", (e) => {
        if (e.pointerType !== "mouse") return;
        seret = true;
        mx = e.clientX;
        kiri = strip.scrollLeft;
        strip.classList.add("tarik");
        strip.setPointerCapture(e.pointerId);
      });
      strip.addEventListener("pointermove", (e) => {
        if (seret) strip.scrollLeft = kiri - (e.clientX - mx);
      });
      const lepas = () => {
        if (seret) {
          seret = false;
          strip.classList.remove("tarik");
        }
      };
      strip.addEventListener("pointerup", lepas);
      strip.addEventListener("pointercancel", lepas);
      strip.tabIndex = 0;
      strip.addEventListener("keydown", (e) => {
        if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
        e.preventDefault();
        strip.scrollBy({ left: (e.key === "ArrowRight" ? 1 : -1) * 460, behavior: diam ? "auto" : "smooth" });
      });
    });
    hitungSemua();
  })();
</script>

<script>
  /* Blok bertanda .wahyu muncul saat masuk layar. IntersectionObserver, bukan
     listener scroll: pengamat tidak dipanggil di tiap frame gulir, jadi ia
     tidak ikut menahan gulir di ponsel.

     Sekali muncul, pengamatannya DILEPAS. Blok yang menghilang lagi saat
     digulir balik bukan gaya, itu gangguan — dan di halaman sepanjang ini
     pengunjung sering menggulir naik-turun untuk membandingkan dua bagian. */
  (() => {
    "use strict";
    const blok = document.querySelectorAll<HTMLElement>(".wahyu");
    if (!blok.length) return;

    // Tanpa IntersectionObserver — peramban tua — semuanya langsung tampil.
    if (!("IntersectionObserver" in window)) {
      blok.forEach((b) => b.classList.add("tampak"));
      return;
    }

    const pengamat = new IntersectionObserver(
      (masuk) => {
        masuk.forEach((e) => {
          if (!e.isIntersecting) return;
          (e.target as HTMLElement).classList.add("tampak");
          pengamat.unobserve(e.target);
        });
      },
      /* rootMargin bawah -8%: blok dianggap masuk sedikit SEBELUM tepi bawah,
         supaya animasinya sudah selesai waktu mata sampai ke sana. */
      { threshold: 0.06, rootMargin: "0px 0px -8% 0px" },
    );

    blok.forEach((b) => pengamat.observe(b));
  })();
</script>

<script>
  /* ── Tab kelompok tarif ───────────────────────────────────────────────
     Kedua kelompok dirender penuh ke HTML; yang tidak aktif disembunyikan
     DI SINI, bukan lewat atribut `hidden` di markup. Bedanya penting: HTML
     yang disajikan server tetap memuat keenam tier beserta angkanya, jadi
     mesin pencari dan pengunjung tanpa JS melihat seluruh daftar harga.
     Kalau suatu saat ini dipindah ke markup, separuh daftarnya hilang dari
     hasil pencarian tanpa satu pun tanda.

     `hidden`, bukan style.display: publik.css menegakkan
     [hidden]{display:none!important}, dan memakai atributnya berarti
     panelnya juga hilang dari pembaca layar dan urutan fokus. */
  (() => {
    "use strict";
    const alih = document.getElementById("tarifAlih");
    if (!alih) return;
    const tombol = [...alih.querySelectorAll<HTMLButtonElement>("[data-grup]")];
    const panel = [...document.querySelectorAll<HTMLElement>(".tarif-grup")];
    if (tombol.length < 2 || panel.length < 2) return;

    const pilih = (kunci: string) => {
      tombol.forEach((b) => b.setAttribute("aria-selected", String(b.dataset.grup === kunci)));
      panel.forEach((p) => { p.hidden = p.dataset.grup !== kunci; });
    };
    pilih(tombol[0].dataset.grup!);
    alih.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-grup]");
      if (b) pilih(b.dataset.grup!);
    });
    /* Panah kiri-kanan, perilaku baku tablist. */
    alih.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
      const i = tombol.findIndex((b) => b.getAttribute("aria-selected") === "true");
      const ke = tombol[(i + (e.key === "ArrowRight" ? 1 : tombol.length - 1)) % tombol.length];
      pilih(ke.dataset.grup!);
      ke.focus();
    });
  })();
</script>
