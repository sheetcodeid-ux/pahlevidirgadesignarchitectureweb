---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  listProjects,
  listClients,
  listTestimonials,
  getSettings,
  subjudulBerguna,
  CATEGORY_LABELS_EN,
  type Project,
  type ProjectImage,
} from "../lib/api";
import { SOROTAN_FAQ } from "../lib/faq";

const settings = await getSettings();
const kota = settings.city?.trim() || "Indonesia";

const semua = await listProjects({ limit: 200 });
/* Daftar klien datang dari database, diurus pemilik lewat /admin/klien.
   Sebelumnya ia daftar teks yang di-hardcode di lib/menunggu.ts — logonya
   sudah dikirim pemilik tapi yang tayang cuma namanya. */
const klien = await listClients();
const testimoni = await listTestimonials(true);

/* Showcase: proyek yang diunggulkan lebih dulu, lalu yang terbaru.
   SELURUHNYA, tidak dipotong. Dulu dipotong tiga dengan alasan "bilah tabnya
   dirancang untuk tiga" — dan itu keliru dua kali: bilahnya memang bisa
   digulir mendatar sejak awal, dan pemotongannya membuat pemilik yang sudah
   memasukkan enam proyek cuma melihat tiga di berandanya sendiri. Kalau
   suatu saat proyeknya puluhan, yang membatasi harus keputusan sadar di
   sini, bukan angka yang tertinggal dari rancangan bilah. */
const tahunDari = (p: Project) => p.year ?? (p.publishedAt ? new Date(p.publishedAt).getFullYear() : 0);
const sorot = [...semua]
  .sort((a, b) => Number(b.isFeatured) - Number(a.isFeatured) || tahunDari(b) - tahunDari(a));

// Foto yang dipakai di tiga blok proses. Diambil dari proyek yang ada, bukan
// dari berkas statis — kalau belum ada fotonya, bloknya tetap tampil tanpa
// gambar dan tidak menampilkan kotak kosong bergaris.
interface FotoBerlabel extends ProjectImage {
  proyek: string;
}
const semuaFoto: FotoBerlabel[] = sorot.flatMap((p) =>
  (p.images ?? []).map((f) => ({ ...f, proyek: p.title })),
);
/* Satu foto per proyek, bukan sepuluh dari proyek yang sama. Waktu showcase
   masih dipotong tiga, mengambil foto ke-0, tengah, dan terakhir dari daftar
   gabungan kebetulan menghasilkan tiga proyek berbeda. Dengan enam proyek
   daftar itu jadi 60 foto dan ketiganya jatuh di proyek yang sama. */
const fotoPerProyek: FotoBerlabel[] = sorot
  .map((p) => (p.images ?? [])[0])
  .filter((f): f is ProjectImage => Boolean(f))
  .map((f, i) => ({ ...f, proyek: sorot[i].title }));
const fotoProses = fotoPerProyek.slice(0, 3);

// Foto besar di bawah hero. Diambil dari daftar berlabel yang sama supaya
// keterangannya bisa menyebut proyek asalnya.
const heroFoto: FotoBerlabel | null = semuaFoto[0] ?? null;

/* Marquee "materials & partners we specify" — isinya dari lib/menunggu.ts,
   satu-satunya tempat data yang masih ditunggu pemilik disimpan. */

const proses = [
  {
    no: "01. LISTEN",
    judul: "We start from how you live, not from a style.",
    teks: "One long conversation, then a written brief you can correct yourself — in your own words, in your own time zone.",
  },
  {
    no: "02. DRAW",
    judul: "Concept, plans and construction drawings — all reviewable from a phone.",
    teks: "Every document can be approved or sent back for changes right in your project page, with the whole conversation kept next to it.",
  },
  {
    no: "03. BUILD & STAY",
    judul: "You know where the project is, every week.",
    teks: "Site photos, invoices and payment receipts land in the same page. No news gets lost between a WhatsApp thread and a spreadsheet.",
  },
];

const IKON: Record<string, string> = {
  globe: "M10 1a9 9 0 100 18 9 9 0 000-18ZM1 10h18M10 1c2.5 2.4 3.8 5.4 3.8 9S12.5 17.6 10 19c-2.5-1.4-3.8-4.4-3.8-9S7.5 3.4 10 1Z",
  mata: "M1 10s3.3-5.5 9-5.5S19 10 19 10s-3.3 5.5-9 5.5S1 10 1 10Zm9 2.2a2.2 2.2 0 100-4.4 2.2 2.2 0 000 4.4Z",
  kunci: "M5 9V6.5a5 5 0 0110 0V9M3.5 9h13v8.5h-13V9Z",
  kirim: "M18.5 1.5 9 11M18.5 1.5 12.5 18.5 9 11 1.5 7.5 18.5 1.5Z",
  berkas: "M11.5 1.5H4.5v17h11V5.5l-4-4Zm0 0v4h4",
  jam: "M10 1a9 9 0 100 18 9 9 0 000-18Zm0 4.5V10l3 2",
};
const fitur: [keyof typeof IKON, string, string][] = [
  ["globe", "We work across time zones", "Every approval happens in your project page, so nothing waits for office hours in Jakarta."],
  ["mata", "You always know where it stands", "Phases, documents and site photos are open whenever you open the link."],
  ["kirim", "Money in is recorded, not promised", "Every payment gets a receipt number you can open yourself from WhatsApp."],
  ["berkas", "Drawings you can approve or push back", "With the whole thread kept beside them, so no two versions get confused."],
  ["kunci", "Your project data stays closed", "Only you and the studio can open it. Tested, not assumed."],
  ["jam", "First reply under 24 hours", "A small studio — which is exactly why your message doesn’t pile up."],
];

const janji = [
  ["M10 1a9 9 0 100 18 9 9 0 000-18ZM10 5.5V10l3 2", "A reply within 24 hours", "Small studio — which is exactly why your message doesn’t queue."],
  ["M11.5 1.5h-7v17h11V5.5l-4-4Zm0 0v4h4M7 11h6M7 14h4", "Every drawing approved online", "Approve or request changes from your phone, with the whole thread kept."],
  ["M2.5 5.5h15v9h-15zM2.5 9h15M5.5 12h3", "Receipts you can open yourself", "Every payment gets a link. No “trust me, it’s recorded”."],
];

/* Terjemahan Indonesia seluruh kalimat pemasaran beranda. Kuncinya sama
   dengan atribut data-t di markup; yang Inggris tidak diulang di sini karena
   ia SUDAH ada di markup dan skrip pengalih menyimpannya sendiri. */
const KAMUS_BERANDA: Record<string, string> = {
  heroLabel: "STUDIO ARSITEKTUR · INDONESIA · SEJAK",
  heroJudul:
    '<span class="brs"><i>Bangunan yang bisa Anda</i></span>' +
    '<span class="brs"><i>pantau dibangun — <span class="ak glow">dari mana saja</span>.</i></span>',
  heroLead:
    "Rumah, kafe, dan tempat kerja di seluruh Indonesia. Anda dapat gambarnya, jadwalnya, dan satu tautan yang menunjukkan persis di mana proyek Anda berdiri — minggu ini, bukan kuartal lalu.",
  heroLihat: 'Lihat karya kami <span class="ar">→</span>',
  heroMulai: 'Mulai proyek <span class="ar">→</span>',

  klienLabel: "KLIEN TERPILIH",
  karyaLabel: "KARYA TERPILIH",

  portalLabel: "SELAGI DIBANGUN",
  portalJudul: "Bagian yang hampir tak diberikan studio seukuran kami.",
  portalLead:
    "Kalau Anda mengirim uang lintas batas untuk membangun sesuatu yang tidak bisa ditengok tiap minggu, ketakutan yang sebenarnya bukan “apakah nanti bagus”. Melainkan <strong>“apakah saya akan tahu apa yang sedang terjadi”</strong>. Karena itu tiap proyek punya halamannya sendiri — tahapan, dokumen yang bisa Anda setujui, tagihan, dan bukti untuk tiap pembayaran yang bisa Anda buka sendiri.",

  prosesLabel: "BAGAIMANA JALANNYA",
  prosesJudul: "Tiga langkah sebelum satu garis pun ditarik.",

  fiturLabel: "KENAPA PEMILIK DI LUAR NEGERI MEMILIH KAMI",
  fiturJudul: "Jarak itu soal penjadwalan, bukan soal desain.",

  testiLabel: "DARI KLIEN",
  testiKosong: "Belum ada testimoni",
  testiKosongKet: "Ini terisi sendiri dari portal klien — kami tidak menuliskannya",

  faqLabel: "SEBELUM ANDA BERTANYA",
  faqJudul: "Lima pertanyaan yang paling sering kami terima.",
  faqSemua: 'Semua pertanyaan <span class="ar">→</span>',

  ajakJudul:
    'Ceritakan lokasinya, anggarannya, dan <span class="ak">apa yang mengganjal</span> soal itu.',
  ajakLead: "Balasan pertama biasanya dalam 24 jam. Percakapan pertama tidak dipungut biaya.",
  ajakEmail: "Kirim email saja",

  "janji.0.judul": "Balasan dalam 24 jam",
  "janji.0.teks": "Studio kecil — justru karena itu pesan Anda tidak mengantre.",
  "janji.1.judul": "Tiap gambar disetujui daring",
  "janji.1.teks": "Setujui atau minta perubahan dari ponsel, seluruh percakapannya tersimpan.",
  "janji.2.judul": "Bukti yang bisa Anda buka sendiri",
  "janji.2.teks": "Tiap pembayaran dapat tautannya. Tanpa “percaya saja, sudah dicatat”.",

  "fitur.0.judul": "Kami bekerja lintas zona waktu",
  "fitur.0.teks": "Tiap persetujuan terjadi di halaman proyek Anda, jadi tidak ada yang menunggu jam kantor di Jakarta.",
  "fitur.1.judul": "Anda selalu tahu posisinya",
  "fitur.1.teks": "Tahapan, dokumen, dan foto lapangan terbuka kapan pun Anda membuka tautannya.",
  "fitur.2.judul": "Uang masuk dicatat, bukan dijanjikan",
  "fitur.2.teks": "Tiap pembayaran dapat nomor bukti yang bisa Anda buka sendiri dari WhatsApp.",
  "fitur.3.judul": "Gambar yang bisa Anda setujui atau kembalikan",
  "fitur.3.teks": "Seluruh percakapannya tersimpan di sebelahnya, jadi tidak ada dua versi yang tertukar.",
  "fitur.4.judul": "Data proyek Anda tertutup",
  "fitur.4.teks": "Hanya Anda dan studio yang bisa membukanya. Diuji, bukan diasumsikan.",
  "fitur.5.judul": "Balasan pertama di bawah 24 jam",
  "fitur.5.teks": "Studio kecil — justru karena itu pesan Anda tidak menumpuk.",

  "proses.0.no": "01. MENDENGAR",
  "proses.0.judul": "Kami mulai dari cara Anda hidup, bukan dari gaya.",
  "proses.0.teks": "Satu percakapan panjang, lalu brief tertulis yang bisa Anda koreksi sendiri — dengan kata-kata Anda, di zona waktu Anda.",
  "proses.1.no": "02. MENGGAMBAR",
  "proses.1.judul": "Konsep, denah, dan gambar kerja — semuanya bisa ditinjau dari ponsel.",
  "proses.1.teks": "Tiap dokumen bisa disetujui atau dikembalikan untuk diubah langsung di halaman proyek Anda, dengan seluruh percakapannya tersimpan di sebelahnya.",
  "proses.2.no": "03. MEMBANGUN & MENDAMPINGI",
  "proses.2.judul": "Anda tahu posisi proyeknya, tiap minggu.",
  "proses.2.teks": "Foto lapangan, tagihan, dan bukti pembayaran mendarat di halaman yang sama. Tidak ada kabar yang hilang antara utas WhatsApp dan lembar kerja.",
};

const fakta = (p: Project) =>
  [
    { label: "LOCATION", nilai: p.location || p.city },
    { label: "YEAR", nilai: p.year ? String(p.year) : null, mono: true },
    { label: "TYPE", nilai: CATEGORY_LABELS_EN[p.category] },
    { label: "AREA", nilai: p.areaSqm ? `${p.areaSqm.toLocaleString("en-US")} m²` : null, mono: true },
  ].filter((f) => f.nilai);
---

<BaseLayout
  title="Architecture you can watch being built"
  description={`Houses, cafés and workplaces across ${kota} and Indonesia. You get the drawings, the schedule, and one link that shows exactly where your project stands.`}
  image={sorot[0]?.coverImageUrl}
>
  <div class="pita pita--panel pita--kepala">
    <div class="dalam titik pijar">
      <span class="pijar-lapis" aria-hidden="true"></span>
      <div class="isi isi--longgar hero">
        {/* Spasi sebelum tahun datang dari baris baru JSX; menambah {" "}
            membuatnya jadi dua spasi, dan letter-spacing .18em melebarkan
            spasi kedua itu jadi celah yang terlihat. */}
        <span class="label masuk"
          ><span data-t="heroLabel">ARCHITECTURE STUDIO · INDONESIA · SINCE</span> {settings.foundedYear ?? <span class="tunggu">20XX</span>}</span
        >
        <div class="s24"></div>
        <h1 class="h1" data-t="heroJudul">
          <span class="brs"><i>We design buildings you can</i></span>
          <span class="brs"><i>watch being built — <span class="ak glow">from anywhere</span>.</i></span>
        </h1>
        <div class="s24"></div>
        <p class="lead masuk masuk--3 hero__lead" data-t="heroLead">
          Houses, cafés and workplaces across Indonesia. You get the drawings, the schedule, and one
          link that shows you exactly where your project stands — this week, not last quarter.
        </p>
        <div class="s36"></div>
        <div class="rowx masuk masuk--4 hero__tombol">
          <a class="btn btn--isi" href="/kontak" data-t="heroMulai">Start a project <span class="ar">→</span></a>
          <a class="btn" href="/proyek" data-t="heroLihat">See our work <span class="ar">→</span></a>
        </div>
      </div>
    </div>
  </div>

  {
    heroFoto && (
      <div class="pita hero-foto">
        <div class="dalam">
          <div class="foto foto--nyata">
            <img src={heroFoto.url} alt={heroFoto.altText ?? ""} width="1600" height="900" fetchpriority="high" decoding="async" />
            {heroFoto.caption && (
              <span class="foto__ket">
                <b>{heroFoto.proyek}</b> {heroFoto.caption}
              </span>
            )}
          </div>
        </div>
      </div>
    )
  }

  <div class="pita">
    <div class="dalam">
      <div class="baris b3 wahyu">
        {
          janji.map(([d, judul, teks], i) => (
            <div class="sel">
              <div class="janji">
                {/* Berkotak, sama dengan daftar fitur di halaman yang sama.
                    Keduanya bentuknya identik — ikon memperkenalkan sebuah
                    judul pendek — jadi satu berkotak dan satunya telanjang
                    terbaca sebagai kelalaian, bukan sebagai pilihan. */}
                <span class="kotak-ikon">
                  <svg width="19" height="19" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d={d} /></svg>
                </span>
                <span>
                  <span class="hs" data-t={`janji.${i}.judul`}>{judul}</span>
                  <div class="s6"></div>
                  <span class="mut kecil" data-t={`janji.${i}.teks`}>{teks}</span>
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  {
    klien.length > 0 && (
      <div class="pita">
        <div class="dalam">
          <div class="isi kop-seksi wahyu mq-kop">
            {/* Judulnya "clients", bukan "materials & partners", karena yang dikirim
                pemilik adalah nama klien. Judul lama di atas daftar klien adalah
                pernyataan yang tidak benar, bukan sekadar salah kata. */}
            {/* Tanpa tombol Pause. Mengarahkan kursor ke sebuah logo sudah
                menghentikan barisnya — itu gerakan yang sama dengan yang
                dipakai orang untuk membaca logo yang menarik perhatiannya,
                jadi tombol terpisah menyuruh mereka melakukan dua hal untuk
                satu maksud. Yang butuh diam permanen sudah ditangani
                prefers-reduced-motion di CSS, tanpa perlu menekan apa pun. */}
            <span class="label label--redup" data-t="klienLabel">SELECTED CLIENTS</span>
          </div>
          <div class="mq mq--garis">
            {/* Daftar digandakan supaya gulirannya menyambung tanpa jeda. */}
            <div class="mq__rel" id="mqRel">
              {[...klien, ...klien].map((k) => (
                <div class="mq__i">
                  {/* Logo kalau ada; kalau belum, namanya sebagai teks —
                      supaya barisnya tidak pernah bolong. */}
                  {k.logoUrl
                    ? <img src={k.logoUrl} alt={k.name} loading="lazy" class="mq__logo" />
                    : k.name}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    )
  }

  {
    sorot.length > 0 && (
      <div class="pita" id="kerja">
        <div class="dalam">
          {sorot.map((p, i) => (
            <div class="sorot" data-sorot={i} hidden={i !== 0}>
              <div class="isi">
                <span class="label" data-t="karyaLabel">SELECTED WORK</span>
                <div class="s16"></div>
                <h2 class="h2">{p.title}{subjudulBerguna(p) ? ` — ${subjudulBerguna(p)}` : ""}</h2>
                {p.summary && (
                  <>
                    <div class="s16"></div>
                    <p class="lead">{p.summary}</p>
                  </>
                )}
              </div>
              <div class={`baris b${Math.min(fakta(p).length, 4)} sorot__fakta`}>
                {fakta(p).map((f) => (
                  <div class="sel">
                    <span class="label label--redup">{f.label}</span>
                    <div class="s6"></div>
                    <span class={f.mono ? "hs mono" : "hs"}>{f.nilai}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}

          <div class="tabs" id="swTabs" role="tablist">
            <span class="ind" id="swInd"></span>
            {sorot.map((p, i) => (
              <button class="tab" type="button" role="tab" data-ke={i}
                aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
                {String(i + 1).padStart(2, "0")} · {p.title}
              </button>
            ))}
          </div>

          {sorot.map((p, i) => (
            <div data-strip={i} hidden={i !== 0}>
              <div class="strip" data-gulir>
                {/* Hanya proyek yang SEDANG tampil yang punya `src`. Sisanya
                    membawa `data-src` dan baru dipasang saat tabnya diklik.

                    Bukan sekadar rapi: dengan enam proyek, showcase ini
                    merender 120 <img> sekaligus — 60 foto besar dan 60
                    thumbnail — padahal lima proyek di antaranya tersembunyi.
                    `loading="lazy"` memang menahan unduhannya, tapi tiap
                    elemennya tetap ikut dihitung saat layout, dan satu klik
                    tab langsung membuka sepuluh unduhan resolusi penuh. */}
                {(p.images ?? []).map((f, k) => (
                  <div class="foto foto--sorot">
                    <img src={i === 0 ? f.url : undefined} data-src={i === 0 ? undefined : f.url}
                      alt={f.altText ?? ""} loading={i === 0 && k < 2 ? "eager" : "lazy"}
                      decoding="async" width="1600" height="900" />
                    {f.caption && <span class="foto__ket"><b>{String(k + 1).padStart(2, "0")}</b> {f.caption}</span>}
                  </div>
                ))}
              </div>
              <div class="rel"><i data-prog></i></div>
              {/* Tiap kotak memuat FOTONYA, nomornya turun jadi penanda kecil
                  di sudut. Perbaikan yang sama sudah dikerjakan di halaman
                  /proyek/[slug] dan berhenti di situ — filmstrip beranda ini
                  ikut dilaporkan pemilik sebagai kotak kosong berangka.
                  Satu-satunya gunanya melompat ke foto tertentu, dan angka
                  tidak memberi tahu foto mana. */}
              <div class="film" data-film aria-label="Choose a photo">
                {(p.images ?? []).map((f, k) => (
                  <button type="button" data-ke={k} aria-current={k === 0 ? "true" : "false"}
                    aria-label={`Photograph ${k + 1} of ${(p.images ?? []).length}`}>
                    <img src={i === 0 ? f.url : undefined} data-src={i === 0 ? undefined : f.url}
                      alt="" loading="lazy" decoding="async" fetchpriority="low" width="160" height="90" />
                    <span class="film__no">{String(k + 1).padStart(2, "0")}</span>
                  </button>
                ))}
              </div>
              <div class="isi isi--rapat sorot__kaki">
                <span class="dim kecil" data-info role="status" aria-live="polite">—</span>
                <span class="dim kecil">drag · scroll · arrow keys</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    )
  }

  <div class="pita pita--gelap">
    <div class="dalam titik pijar">
      <span class="pijar-lapis" aria-hidden="true"></span>
      <div class="isi">
        <span class="label" data-t="portalLabel">WHILE IT IS BEING BUILT</span>
        <div class="s16"></div>
        <h2 class="h2" data-t="portalJudul">The part almost no studio our size gives you.</h2>
        <div class="s16"></div>
        <p class="lead">
          If you are sending money across a border to build something you cannot visit every week,
          the real fear isn’t “will it look good”. It is <strong>“will I know what is happening”</strong>.
          So every project comes with its own page — phases, documents you can approve, invoices, and
          a receipt for every payment you can open yourself.
        </p>
      </div>
      <div class="portal-bung">
        <div class="kilau">
          {/* Gambaran tampilan portal — angkanya contoh, bukan data proyek
              yang sedang berjalan. */}
          <div class="panel portal">
            <div class="portal__bar">
              <span class="portal__titik"></span><span class="portal__titik"></span><span class="portal__titik"></span>
              <span class="dim portal__url">pahlevidirgaarchitecture.com/progres</span>
            </div>
            <div class="portal__isi">
              <div class="portal__rel">
                <span class="label label--redup portal__kecil">YOUR PROJECT</span>
                <div class="s16"></div>
                <div class="hs portal__nama">Your project</div>
                <div class="s16"></div>
                {[
                  ["Brief", "cek"],
                  ["Concept", "cek"],
                  ["Construction drawings", "kini"],
                  ["On site", "nanti"],
                  ["Handover", "nanti"],
                ].map(([t, s]) => (
                  <div class="cek">
                    <i class={`cek--${s}`}>
                      {s === "cek" && (
                        <svg width="9" height="9" viewBox="0 0 10 10"><path d="M1 5l3 3 5-6" stroke="#2DD4BF" stroke-width="1.8" fill="none" /></svg>
                      )}
                    </i>
                    <span class={s === "kini" ? "portal__fase portal__fase--kini" : "portal__fase"}>{t}</span>
                  </div>
                ))}
              </div>
              <div class="portal__kanan">
                <div class="portal__angka">
                  {[["PHASE", "3 / 5", false], ["PAID", "50%", true], ["DOCUMENTS", "12", false]].map(([l, v, ak]) => (
                    <div class="portal__kotak">
                      <span class="label label--redup portal__mini">{l}</span>
                      <div class="s6"></div>
                      <span class={ak ? "hs ak portal__nilai" : "hs portal__nilai"}>{v}</span>
                    </div>
                  ))}
                </div>
                <div class="s16"></div>
                <div class="portal__batang"><div></div></div>
                <div class="s16"></div>
                <div class="foto portal__foto"><span>LATEST SITE PHOTO</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

