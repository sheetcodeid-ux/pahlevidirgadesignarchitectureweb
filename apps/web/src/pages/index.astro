---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  listProjects,
  listClients,
  listTestimonials,
  getSettings,
  subjudulBerguna,
  KATEGORI_LABEL,
  type Project,
  type ProjectImage,
} from "../lib/api";
import { SOROTAN_FAQ } from "../lib/faq";
import { TIER } from "../lib/tier";

const settings = await getSettings();
const kota = settings.city?.trim() || "Indonesia";

const semua = await listProjects({ limit: 200 });
/* Daftar klien datang dari database, diurus pemilik lewat /admin/klien.
   Sebelumnya ia daftar teks yang di-hardcode di lib/menunggu.ts — logonya
   sudah dikirim pemilik tapi yang tayang cuma namanya. */
const klien = await listClients();
const testimoni = await listTestimonials(true);

/* Showcase: proyek yang diunggulkan lebih dulu, lalu yang terbaru.
   SELURUHNYA, tidak dipotong. Dulu dipotong tiga dengan alasan "bilah tabnya
   dirancang untuk tiga" — dan itu keliru dua kali: bilahnya memang bisa
   digulir mendatar sejak awal, dan pemotongannya membuat pemilik yang sudah
   memasukkan enam proyek cuma melihat tiga di berandanya sendiri. Kalau
   suatu saat proyeknya puluhan, yang membatasi harus keputusan sadar di
   sini, bukan angka yang tertinggal dari rancangan bilah. */
const tahunDari = (p: Project) => p.year ?? (p.publishedAt ? new Date(p.publishedAt).getFullYear() : 0);
const sorot = [...semua]
  .sort((a, b) => Number(b.isFeatured) - Number(a.isFeatured) || tahunDari(b) - tahunDari(a));

// Foto yang dipakai di tiga blok proses. Diambil dari proyek yang ada, bukan
// dari berkas statis — kalau belum ada fotonya, bloknya tetap tampil tanpa
// gambar dan tidak menampilkan kotak kosong bergaris.
interface FotoBerlabel extends ProjectImage {
  proyek: string;
}
const semuaFoto: FotoBerlabel[] = sorot.flatMap((p) =>
  (p.images ?? []).map((f) => ({ ...f, proyek: p.title })),
);
/* Satu foto per proyek, bukan sepuluh dari proyek yang sama. Waktu showcase
   masih dipotong tiga, mengambil foto ke-0, tengah, dan terakhir dari daftar
   gabungan kebetulan menghasilkan tiga proyek berbeda. Dengan enam proyek
   daftar itu jadi 60 foto dan ketiganya jatuh di proyek yang sama. */
const fotoPerProyek: FotoBerlabel[] = sorot
  .map((p) => (p.images ?? [])[0])
  .filter((f): f is ProjectImage => Boolean(f))
  .map((f, i) => ({ ...f, proyek: sorot[i].title }));
const fotoProses = fotoPerProyek.slice(0, 3);

// Foto besar di bawah hero. Diambil dari daftar berlabel yang sama supaya
// keterangannya bisa menyebut proyek asalnya.
const heroFoto: FotoBerlabel | null = semuaFoto[0] ?? null;

/* Marquee "materials & partners we specify" — isinya dari lib/menunggu.ts,
   satu-satunya tempat data yang masih ditunggu pemilik disimpan. */

const proses = [
  {
    no: "01. DENGAR",
    judul: "Mulai dari cara Anda memakai ruangnya.",
    teks: "Satu percakapan, lalu brief tertulis yang bisa Anda koreksi sendiri.",
  },
  {
    no: "02. GAMBAR",
    judul: "Konsep sampai gambar kerja, bisa ditinjau dari ponsel.",
    teks: "Setujui atau minta revisi langsung di halaman proyek Anda.",
  },
  {
    no: "03. BANGUN",
    judul: "Anda tahu posisi proyeknya tiap minggu.",
    teks: "Foto lapangan, tagihan, dan kuitansi mendarat di halaman yang sama.",
  },
];

/* Enam kompetensi yang disebut dokumen strategi sebagai pembeda yang sulit
   ditiru studio generalis (§2.2): alur bar dan dapur, ergonomi barista,
   akustik, pencahayaan, material tahan lembap — ditambah dua yang memang
   milik segmen rumah. Kalimatnya sengaja pendek: pemilik meminta halaman
   ini "to the point", dengan acuan refine.dev. */
const IKON: Record<string, string> = {
  alur: "M2.5 4.5h5v5h-5v-5Zm10 0h5v5h-5v-5Zm-10 6h5v5h-5v-5Zm10 0h5v5h-5v-5ZM7.5 7h5M15 9.5v1",
  suara: "M3 8v4h3l4 3.5v-11L6 8H3Zm11-1.5a5 5 0 010 7M16.5 4a8.5 8.5 0 010 12",
  cahaya: "M10 1.5v2M4.4 4.4l1.4 1.4m8.4-1.4-1.4 1.4M10 6.5a4 4 0 00-2 7.4V16h4v-2.1a4 4 0 00-2-7.4ZM8 18h4",
  lembap: "M10 1.5s5.5 6 5.5 9.5a5.5 5.5 0 11-11 0C4.5 7.5 10 1.5 10 1.5Z",
  matahari: "M10 5.5a4.5 4.5 0 100 9 4.5 4.5 0 000-9ZM10 1v2m0 14v2M3.6 3.6l1.4 1.4m10 10 1.4 1.4M1 10h2m14 0h2M3.6 16.4 5 15m10-10 1.4-1.4",
  kursi: "M5 2.5h10v7H5v-7Zm-1.5 7h13v3h-13v-3ZM5.5 12.5v5m9-5v5",
};
const fitur: [keyof typeof IKON, string, string][] = [
  ["alur", "Bar digambar sebelum fasad", "Ke mana barista berputar, di mana antrean berdiri, di mana cangkir mendarat."],
  ["suara", "Ramai, tapi tidak berisik", "Akustik dirancang untuk ruang yang memang akan penuh obrolan."],
  ["cahaya", "Foto-genik tanpa terasa dibuat-buat", "Bagus untuk ruangnya, untuk makanannya, dan untuk barista jam 6 pagi."],
  ["lembap", "Material dipilih untuk iklim tapaknya", "Finishing yang aman di kota kering bisa rusak di pesisir yang lembap."],
  ["matahari", "Rumah yang adem dengan sendirinya", "Orientasi, pembayangan, dan ventilasi silang dulu — baru AC."],
  ["kursi", "Ruang diukur dari cara dipakai", "Terhadap perabot dan sirkulasi nyata, bukan untuk memenuhi kavling."],
];

const janji = [
  ["M10 1a9 9 0 100 18 9 9 0 000-18ZM10 5.5V10l3 2", "Dibalas dalam 24 jam", "Studio kecil — justru karena itu pesan Anda tidak mengantre."],
  ["M11.5 1.5h-7v17h11V5.5l-4-4Zm0 0v4h4M7 11h6M7 14h4", "Gambar disetujui daring", "Setujui atau minta revisi dari ponsel, percakapannya tersimpan."],
  ["M2.5 5.5h15v9h-15zM2.5 9h15M5.5 12h3", "Bukti tiap pembayaran", "Sekali bayar, satu tautan kuitansi yang bisa Anda buka sendiri."],
];

const fakta = (p: Project) =>
  [
    { label: "LOKASI", nilai: p.location || p.city },
    { label: "TAHUN", nilai: p.year ? String(p.year) : null, mono: true },
    { label: "JENIS", nilai: KATEGORI_LABEL[p.category] },
    { label: "LUAS", nilai: p.areaSqm ? `${p.areaSqm.toLocaleString("id-ID")} m²` : null, mono: true },
  ].filter((f) => f.nilai);
---

<BaseLayout
  title="Coffee shop dan rumah tropis untuk iklim Indonesia"
  description="Studio arsitektur spesialis coffee shop, restoran, dan rumah tropis. Kami merancang untuk panas dan lembapnya — lalu Anda memantau pembangunannya dari satu tautan."
  image={sorot[0]?.coverImageUrl}
>
  <div class="pita pita--panel pita--kepala">
    <div class="dalam titik pijar">
      <span class="pijar-lapis" aria-hidden="true"></span>
      <div class="isi isi--longgar hero">
        {/* Lencana pembuka, mengikuti acuan pemilik (refine.dev): kotak
            bergaris teal berisi ikon, satu kalimat penempatan, lalu tautan
            berwarna ke tujuannya. Menggantikan eyebrow lama
            "STUDIO ARSITEKTUR · PONTIANAK · SEJAK 20XX", yang menyebut kota
            sebagai batas layanan — padahal studionya melayani seluruh
            Indonesia. Pontianak tetap disebut, tapi di seksi studio, sebagai
            tempat ia berkantor. */}
        <a class="hero-lencana masuk" href="#tarif">
          <svg width="13" height="13" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 1.3 14.2 4.9v7.2L8 15.7 1.8 12.1V4.9L8 1.3Z" stroke="currentColor" stroke-width="1.3" />
            <path d="M8 5.4 11.3 7.3v3.4L8 12.6 4.7 10.7V7.3L8 5.4Z" fill="currentColor" fill-opacity=".3" />
          </svg>
          <span>Spesialis coffee shop &amp; rumah tropis</span>
          <b>Lihat tarif <span class="ar">→</span></b>
        </a>
        <div class="s24"></div>
        <h1 class="h1"><span class="brs"><i>Coffee shop dan rumah tropis</i></span><span class="brs"><i>untuk <span class="ak glow">iklim Indonesia</span>.</i></span></h1>
        <div class="s24"></div>
        <p class="lead masuk masuk--3 hero__lead">Kami merancang ruang yang tetap adem saat panas dan tetap bekerja saat ramai — lalu Anda memantau pembangunannya dari satu tautan.</p>
        <div class="s36"></div>
        <div class="rowx masuk masuk--4 hero__tombol">
          <a class="btn btn--dot" href="/kontak">Mulai proyek <span class="ar">→</span></a>
          <a class="btn" href="/proyek">Lihat karya kami <span class="ar">→</span></a>
        </div>
      </div>
    </div>
  </div>

  {
    heroFoto && (
      <div class="pita hero-foto">
        <div class="dalam">
          <div class="foto foto--nyata">
            <img src={heroFoto.url} alt={heroFoto.altText ?? ""} width="1600" height="900" fetchpriority="high" decoding="async" />
            {heroFoto.caption && (
              <span class="foto__ket">
                <b>{heroFoto.proyek}</b> {heroFoto.caption}
              </span>
            )}
          </div>
        </div>
      </div>
    )
  }

  <div class="pita">
    <div class="dalam">
      <div class="baris b3 wahyu">
        {
          janji.map(([d, judul, teks], i) => (
            <div class="sel">
              <div class="janji">
                {/* Berkotak, sama dengan daftar fitur di halaman yang sama.
                    Keduanya bentuknya identik — ikon memperkenalkan sebuah
                    judul pendek — jadi satu berkotak dan satunya telanjang
                    terbaca sebagai kelalaian, bukan sebagai pilihan. */}
                <span class="kotak-ikon">
                  <svg width="19" height="19" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d={d} /></svg>
                </span>
                <span>
                  <span class="hs">{judul}</span>
                  <div class="s6"></div>
                  <span class="mut kecil">{teks}</span>
                </span>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  {
    klien.length > 0 && (
      <div class="pita">
        <div class="dalam">
          <div class="isi kop-seksi wahyu mq-kop">
            {/* Judulnya "clients", bukan "materials & partners", karena yang dikirim
                pemilik adalah nama klien. Judul lama di atas daftar klien adalah
                pernyataan yang tidak benar, bukan sekadar salah kata. */}
            {/* Tanpa tombol Pause. Mengarahkan kursor ke sebuah logo sudah
                menghentikan barisnya — itu gerakan yang sama dengan yang
                dipakai orang untuk membaca logo yang menarik perhatiannya,
                jadi tombol terpisah menyuruh mereka melakukan dua hal untuk
                satu maksud. Yang butuh diam permanen sudah ditangani
                prefers-reduced-motion di CSS, tanpa perlu menekan apa pun. */}
            <span class="label label--redup">KLIEN TERPILIH</span>
          </div>
          <div class="mq mq--garis">
            {/* Daftar digandakan supaya gulirannya menyambung tanpa jeda. */}
            <div class="mq__rel" id="mqRel">
              {[...klien, ...klien].map((k) => (
                <div class="mq__i">
                  {/* Logo kalau ada; kalau belum, namanya sebagai teks —
                      supaya barisnya tidak pernah bolong. */}
                  {k.logoUrl
                    ? <img src={k.logoUrl} alt={k.name} loading="lazy" class="mq__logo" />
                    : k.name}
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    )
  }

  {
    sorot.length > 0 && (
      <div class="pita" id="kerja">
        <div class="dalam">
          {sorot.map((p, i) => (
            <div class="sorot" data-sorot={i} hidden={i !== 0}>
              <div class="isi">
                <span class="label">KARYA TERPILIH</span>
                <div class="s16"></div>
                <h2 class="h2">{p.title}{subjudulBerguna(p) ? ` — ${subjudulBerguna(p)}` : ""}</h2>
                {p.summary && (
                  <>
                    <div class="s16"></div>
                    <p class="lead">{p.summary}</p>
                  </>
                )}
              </div>
              <div class={`baris b${Math.min(fakta(p).length, 4)} sorot__fakta`}>
                {fakta(p).map((f) => (
                  <div class="sel">
                    <span class="label label--redup">{f.label}</span>
                    <div class="s6"></div>
                    <span class={f.mono ? "hs mono" : "hs"}>{f.nilai}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}

          <div class="tabs" id="swTabs" role="tablist">
            <span class="ind" id="swInd"></span>
            {sorot.map((p, i) => (
              <button class="tab" type="button" role="tab" data-ke={i}
                aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
                {String(i + 1).padStart(2, "0")} · {p.title}
              </button>
            ))}
          </div>

          {sorot.map((p, i) => (
            <div data-strip={i} hidden={i !== 0}>
              <div class="strip" data-gulir>
                {/* Hanya proyek yang SEDANG tampil yang punya `src`. Sisanya
                    membawa `data-src` dan baru dipasang saat tabnya diklik.

                    Bukan sekadar rapi: dengan enam proyek, showcase ini
                    merender 120 <img> sekaligus — 60 foto besar dan 60
                    thumbnail — padahal lima proyek di antaranya tersembunyi.
                    `loading="lazy"` memang menahan unduhannya, tapi tiap
                    elemennya tetap ikut dihitung saat layout, dan satu klik
                    tab langsung membuka sepuluh unduhan resolusi penuh. */}
                {(p.images ?? []).map((f, k) => (
                  <div class="foto foto--sorot">
                    <img src={i === 0 ? f.url : undefined} data-src={i === 0 ? undefined : f.url}
                      alt={f.altText ?? ""} loading={i === 0 && k < 2 ? "eager" : "lazy"}
                      decoding="async" width="1600" height="900" />
                    {f.caption && <span class="foto__ket"><b>{String(k + 1).padStart(2, "0")}</b> {f.caption}</span>}
                  </div>
                ))}
              </div>
              <div class="rel"><i data-prog></i></div>
              {/* Tiap kotak memuat FOTONYA, nomornya turun jadi penanda kecil
                  di sudut. Perbaikan yang sama sudah dikerjakan di halaman
                  /proyek/[slug] dan berhenti di situ — filmstrip beranda ini
                  ikut dilaporkan pemilik sebagai kotak kosong berangka.
                  Satu-satunya gunanya melompat ke foto tertentu, dan angka
                  tidak memberi tahu foto mana. */}
              <div class="film" data-film aria-label="Pilih foto">
                {(p.images ?? []).map((f, k) => (
                  <button type="button" data-ke={k} aria-current={k === 0 ? "true" : "false"}
                    aria-label={`Photograph ${k + 1} of ${(p.images ?? []).length}`}>
                    {/* Versi kecil, bukan fotonya. Kotak ini 120x62; foto
                        besarnya 2560px, jadi memakainya di sini berarti
                        peramban mendekode dua puluh kali piksel yang dipakai
                        — sepuluh kali per proyek. `?? f.url` menjaga foto
                        yang diunggah sebelum thumbnail ada tetap tampil. */}
                    <img src={i === 0 ? (f.thumbUrl ?? f.url) : undefined}
                      data-src={i === 0 ? undefined : (f.thumbUrl ?? f.url)}
                      alt="" loading="lazy" decoding="async" fetchpriority="low" width="160" height="90" />
                    <span class="film__no">{String(k + 1).padStart(2, "0")}</span>
                  </button>
                ))}
              </div>
              <div class="isi isi--rapat sorot__kaki">
                <span class="dim kecil" data-info role="status" aria-live="polite">—</span>
                <span class="dim kecil">drag · scroll · arrow keys</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    )
  }

  <div class="pita pita--gelap">
    <div class="dalam titik pijar">
      <span class="pijar-lapis" aria-hidden="true"></span>
      {/* Judul di kiri, paragraf di kanan. Sebelumnya keduanya bertumpuk dalam
          satu kolom: judulnya memenuhi 100% lebar kolom sementara paragrafnya
          cuma 60% (666px dari 1110px), jadi ada 444px kosong yang menggantung
          di kanan paragraf — itu yang dilaporkan pemilik sebagai "nanggung".

          Melebarkan paragrafnya sampai selebar judul bukan jawabannya: pada
          1110px satu barisnya memuat ~138 huruf, jauh di atas batas nyaman
          membaca. Dibagi dua, tiap kolom 533px — sekitar 66 huruf per baris,
          persis di tengah rentang yang enak dibaca — dan ruang kosongnya
          terpakai. */}
      <div class="isi portal-kop">
        <div>
          <span class="label">SELAGI DIBANGUN</span>
          <div class="s16"></div>
          <h2 class="h2">Bagian yang hampir tak diberikan studio seukuran kami.</h2>
        </div>
        <p class="lead">Entah tapaknya di seberang kota atau di provinsi lain, ketakutan yang sebenarnya bukan “apakah nanti bagus”. Melainkan <strong>“apakah saya akan tahu apa yang sedang terjadi”</strong>. Karena itu tiap proyek punya halamannya sendiri — tahapan, dokumen yang bisa Anda setujui, tagihan, dan bukti untuk tiap pembayaran yang bisa Anda buka sendiri.</p>
      </div>
      <div class="portal-bung">
        <div class="kilau">
          {/* Gambaran tampilan portal — angkanya contoh, bukan data proyek
              yang sedang berjalan. */}
          <div class="panel portal">
            <div class="portal__bar">
              <span class="portal__titik"></span><span class="portal__titik"></span><span class="portal__titik"></span>
              <span class="dim portal__url">pahlevidirgaarchitecture.com/progres</span>
            </div>
            <div class="portal__isi">
              <div class="portal__rel">
                <span class="label label--redup portal__kecil">PROYEK ANDA</span>
                <div class="s16"></div>
                <div class="hs portal__nama">Proyek Anda</div>
                <div class="s16"></div>
                {[
                  ["Brief", "cek"],
                  ["Konsep", "cek"],
                  ["Gambar kerja", "kini"],
                  ["Di lapangan", "nanti"],
                  ["Serah terima", "nanti"],
                ].map(([t, s]) => (
                  <div class="cek">
                    <i class={`cek--${s}`}>
                      {s === "cek" && (
                        <svg width="9" height="9" viewBox="0 0 10 10"><path d="M1 5l3 3 5-6" stroke="#2DD4BF" stroke-width="1.8" fill="none" /></svg>
                      )}
                    </i>
                    <span class={s === "kini" ? "portal__fase portal__fase--kini" : "portal__fase"}>{t}</span>
                  </div>
                ))}
              </div>
              <div class="portal__kanan">
                <div class="portal__angka">
                  {[["TAHAP", "3 / 5", false], ["TERBAYAR", "50%", true], ["DOKUMEN", "12", false]].map(([l, v, ak]) => (
                    <div class="portal__kotak">
                      <span class="label label--redup portal__mini">{l}</span>
                      <div class="s6"></div>
                      <span class={ak ? "hs ak portal__nilai" : "hs portal__nilai"}>{v}</span>
                    </div>
                  ))}
                </div>
                <div class="s16"></div>
                <div class="portal__batang"><div></div></div>
                <div class="s16"></div>
                <div class="foto portal__foto"><span>LATEST SITE PHOTO</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="pita">
    <div class="dalam proses-seksi">
      <div class="isi kop-seksi wahyu">
        <span class="label">BAGAIMANA JALANNYA</span>
        <div class="s16"></div>
        <h2 class="h2">Tiga langkah sebelum satu garis pun ditarik.</h2>
      </div>
      {
        proses.map((l, i) => {
          const f = fotoProses[i];
          const teksSel = (
            <div class="sel proses__teks">
              <span class="label">{l.no}</span>
              <div class="s16"></div>
              <h3 class="h3">{l.judul}</h3>
              <div class="s16"></div>
              <p class="mut kecil">{l.teks}</p>
            </div>
          );
          const fotoSel = f ? (
            <div class="sel proses__foto">
              <div class="foto foto--nyata">
                <img src={f.url} alt={f.altText ?? ""} loading="lazy" decoding="async" width="1600" height="900" />
                {f.caption && <span class="foto__ket"><b>{f.proyek}</b> {f.caption}</span>}
              </div>
            </div>
          ) : null;
          return (
            <div class={fotoSel ? "baris b2" : "baris"}>
              {fotoSel && i % 2 === 0 ? fotoSel : null}
              {teksSel}
              {fotoSel && i % 2 === 1 ? fotoSel : null}
            </div>
          );
        })
      }
    </div>
  </div>

  <div class="pita">
    <div class="dalam">
      <div class="isi kop-seksi wahyu">
        <span class="label">YANG BENAR-BENAR KAMI KUASAI</span>
        <div class="s16"></div>
        <h2 class="h2">Studio generalis bisa menggambarnya. Yang bisa membuatnya bekerja jam 7 pagi lebih sedikit.</h2>
      </div>
      {
        [fitur.slice(0, 3), fitur.slice(3)].map((baris, brs) => (
          <div class="baris b3 wahyu">
            {baris.map(([ikon, judul, teks], k) => (
              <div class="sel">
                <span class="kotak-ikon">
                  <svg width="19" height="19" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d={IKON[ikon]} /></svg>
                </span>
                <div class="s16"></div>
                <p class="hs">{judul}</p>
                <div class="s6"></div>
                <p class="mut kecil">{teks}</p>
              </div>
            ))}
