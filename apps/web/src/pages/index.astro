---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { Icon } from "../components/ui/Icon";
import { listProjects, listTestimonials } from "../lib/api";

const featured = await listProjects({ featured: true, limit: 6 });
const testimoni = await listTestimonials(true);
---

<BaseLayout
  title="Studio Arsitektur"
  description="Studio arsitektur di Pontianak yang merancang coffee shop, ruang hospitality, dan rumah tropis — dengan pendekatan iklim khatulistiwa yang tenang dan tahan lama."
>
  <section class="hero shell bg-dots">
    <p class="eyebrow">Studio Arsitektur Pontianak</p>
    <h1>Ruang yang menua dengan baik.</h1>
    <p class="lede">
      Kami merancang coffee shop dan rumah tinggal di Pontianak —
      memperhatikan cahaya, aliran udara, dan material yang jujur, agar
      ruang tetap relevan jauh setelah selesai dibangun.
    </p>
    <a href="/proyek" class="btn btn--primary btn--lg">Lihat proyek</a>
  </section>

  <section class="section shell">
    <h2 class="eyebrow">Pilihan proyek</h2>

    {
      featured.length > 0 ? (
        <ul class="project-grid">
          {featured.map((project, index) => (
            <ProjectCard project={project} priority={index < 2} />
          ))}
        </ul>
      ) : (
        <p class="lede">
          Belum ada proyek yang dipublikasikan. Tandai proyek sebagai
          <em>featured</em> di panel admin agar tampil di sini.
        </p>
      )
    }
  </section>

  {
    testimoni.length > 0 && (
      <section class="section shell">
        <h2 class="eyebrow">Kata klien</h2>
        <ul class="testimoni-grid">
          {testimoni.map((t) => (
            <li class="testimoni-card">
              <span class="icon-tile"><Icon name="quote" size={18} /></span>
              <p class="testimoni-card__quote">{t.quote}</p>
              <span class="testimoni-card__nama">{t.clientName}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(4rem, 12vw, 10rem) clamp(var(--space-7), 8vw, var(--space-8));
  }

  .hero h1 {
    max-width: 16ch;
    margin-bottom: 2rem;
  }

  .hero .lede {
    margin-bottom: 2.5rem;
  }

  .testimoni-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-5);
    list-style: none;
    padding: 0;
    margin-top: var(--space-6);
  }

  .testimoni-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .testimoni-card__quote {
    color: var(--text-muted);
  }

  .testimoni-card__nama {
    font-size: var(--text-sm);
    font-weight: 600;
  }
</style>
