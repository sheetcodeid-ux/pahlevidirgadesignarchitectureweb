---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "../components/ui/Icon";
import "../styles/misc.css";

const langkah = [
  {
    nomor: "01",
    ikon: "search" as const,
    judul: "Konsultasi & Survei",
    teks: "Kami datang ke lokasi, mendengar kebutuhan dan anggaran Anda — sebelum satu garis pun digambar.",
  },
  {
    nomor: "02",
    ikon: "edit" as const,
    judul: "Konsep & Estimasi",
    teks: "Sketsa awal dan perkiraan anggaran, supaya keputusan besar diambil selagi masih murah untuk diubah.",
  },
  {
    nomor: "03",
    ikon: "project" as const,
    judul: "Pengembangan Desain",
    teks: "Gambar detail, material, dan spesifikasi teknis disepakati bersama, sampai semua pihak sepaham.",
  },
  {
    nomor: "04",
    ikon: "copy" as const,
    judul: "Dokumen & Perizinan",
    teks: "Gambar kerja lengkap untuk pelaksanaan, sekaligus dokumen yang dibutuhkan untuk pengurusan PBG.",
  },
  {
    nomor: "05",
    ikon: "calendar" as const,
    judul: "Pendampingan Pembangunan",
    teks: "Kunjungan berkala selama masa konstruksi, memastikan yang terbangun sesuai yang dirancang.",
  },
];

const layanan = [
  {
    ikon: "project" as const,
    judul: "Perancangan Arsitektur",
    teks: "Dari sketsa konsep sampai gambar kerja siap dibangun, untuk hunian maupun ruang komersial.",
  },
  {
    ikon: "image" as const,
    judul: "Desain Interior",
    teks: "Penataan ruang dalam yang menyatu dengan arsitektur bangunannya, bukan ditempel belakangan.",
  },
  {
    ikon: "copy" as const,
    judul: "Perizinan & Dokumen Teknis",
    teks: "Menyiapkan gambar dan dokumen yang dibutuhkan untuk pengurusan PBG.",
  },
  {
    ikon: "calendar" as const,
    judul: "Pengawasan Berkala",
    teks: "Kunjungan terjadwal selama masa pembangunan untuk menjaga kualitas pelaksanaan.",
  },
];

const batasan = [
  {
    judul: "Bukan kontraktor pelaksana",
    teks: "Kami merancang; pembangunan dikerjakan kontraktor pilihan Anda, dengan pengawasan berkala dari kami.",
  },
  {
    judul: "Bukan pengurus sertifikat tanah",
    teks: "Legalitas lahan adalah tanggung jawab pemilik, terpisah dari dokumen teknis bangunan yang kami siapkan.",
  },
  {
    judul: "Bukan konsultan struktur independen",
    teks: "Untuk bangunan yang kompleks, kami berkoordinasi dengan konsultan struktur dan MEP spesialis.",
  },
  {
    judul: "Fokus hunian & komersial skala menengah",
    teks: "Bukan gedung bertingkat tinggi atau perencanaan kawasan skala kota.",
  },
];
---

<BaseLayout
  title="Tentang"
  description="Profil Dirga Pahlevi Architecture: pendekatan, layanan, dan cara kami bekerja."
>
  <section class="section shell bg-dots hero-tentang">
    <div class="hero-tentang__grid">
      <div>
        <span class="marker marker--live hero-tentang__marker">
          <span class="marker__dot" aria-hidden="true"></span>
          Menerima proyek baru
        </span>
        <p class="eyebrow">Studio</p>
        <h1>Tentang Dirga Pahlevi Architecture</h1>
        <p class="lede">
          Kami studio arsitektur kecil yang sengaja tetap kecil — supaya
          setiap proyek yang masuk benar-benar ditangani, bukan sekadar
          dijadwalkan.
        </p>
      </div>

      <svg
        class="hero-tentang__ilustrasi"
        viewBox="0 0 400 400"
        aria-hidden="true"
      >
        <circle cx="316" cy="78" r="26" class="stroke-faint" />
        <path d="M50 150 L200 52 L350 150" class="stroke-faint" />
        <rect x="70" y="150" width="260" height="210" rx="2" class="stroke-strong" />
        <line x1="18" y1="360" x2="382" y2="360" class="stroke-border" />
        <line x1="120" y1="150" x2="120" y2="360" class="stroke-border" />
        <line x1="170" y1="150" x2="170" y2="360" class="stroke-border" />
        <line x1="230" y1="150" x2="230" y2="360" class="stroke-border" />
        <line x1="280" y1="150" x2="280" y2="360" class="stroke-border" />
        <line x1="70" y1="205" x2="330" y2="205" class="stroke-border" />
        <line x1="70" y1="260" x2="330" y2="260" class="stroke-border" />
        <line x1="70" y1="315" x2="330" y2="315" class="stroke-border" />
        <rect x="180" y="215" width="40" height="35" rx="1" class="fill-brand" />
      </svg>
    </div>
  </section>

  <section class="section shell section--sunken">
    <div class="siapa-grid">
      <div class="card siapa-card">
        <p class="t-label">Siapa kami</p>
        <p>
          Dirga Pahlevi Architecture bekerja dengan ritme yang jarang
          dibicarakan studio arsitektur: bukan yang tercepat, bukan yang
          termurah, tapi yang paling teliti menimbang bagaimana sebuah
          bangunan akan dipakai bertahun-tahun setelah selesai dibangun.
        </p>
        <p class="t-muted">
          Kami memilih menangani proyek dalam jumlah terbatas setiap
          bulannya, karena kualitas keputusan desain — bukan kecepatan
          produksi gambar — yang menentukan apakah sebuah ruang benar-benar
          nyaman dihuni.
        </p>
      </div>

      <div class="card siapa-card">
        <p class="t-label">Pendekatan</p>
        <p>
          Iklim tropis Indonesia bukan kendala yang perlu disiasati,
          melainkan titik awal setiap rancangan. Cahaya matahari, arah angin,
          dan curah hujan kami perhitungkan sejak sketsa pertama — bukan
          ditambal lewat AC dan kaca gelap di akhir.
        </p>
        <p class="t-muted">
          Material dipilih karena kejujurannya: yang menua dengan baik,
          gampang dirawat, dan tidak berpura-pura jadi sesuatu yang lain.
        </p>
      </div>
    </div>
  </section>

  <section class="section shell">
    <p class="eyebrow">Cara kerja</p>
    <h2>Lima Langkah, Satu Studio</h2>
    <p class="lede langkah-lede">
      Dari kontak pertama sampai bangunan berdiri, prosesnya tetap sama untuk
      setiap proyek — kecil atau besar.
    </p>

    <ol class="langkah-grid">
      {
        langkah.map((item) => (
          <li class="langkah-item">
            <div class="langkah-item__head">
              <span class="langkah-item__nomor t-mono">{item.nomor}</span>
              <span class="icon-tile icon-tile--sm icon-tile--brand">
                <Icon name={item.ikon} size={18} />
              </span>
            </div>
            <h3>{item.judul}</h3>
            <p class="t-muted">{item.teks}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section shell section--sunken">
    <p class="eyebrow">Layanan</p>
    <h2>Yang Kami Kerjakan</h2>

    <ul class="layanan-grid">
      {
        layanan.map((item) => (
          <li class="card layanan-card">
            <span class="icon-tile icon-tile--brand">
              <Icon name={item.ikon} size={20} />
            </span>
            <h3>{item.judul}</h3>
            <p class="t-muted">{item.teks}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section shell">
    <p class="eyebrow">Batasan layanan</p>
    <h2>Yang Tidak Kami Kerjakan</h2>
    <p class="lede batasan-lede">
      Agar tidak ada ekspektasi yang salah, ini yang bukan cakupan kerja kami.
    </p>

    <ul class="batasan-grid">
      {
        batasan.map((item) => (
          <li class="batasan-item">
            <span class="batasan-item__ikon">
              <Icon name="close" size={14} />
            </span>
            <span>
              <strong>{item.judul}</strong>
              <span class="t-muted"> — {item.teks}</span>
            </span>
          </li>
        ))
      }
    </ul>

    <div class="alert alert--warn batasan-alert">
      <span class="alert__icon">
        <Icon name="alert" size={18} />
      </span>
      <div class="alert__body">
        <p class="alert__title">Studio ini sengaja tetap kecil</p>
        <p class="alert__text">
          Menangani sedikit proyek per bulan, supaya yang kami kerjakan
          benar-benar dikerjakan dengan baik.
        </p>
      </div>
    </div>
  </section>

  <section class="section shell">
    <div class="cta-card">
      <div>
        <h2>Punya proyek yang ingin dibicarakan?</h2>
        <p class="t-muted">Ceritakan lokasi, kebutuhan, dan target waktu Anda — kami balas dalam 1–2 hari kerja.</p>
      </div>
      <a href="/kontak" class="btn btn--primary btn--lg">Mulai konsultasi</a>
    </div>
  </section>
</BaseLayout>

<style>
  h1 {
    margin-bottom: 1.5rem;
  }

  .hero-tentang {
    padding-block: clamp(4rem, 10vw, 7rem) clamp(var(--space-6), 6vw, var(--space-7));
  }

  .hero-tentang__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    align-items: center;
  }

  .hero-tentang__marker {
    margin-bottom: var(--space-4);
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--surface-raised);
    width: fit-content;
  }

  .hero-tentang .lede {
    max-width: 34ch;
  }

  .hero-tentang__ilustrasi {
    width: 100%;
    max-width: 22rem;
    justify-self: center;
  }

  .hero-tentang__ilustrasi .stroke-faint {
    fill: none;
    stroke: var(--text-faint);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hero-tentang__ilustrasi .stroke-strong {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 1.5;
  }

  .hero-tentang__ilustrasi .stroke-border {
    fill: none;
    stroke: var(--border);
    stroke-width: 1;
  }

  .hero-tentang__ilustrasi .fill-brand {
    fill: var(--brand);
  }

  @media (min-width: 60rem) {
    .hero-tentang__grid {
      grid-template-columns: 1.05fr 0.95fr;
    }
  }

  /* Alternasi latar antar-section, seperti jeda napas di halaman panjang —
     bukan warna baru, cuma --bg-sunken yang sudah ada di token. */
  .section--sunken {
    background: var(--bg-sunken);
  }

  /* --- Siapa kami / Pendekatan ------------------------------------------ */

  .siapa-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
    gap: var(--space-5);
  }

  .siapa-card {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .siapa-card p:not(.t-label):not(.t-muted) {
    color: var(--text-body);
  }

  /* --- Cara kerja ---------------------------------------------------- */

  .langkah-lede {
    max-width: var(--measure);
  }

  .langkah-grid {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr));
    border-top: 1px solid var(--border);
  }

  .langkah-item {
    padding: var(--space-6) var(--space-5) var(--space-5);
    border-left: 1px solid var(--border);
    transition: background-color var(--dur) var(--ease);
  }

  .langkah-item:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .langkah-item:hover {
    background: var(--surface-hover);
  }

  .langkah-item__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .langkah-item__nomor {
    font-size: var(--text-2xl);
    color: var(--text-faint);
  }

  .langkah-item h3 {
    margin-bottom: var(--space-2);
  }

  /* --- Layanan --------------------------------------------------------- */

  .layanan-grid {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
    gap: var(--space-5);
  }

  .layanan-card {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
    background: var(--bg-sunken);
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .layanan-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }

  .layanan-card h3 {
    margin-top: var(--space-1);
  }

  /* --- Batasan ----------------------------------------------------------- */

  .batasan-lede {
    max-width: var(--measure);
  }

  .batasan-grid {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(20rem, 100%), 1fr));
    gap: var(--space-4) var(--space-6);
  }

  .batasan-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-2);
    margin: calc(var(--space-2) * -1);
    border-radius: var(--radius-md);
    transition: background-color var(--dur) var(--ease);
  }

  .batasan-item:hover {
    background: var(--surface-hover);
  }

  .batasan-item__ikon {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
    border-radius: 50%;
    background: var(--warn-soft);
    color: var(--warn);
    margin-top: 0.15rem;
  }

  .batasan-alert {
    margin-top: var(--space-6);
  }

  /* --- CTA ----------------------------------------------------------- */

  .cta-card {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .cta-card h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
  }
</style>
