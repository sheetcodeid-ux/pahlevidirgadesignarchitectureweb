import "../../../styles/rekening-kit.css";

/* Semua Transaksi = REKENING KORAN STUDIO (lihat kepala TransaksiKit.tsx).

   Satu-satunya halaman yang membaca TIGA tabel uang sekaligus:
   `project_payments`, `project_costs`, dan `studio_ledger`, digabung jadi
   satu daftar berurut waktu dengan saldo berjalan. `transaksi-kit.css`
