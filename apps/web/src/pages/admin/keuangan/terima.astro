---
import KitLayout from "../../../layouts/KitLayout.astro";
import { TerimaKit } from "../../../components/admin/TerimaKit";
import "../../../styles/terima-kit.css";

/* Halaman KEDUA yang pindah ke kit (P4), mengikuti frame Figma
   "07. Transfer".

   Berdampingan, bukan menggantikan: dialog terima pembayaran yang lama
   (`PaymentFlow.KolomPembayaran`) tetap hidup di tabel Semua Proyek. Yang
   itu kontekstual — staf sedang melihat satu proyek dan mencatat uang yang
   baru masuk untuknya. Yang ini berdiri sendiri: staf memegang uangnya
   dulu, baru mencari proyeknya. Keduanya menulis lewat endpoint yang SAMA
   dengan bentuk isian yang sama, jadi tidak ada angka yang bisa tercatat
   dua kali — yang bertambah cuma pintu masuknya.

   Letaknya di bawah /admin/keuangan/, bukan di akar /admin/, karena
   Keuangan memang sudah jadi satu pintu (lihat Riwayat keputusan di
   CLAUDE.md). */
---

<KitLayout title="Terima Pembayaran" judul="Terima Pembayaran">
  <TerimaKit client:load />
</KitLayout>
