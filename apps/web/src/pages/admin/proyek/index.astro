---
import KitLayout from "../../../layouts/KitLayout.astro";
import { ProyekKit } from "../../../components/admin/ProyekKit";
/* Kelas sel transaksi (`.trx__sel`, `.trx__ubin`, `.trx__masuk`) milik
   halaman Semua Transaksi dipakai ULANG di tabel transaksi proyek, bukan
   disalin — dua salinan bentuk yang sama pasti menyimpang (jebakan #32).
   Aturan akar `.trx` di berkas itu tidak menyentuh halaman ini. */
import "../../../styles/transaksi-kit.css";
import "../../../styles/proyek-kit.css";

/* Halaman KEENAM yang pindah ke kit (P4), mengikuti frame Figma
   "19. Cards". Menggantikan daftar lama (ProjectList): kartu per proyek di
   kiri, rincian proyek terpilih di kanan. */
---

<KitLayout title="Semua Proyek" judul="Semua Proyek">
  <ProyekKit client:load />
</KitLayout>
