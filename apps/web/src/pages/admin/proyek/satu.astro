---
import KitLayout from "../../../layouts/KitLayout.astro";
import { SatuProyekKit } from "../../../components/admin/SatuProyekKit";
import { CAP_BUILD } from "../../../lib/capBuild";
/* `.pro__pilih` (pemilih teks ber-<select>) milik halaman Semua Proyek
   dipakai ulang untuk judul pemilih proyek, bukan disalin. */
import "../../../styles/proyek-kit.css";
import "../../../styles/satu-kit.css";

/* Halaman KETUJUH yang pindah ke kit (P4), mengikuti frame Figma
   "22. Saving Plans": satu proyek, dilihat per tahap pipelinenya. Dibuka
   dari tombol "Buka" di Semua Proyek dengan `?id=`. */
---

<KitLayout title="Satu Proyek" judul="Satu Proyek">
  <SatuProyekKit client:load dibangunPada={CAP_BUILD} />
</KitLayout>
