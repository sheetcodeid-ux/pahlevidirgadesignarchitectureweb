---

<KitLayout title="Panduan" judul="Panduan">
  <div class="pd">
    <nav class="pd__isi" aria-label="Daftar isi panduan">
      <label class="pd__cari">
        <input type="search" id="pd-cari" placeholder="Cari di panduan" aria-label="Cari di panduan" autocomplete="off" />
        <Ikon ikon={MagnifyingGlass} ukuran={16} />
      </label>
      <ol class="pd__daftar">
        {
          ALUR.map((a) => (
            <li>
              <a href={`#${a.id}`} data-ke={a.id}>
                <span class="pd__daftarikon">
                  <Ikon ikon={a.ikon} ukuran={16} />
                </span>
                {a.judul}
              </a>
            </li>
          ))
        }
        <li>
          <a href="#tanya" data-ke="tanya">
            <span class="pd__daftarikon">
              <Ikon ikon={Question} ukuran={16} />
            </span>
            Tanya jawab
          </a>
        </li>
      </ol>
    </nav>

    <div class="pd__badan" id="pd-badan">
      <p class="pd__kosong" id="pd-kosong" hidden>Tidak ada yang cocok. Coba kata lain, mis. “bayar” atau “terbit”.</p>
      {
        ALUR.map((a) => (
          <section class="pd__alur" id={a.id} data-cari={`${a.judul} ${a.ringkas} ${a.langkah.join(" ")}`.toLowerCase()}>
            <header class="pd__kepala">
              <span class="pd__ubin">
                <Ikon ikon={a.ikon} ukuran={20} />
              </span>
              <div>
                <h2 class="pd__judul">{a.judul}</h2>
                <p class="pd__ringkas">{a.ringkas}</p>
              </div>
            </header>
            <ol class="pd__langkah">
              {a.langkah.map((l) => (
                <li>{l}</li>
              ))}
            </ol>
            <div class="pd__buka">
              {a.buka.map((b) => (
                <a class="pd__tombol" href={b.href}>
                  {b.label}
                  <Ikon ikon={ArrowRight} ukuran={14} />
                </a>
              ))}
            </div>
          </section>
        ))
      }

      <section class="pd__alur" id="tanya" data-cari={TANYA.map((x) => `${x.t} ${x.j}`).join(" ").toLowerCase()}>
        <header class="pd__kepala">
          <span class="pd__ubin">
            <Ikon ikon={Question} ukuran={20} />
          </span>
          <div>
            <h2 class="pd__judul">Tanya jawab</h2>
            <p class="pd__ringkas">Yang paling sering ditanyakan.</p>
          </div>
        </header>
        <div class="pd__tanya">
          {
            TANYA.map((x) => (
              <details class="pd__butirtanya">
                <summary>{x.t}</summary>
                <p>{x.j}</p>
              </details>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</KitLayout>

<script>
  /* Cari + penanda daftar isi. Penanda memakai IntersectionObserver, bukan
     handler gulir yang membaca geometri (jebakan #21). Dipasang ulang tiap
     halaman dimuat router sisi klien. */
  function pasang() {
    const badan = document.getElementById("pd-badan");
    const cari = document.getElementById("pd-cari") as HTMLInputElement | null;
    if (!badan || !cari) return;
    const seksi = [...badan.querySelectorAll<HTMLElement>(".pd__alur")];
    const tautan = [...document.querySelectorAll<HTMLAnchorElement>(".pd__daftar a")];
    const kosong = document.getElementById("pd-kosong")!;

    cari.addEventListener("input", () => {
      const q = cari.value.trim().toLowerCase();
      let ada = 0;
      for (const s of seksi) {
        const cocok = !q || (s.dataset.cari ?? "").includes(q);
        s.hidden = !cocok;
        if (cocok) ada++;
        const t = tautan.find((a) => a.dataset.ke === s.id);
        if (t) t.parentElement!.hidden = !cocok;
      }
      kosong.hidden = ada > 0;
    });

    for (const a of tautan) {
      a.addEventListener("click", (e) => {
        e.preventDefault();
        document.getElementById(a.dataset.ke!)?.scrollIntoView({ behavior: "smooth", block: "start" });
        history.replaceState(null, "", `#${a.dataset.ke}`);
      });
    }

    const pengamat = new IntersectionObserver(
      (masuk) => {
        for (const m of masuk) {
          if (!m.isIntersecting) continue;
          for (const a of tautan) a.toggleAttribute("aria-current", a.dataset.ke === m.target.id);
        }
      },
      // Di desktop badan panduan yang menggulir (kerangka satu-layar); di
      // ponsel halamannya sendiri.
      { root: getComputedStyle(badan).overflowY === "auto" ? badan : null, rootMargin: "0px 0px -70% 0px" },
    );
    seksi.forEach((s) => pengamat.observe(s));
  }
  document.addEventListener("astro:page-load", pasang);
</script>
