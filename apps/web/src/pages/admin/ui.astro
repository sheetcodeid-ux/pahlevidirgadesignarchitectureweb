---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { MasterGuard } from "../../components/admin/MasterGuard";
import { FormShowcase } from "../../components/admin/FormShowcase";
import { OverlayShowcase } from "../../components/admin/OverlayShowcase";
import { DataShowcase } from "../../components/admin/DataShowcase";
import { MiscShowcase } from "../../components/admin/MiscShowcase";
import { Icon } from "../../components/ui/Icon";

// Warna ditampilkan lewat variabel CSS-nya, bukan nilai heksa yang disalin.
// Dengan begitu petak warna di halaman ini ikut berubah saat tema diganti,
// dan tidak bisa hanyut berbeda dari token yang sebenarnya.
const warna = [
  { grup: "Permukaan", token: ["--bg", "--bg-sunken", "--surface", "--surface-raised", "--surface-hover"] },
  { grup: "Garis", token: ["--border", "--border-strong"] },
  { grup: "Teks", token: ["--text-strong", "--text-body", "--text-muted", "--text-faint"] },
  { grup: "Semantik", token: ["--brand", "--upgrade", "--warn", "--success", "--info"] },
];

const tombol = [
  { kelas: "btn--primary", nama: "Primary", catatan: "Aksi utama. Satu per layar." },
  { kelas: "btn--secondary", nama: "Secondary", catatan: "Aksi pendamping." },
  { kelas: "btn--ghost", nama: "Ghost", catatan: "Aksi tersier, di dalam toolbar." },
  { kelas: "btn--brand", nama: "Brand", catatan: "Aksi bertekanan tinggi." },
  { kelas: "btn--upgrade", nama: "Upgrade", catatan: "Hanya untuk fitur berbayar." },
  { kelas: "btn--danger", nama: "Danger", catatan: "Menghapus, memutus." },
];

const lencana = [
  { kelas: "", nama: "Netral" },
  { kelas: "badge--brand", nama: "Brand" },
  { kelas: "badge--upgrade", nama: "Upgrade" },
  { kelas: "badge--warn", nama: "Peringatan" },
  { kelas: "badge--success", nama: "Sukses" },
  { kelas: "badge--info", nama: "Info" },
];

const ikon = [
  "dashboard", "project", "image", "inquiry", "component", "coffee", "team", "finance", "settings",
  "logout", "chevronDown", "chevronRight", "chevronLeft", "sun", "moon",
  "check", "plus", "search", "trash", "edit", "upload", "calendar",
  "alert", "info", "lock", "external", "copy", "filter", "close", "document", "directory",
  "quote", "star",
] as const;

// Subset ikon yang punya gambar filled terpisah — dipakai nav sidebar untuk
// menandai keadaan terpilih. Daftar ini harus tetap sinkron dengan kunci
// PATHS_FILLED di Icon.tsx.
const ikonBerpasangan = [
  "dashboard", "project", "check", "finance", "inquiry", "team", "directory", "quote", "settings", "component",
] as const;
---

<AdminLayout
  title="UI Component"
  heading="UI Component"
  description="Sumber kebenaran komponen. Fitur baru mengambil dari sini — jangan membuat komponen baru tanpa mendaftarkannya."
>
  <MasterGuard client:load target="galeri" />

  <div id="galeri" hidden class="stack" style="gap: var(--space-7)">
    <!-- Token warna -->
    <section class="spec-section">
      <div class="spec-section__head">
        <h2 class="t-heading">Token warna</h2>
        <p class="t-muted" style="margin:0">Ganti tema di kanan atas — petak di bawah ikut berubah.</p>
      </div>

      {
        warna.map((g) => (
          <div class="stack" style="gap: var(--space-3)">
            <p class="t-label" style="margin:0">{g.grup}</p>
            <div class="spec-swatches">
              {g.token.map((t) => (
                <div class="swatch">
                  <div class="swatch__chip" style={`background: var(${t})`} />
                  <span class="swatch__name">{t}</span>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </section>

    <!-- Typography -->
    <section class="spec-section">
      <div class="spec-section__head">
        <h2 class="t-heading">Typography</h2>
        <p class="t-muted" style="margin:0">Serif untuk judul halaman, sans untuk perkakas, mono untuk data.</p>
      </div>
      <div class="spec-demo">
        <div class="spec-demo__stage spec-demo__stage--stack">
          <p class="t-display" style="margin:0">Selamat datang.</p>
          <p class="t-title" style="margin:0">Judul halaman</p>
          <p class="t-heading">Judul kartu</p>
          <p class="t-subheading">Sub-judul</p>
          <p class="t-body" style="margin:0">Teks isi — ukuran yang dipakai untuk hampir semua kalimat di panel ini.</p>
          <p class="t-muted" style="margin:0">Teks pendukung yang lebih redup.</p>
          <p class="t-label" style="margin:0">Label seksi</p>
          <p class="t-mono" style="margin:0">082354860207 · Rp 120.000</p>
          <p class="t-numeral" style="margin:0">28</p>
        </div>
      </div>
    </section>

    <!-- Button -->
    <section class="spec-section">
      <div class="spec-section__head">
        <h2 class="t-heading">Button</h2>
        <p class="t-muted" style="margin:0">Enam varian, masing-masing punya tugas tetap.</p>
      </div>
      <div class="spec-grid">
        {
          tombol.map((t) => (
            <div class="spec-demo">
              <div class="spec-demo__name">
                <span class="t-subheading">{t.nama}</span>
                <code class="swatch__name">.{t.kelas}</code>
              </div>
              <div class="spec-demo__stage">
                <button type="button" class={`btn ${t.kelas}`}>Simpan</button>
                <button type="button" class={`btn ${t.kelas} btn--sm`}>Kecil</button>
                <button type="button" class={`btn ${t.kelas}`} disabled>Nonaktif</button>
              </div>
              <p class="t-muted" style="margin:0">{t.catatan}</p>
            </div>
          ))
        }
        <div class="spec-demo">
          <div class="spec-demo__name">
            <span class="t-subheading">Dengan ikon</span>
            <code class="swatch__name">.btn--icon</code>
          </div>
          <div class="spec-demo__stage">
            <button type="button" class="btn btn--primary">
              <Icon name="plus" size={16} />Tambah Proyek
            </button>
            <button type="button" class="btn btn--secondary btn--icon" aria-label="Sunting">
              <Icon name="edit" size={16} />
            </button>
          </div>
          <p class="t-muted" style="margin:0">Ikon selalu cocok dengan labelnya.</p>
        </div>
      </div>
    </section>

    <!-- Badge -->
    <section class="spec-section">
      <div class="spec-section__head">
        <h2 class="t-heading">Badge</h2>
        <p class="t-muted" style="margin:0">Warnanya menyatakan makna, bukan selera.</p>
      </div>
      <div class="spec-demo">
        <div class="spec-demo__stage">
          {lencana.map((b) => <span class={`badge ${b.kelas}`}>{b.nama}</span>)}
          <span class="badge badge--success"><span class="badge__dot" />Aktif</span>
        </div>
      </div>
    </section>

    <!-- Card -->
    <section class="spec-section">
      <div class="spec-section__head">
        <h2 class="t-heading">Card</h2>
        <p class="t-muted" style="margin:0">Tile ikon, judul, subjudul, isi, lalu baris aksi opsional.</p>
      </div>
      <div class="spec-grid">
        <div class="card">
          <div class="card__header">
            <span class="icon-tile"><Icon name="project" size={20} /></span>
            <span class="card__titles">
              <span class="t-subheading">Rumah Tepi Sawah</span>
              <span class="t-muted">Canggu, Badung · 2024</span>
            </span>
          </div>
          <div class="card__body">
            <p class="t-body" style="margin:0">
              Hunian dua lantai dengan koridor angin melintang.
            </p>
          </div>
          <div class="card__footer">
            <span class="badge badge--success"><span class="badge__dot" />Published</span>
            <button type="button" class="btn btn--secondary btn--sm">
              <Icon name="edit" size={14} />Sunting
            </button>
          </div>
        </div>

        <div class="card">
          <div class="card__header">
            <span class="icon-tile icon-tile--invert"><Icon name="inquiry" size={20} /></span>
            <span class="card__titles">
              <span class="t-subheading">Tile terbalik</span>
              <span class="t-muted">Dipakai untuk judul halaman.</span>
            </span>
          </div>
        </div>

        <div class="card">
          <div class="card__header">
            <span class="icon-tile icon-tile--brand"><Icon name="alert" size={20} /></span>
            <span class="card__titles">
              <span class="t-subheading">Tile brand</span>
              <span class="t-muted">Hanya untuk hal yang menuntut perhatian.</span>
            </span>
          </div>
        </div>
      </div>
    </section>

    <!-- Item -->
    <section class="spec-section">
      <div class="spec-section__head">
        <h2 class="t-heading">Item</h2>
        <p class="t-muted" style="margin:0">Baris yang bisa diklik — judul, deskripsi, jejak di kanan.</p>
      </div>
      <div class="spec-demo spec-demo__stage--stack">
        <a href="#galeri" class="item item--bordered">
          <span class="icon-tile icon-tile--sm"><Icon name="settings" size={16} /></span>
          <span class="item__text">
            <span class="item__title">Info Studio</span>
            <span class="item__desc">Nama, kontak, dan alamat yang tampil di situs</span>
          </span>
          <span class="item__trail"><Icon name="chevronRight" size={18} /></span>
        </a>
        <button type="button" class="item item--danger">
          <span class="icon-tile icon-tile--sm"><Icon name="logout" size={16} /></span>
          <span class="item__text">
            <span class="item__title">Keluar</span>
            <span class="item__desc">Keluar dari akun ini</span>
          </span>
        </button>
      </div>
    </section>

    <!-- Breadcrumb & Separator -->
    <section class="spec-section">
      <div class="spec-section__head">
        <h2 class="t-heading">Breadcrumb &amp; Separator</h2>
      </div>
      <div class="spec-demo spec-demo__stage--stack">
        <nav class="breadcrumb" aria-label="Contoh remah roti">
          <a href="#galeri">Admin</a>
          <span class="breadcrumb__sep" aria-hidden="true">/</span>
          <a href="#galeri">Proyek</a>
          <span class="breadcrumb__sep" aria-hidden="true">/</span>
          <span aria-current="page">Rumah Tepi Sawah</span>
        </nav>
        <hr class="separator" />
        <div class="row">
          <span class="t-muted">Kiri</span>
          <hr class="separator separator--vertical" style="height: 1.5rem" />
          <span class="t-muted">Kanan</span>
        </div>
      </div>
    </section>

    <!-- Icon -->
    <section class="spec-section">
      <div class="spec-section__head">
        <h2 class="t-heading">Icon</h2>
        <p class="t-muted" style="margin:0">
          SVG inline, semuanya pada grid 24 dengan stroke seragam. Tanpa emoji, tanpa icon-font.
        </p>
      </div>
      <div class="spec-demo">
        <div class="spec-swatches">
          {
            ikon.map((n) => (
              <div class="swatch" style="align-items:center; text-align:center">
                <span class="icon-tile"><Icon name={n} size={20} /></span>
                <span class="swatch__name">{n}</span>
              </div>
            ))
          }
        </div>
      </div>

      <div class="spec-demo" style="margin-top: var(--space-5)">
        <p class="t-muted" style="margin: 0 0 var(--space-3)">
          Sebagian ikon punya varian <strong>filled</strong> — gambar solid yang berbeda dari
          versi stroke-nya, bukan cuma pewarnaan ulang. Dipakai untuk menandai keadaan
          terpilih/aktif (mis. item sidebar yang sedang dibuka): <strong>stroke</strong> saat
          tidak dipilih, <strong>filled</strong> otomatis saat dipilih.
        </p>
        <div class="spec-swatches">
          {
            ikonBerpasangan.map((n) => (
              <div class="swatch" style="align-items:center; text-align:center; gap: var(--space-2)">
                <span class="row" style="gap: var(--space-3)">
                  <span class="icon-tile"><Icon name={n} size={20} variant="stroke" /></span>
                  <span class="icon-tile"><Icon name={n} size={20} variant="filled" /></span>
                </span>
                <span class="swatch__name">{n}</span>
              </div>
            ))
          }
        </div>
      </div>
    </section>


    <!-- Form -->
    <section class="spec-section">
      <div class="spec-section__head">
        <h2 class="t-heading">Form</h2>
        <p class="t-muted" style="margin:0">
          Dibangun di atas elemen HTML asli — yang diganti hanya penampilannya.
        </p>
      </div>

      <div class="spec-grid">
        <div class="spec-demo">
          <div class="spec-demo__name">
            <span class="t-subheading">Input</span>
            <code class="swatch__name">.field · .input</code>
          </div>
          <div class="spec-demo__stage spec-demo__stage--stack">
            <div class="field">
              <label class="field__label" for="d-nama">
                Nama proyek<span class="field__req" aria-hidden="true">*</span>
              </label>
              <input id="d-nama" class="input" type="text" placeholder="Rumah Tepi Sawah" />
              <p class="field__help">Muncul sebagai judul di halaman publik.</p>
            </div>

            <div class="field" data-invalid>
              <label class="field__label" for="d-slug">Slug</label>
              <input id="d-slug" class="input input--mono" type="text" value="rumah tepi sawah" aria-invalid="true" aria-describedby="d-slug-err" />
              <p class="field__error" id="d-slug-err">
                <Icon name="alert" size={15} />
                Slug tidak boleh mengandung spasi.
              </p>
            </div>

            <div class="field">
              <label class="field__label" for="d-mati">Dikunci</label>
              <input id="d-mati" class="input" type="text" value="Tidak bisa diubah" disabled />
            </div>
          </div>
        </div>

        <div class="spec-demo">
          <div class="spec-demo__name">
            <span class="t-subheading">Textarea &amp; Select</span>
            <code class="swatch__name">.input--area · .select</code>
          </div>
          <div class="spec-demo__stage spec-demo__stage--stack">
            <div class="field">
              <label class="field__label" for="d-desc">Deskripsi</label>
              <textarea id="d-desc" class="input input--area" placeholder="Ceritakan konteks tapak dan keputusan rancangannya…"></textarea>
            </div>

            <div class="field">
              <label class="field__label" for="d-kat">Kategori</label>
              <span class="select">
                <select id="d-kat" class="input">
                  <option>Hunian</option>
                  <option>Komersial</option>
                  <option>Interior</option>
                  <option>Renovasi</option>
                </select>
                <span class="select__chevron"><Icon name="chevronDown" size={16} /></span>
              </span>
            </div>
          </div>
        </div>

        <div class="spec-demo">
          <div class="spec-demo__name">
            <span class="t-subheading">Input Group</span>
            <code class="swatch__name">.input-group · .input-affix</code>
          </div>
          <div class="spec-demo__stage spec-demo__stage--stack">
            <div class="field">
              <label class="field__label" for="d-kode">Kode referral</label>
              <div class="input-group">
                <input id="d-kode" class="input input--mono" type="text" placeholder="STUDIO-2026" />
                <button type="button" class="btn btn--secondary">Periksa</button>
              </div>
            </div>

            <div class="field">
              <label class="field__label" for="d-luas">Luas bangunan</label>
              <div class="input-affix">
                <input id="d-luas" class="input" type="number" placeholder="320" />
                <span class="input-affix__unit">m²</span>
              </div>
            </div>
          </div>
        </div>

        <div class="spec-demo">
          <div class="spec-demo__name">
            <span class="t-subheading">Checkbox &amp; Radio</span>
            <code class="swatch__name">.choice</code>
          </div>
          <div class="spec-demo__stage spec-demo__stage--stack">
            <label class="choice">
              <input type="checkbox" checked />
              <span class="choice__text">
                <span>Tandai sebagai proyek unggulan</span>
                <span class="choice__desc">Tampil di beranda</span>
              </span>
            </label>
            <label class="choice">
              <input type="checkbox" />
              <span class="choice__text"><span>Sembunyikan dari arsip</span></span>
            </label>
            <label class="choice">
              <input type="checkbox" disabled />
              <span class="choice__text"><span>Tidak tersedia</span></span>
            </label>
            <hr class="separator" />
            <label class="choice">
              <input type="radio" name="d-status" checked />
              <span class="choice__text"><span>Draf</span></span>
            </label>
            <label class="choice">
              <input type="radio" name="d-status" />
              <span class="choice__text"><span>Terbit</span></span>
            </label>
          </div>
        </div>

        <div class="spec-demo" style="grid-column: 1 / -1">
          <div class="spec-demo__name">
            <span class="t-subheading">Radio Card</span>
            <code class="swatch__name">.radio-card</code>
          </div>
          <p class="t-muted" style="margin:0">
            Untuk pilihan yang berkonsekuensi. Yang terpilih ditandai border dan latar brand — tidak mungkin salah baca.
          </p>
          <div class="spec-demo__stage" style="align-items: stretch">
            <label class="radio-card" style="flex:1; min-width:16rem">
              <input type="radio" name="d-mode" checked />
              <span class="radio-card__mark"><Icon name="check" size={14} /></span>
              <span class="radio-card__body">
                <span class="radio-card__title">Terbitkan sekarang</span>
                <span class="radio-card__desc">Proyek langsung tampil setelah build berikutnya.</span>
              </span>
            </label>
            <label class="radio-card" style="flex:1; min-width:16rem">
              <input type="radio" name="d-mode" />
              <span class="radio-card__mark"><Icon name="check" size={14} /></span>
              <span class="radio-card__body">
                <span class="radio-card__title">Simpan sebagai draf</span>
                <span class="radio-card__desc">Hanya terlihat oleh staf studio.</span>
              </span>
            </label>
          </div>
        </div>

        <div class="spec-demo">
          <div class="spec-demo__name">
            <span class="t-subheading">Button Group</span>
            <code class="swatch__name">.btn-group</code>
          </div>
          <div class="spec-demo__stage">
            <div class="btn-group">
              <button type="button" class="btn btn--secondary">Hari ini</button>
              <button type="button" class="btn btn--secondary">Minggu</button>
              <button type="button" class="btn btn--secondary">Bulan</button>
            </div>
          </div>
        </div>
      </div>

      <FormShowcase client:visible />
    </section>

    <!-- Overlay -->
    <section class="spec-section">
      <div class="spec-section__head">
        <h2 class="t-heading">Overlay</h2>
        <p class="t-muted" style="margin:0">
          Perilakunya — focus trap, pengembalian fokus, Esc, penempatan sadar tepi layar — datang dari primitif headless. Tampilannya seluruhnya milik kita.
        </p>
      </div>
      <OverlayShowcase client:visible />
    </section>

    <!-- Data & konten -->
    <section class="spec-section">
      <div class="spec-section__head">
        <h2 class="t-heading">Data &amp; Konten</h2>
        <p class="t-muted" style="margin:0">
          Palet grafik divalidasi terhadap simulasi buta warna, bukan dipilih dengan mata.
        </p>
      </div>
      <DataShowcase client:visible />
    </section>

    <!-- Umpan balik & konten -->
    <section class="spec-section">
      <div class="spec-section__head">
        <h2 class="t-heading">Umpan Balik &amp; Status</h2>
        <p class="t-muted" style="margin:0">Alert, Progress, Skeleton, Spinner, Marker, Empty, Kbd, Aspect Ratio.</p>
      </div>

      <div class="spec-grid">
        <div class="spec-demo" style="grid-column: 1 / -1">
          <div class="spec-demo__name">
            <span class="t-subheading">Alert</span>
            <code class="swatch__name">.alert</code>
          </div>
          <div class="stack" style="gap: var(--space-3)">
            <div class="alert alert--info">
              <span class="alert__icon"><Icon name="info" size={18} /></span>
              <span class="alert__body">
                <span class="alert__title">Konten baru butuh build ulang</span>
                <span class="alert__text">Halaman proyek dirender saat deploy. Perubahan tampil setelah build berikutnya.</span>
              </span>
            </div>
            <div class="alert alert--warn">
              <span class="alert__icon"><Icon name="alert" size={18} /></span>
              <span class="alert__body">
                <span class="alert__text"><b>Turnstile belum dikonfigurasi</b> — form kontak akan menerima kiriman bot.</span>
              </span>
            </div>
            <div class="alert alert--danger">
              <span class="alert__icon"><Icon name="alert" size={18} /></span>
              <span class="alert__body">
                <span class="alert__text"><b>Koneksi database terputus</b> — pesan masuk tidak tersimpan sejak 14.20.</span>
              </span>
            </div>
            <div class="alert alert--success">
              <span class="alert__icon"><Icon name="check" size={18} /></span>
              <span class="alert__body">
                <span class="alert__text"><b>Build selesai</b> — 12 halaman diperbarui.</span>
              </span>
            </div>
          </div>
        </div>

        <div class="spec-demo">
          <div class="spec-demo__name">
            <span class="t-subheading">Progress</span>
            <code class="swatch__name">.progress</code>
          </div>
          <div class="spec-demo__stage spec-demo__stage--stack">
            <div class="progress">
              <div class="progress__meta"><span>Mengunggah galeri</span><span>7 dari 12</span></div>
              <div class="progress__track" role="progressbar" aria-valuemin="0" aria-valuemax="12" aria-valuenow="7">
                <div class="progress__fill" style="width: 58%"></div>
              </div>
            </div>
            <div class="progress">
              <div class="progress__meta"><span>Kuota penyimpanan</span><span>0,4 dari 10 GB</span></div>
              <div class="progress__track"><div class="progress__fill progress__fill--success" style="width: 4%"></div></div>
            </div>
          </div>
        </div>

        <div class="spec-demo">
          <div class="spec-demo__name">
            <span class="t-subheading">Skeleton</span>
            <code class="swatch__name">.skeleton</code>
          </div>
          <div class="spec-demo__stage spec-demo__stage--stack">
            <div class="row" style="gap: var(--space-3)">
              <span class="skeleton skeleton--circle" style="width:2.5rem;height:2.5rem"></span>
              <span class="grow stack" style="gap: 0.5rem">
                <span class="skeleton skeleton--title"></span>
                <span class="skeleton skeleton--text"></span>
              </span>
            </div>
            <span class="skeleton" style="height:6rem"></span>
          </div>
        </div>

        <div class="spec-demo">
          <div class="spec-demo__name">
            <span class="t-subheading">Spinner &amp; Kbd</span>
            <code class="swatch__name">.spinner · .kbd</code>
          </div>
          <div class="spec-demo__stage">
            <span class="spinner spinner--sm"></span>
            <span class="spinner"></span>
            <span class="spinner spinner--lg"></span>
            <button type="button" class="btn btn--primary" disabled>
              <span class="spinner spinner--sm spinner--on-action"></span>Menyimpan
            </button>
            <span class="row" style="gap:0.35rem">
              <kbd class="kbd">⌘</kbd><kbd class="kbd">K</kbd>
            </span>
          </div>
        </div>

        <div class="spec-demo">
          <div class="spec-demo__name">
            <span class="t-subheading">Marker</span>
            <code class="swatch__name">.marker</code>
          </div>
          <div class="spec-demo__stage spec-demo__stage--stack">
            <span class="marker marker--live"><span class="marker__dot"></span>Terbit</span>
            <span class="marker marker--new"><span class="marker__dot"></span>Belum dibaca</span>
            <span class="marker marker--warn"><span class="marker__dot"></span>Perlu ditinjau</span>
            <span class="marker"><span class="marker__dot"></span>Arsip</span>
            <span class="marker-anchor">
              <button type="button" class="btn btn--secondary btn--icon" aria-label="Notifikasi, ada yang belum dibaca">
                <Icon name="inquiry" size={16} />
              </button>
              <span class="marker-anchor__dot"></span>
            </span>
          </div>
        </div>

        <div class="spec-demo">
          <div class="spec-demo__name">
            <span class="t-subheading">Aspect Ratio</span>
            <code class="swatch__name">.aspect</code>
          </div>
          <div class="spec-demo__stage spec-demo__stage--stack">
            <div class="aspect aspect--16-9" style="display:grid;place-items:center;color:var(--text-faint)">16 : 9</div>
            <div class="row" style="gap: var(--space-3)">
              <div class="aspect aspect--4-3 grow" style="display:grid;place-items:center;color:var(--text-faint)">4 : 3</div>
              <div class="aspect aspect--1-1 grow" style="display:grid;place-items:center;color:var(--text-faint)">1 : 1</div>
            </div>
          </div>
        </div>

        <div class="spec-demo">
          <div class="spec-demo__name">
            <span class="t-subheading">Empty</span>
            <code class="swatch__name">.empty</code>
          </div>
          <div class="empty empty--sm">
            <span class="icon-tile"><Icon name="inquiry" size={20} /></span>
            <span class="t-subheading">Belum ada pesan masuk</span>
            <p class="t-muted">Pesan dari form kontak akan muncul di sini.</p>
            <a class="btn btn--secondary" href="/kontak">Lihat form kontak</a>
          </div>
        </div>

        <div class="spec-demo" style="grid-column: 1 / -1">
          <div class="spec-demo__name">
            <span class="t-subheading">Accordion &amp; Collapsible</span>
            <code class="swatch__name">&lt;details&gt;</code>
          </div>
          <p class="t-muted" style="margin:0">
            Dibangun di atas elemen <code>&lt;details&gt;</code> bawaan — bisa dibuka keyboard, dicari lewat Ctrl+F, dan tetap terbuka saat halaman dicetak.
          </p>
          <div class="accordion">
            <details open>
              <summary>Apa saja yang dibutuhkan sebelum survei?<span class="accordion__chevron"><Icon name="chevronDown" size={16} /></span></summary>
              <div class="accordion__body t-muted">Sertifikat tanah, gambar situasi bila ada, dan perkiraan anggaran.</div>
            </details>
            <details>
              <summary>Berapa lama tahap perancangan?<span class="accordion__chevron"><Icon name="chevronDown" size={16} /></span></summary>
              <div class="accordion__body t-muted">Empat sampai delapan minggu, tergantung kompleksitas dan kecepatan persetujuan.</div>
            </details>
            <details>
              <summary>Apakah studio mendampingi pelaksanaan?<span class="accordion__chevron"><Icon name="chevronDown" size={16} /></span></summary>
              <div class="accordion__body t-muted">Ya, dalam bentuk pengawasan berkala sesuai kesepakatan.</div>
            </details>
          </div>
        </div>
      </div>
    </section>

    <!-- Interaktif sisanya -->
    <section class="spec-section">
      <div class="spec-section__head">
        <h2 class="t-heading">Navigasi, Pesan &amp; Unggahan</h2>
        <p class="t-muted" style="margin:0">Avatar, Tabs, Pagination, Navigation Menu, Direction, Bubble, Message Scroller, Attachment, Questionnaire.</p>
      </div>
      <MiscShowcase client:visible />
    </section>

    <!-- Peta jalan -->
    <section class="spec-section">
      <div class="spec-section__head">
        <h2 class="t-heading">Status</h2>
        <p class="t-muted" style="margin:0">Urutannya ada di docs/design-system.md.</p>
      </div>
      <div class="spec-demo">
        <div class="spec-demo__stage">
          <span class="badge badge--success"><span class="badge__dot" />Seluruh 64 komponen selesai</span>
        </div>
      </div>
    </section>
  </div>
</AdminLayout>
