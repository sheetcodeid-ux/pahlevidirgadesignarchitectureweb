---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { IsiHalamanPanel, type Isian } from "../../../components/admin/IsiHalamanPanel";

/* Dua tahun yang dipakai garis waktu di halaman Studio.

   `tanya` adalah judul tonggaknya dan `kalimat` kalimat di bawahnya, keduanya
   disalin apa adanya dari `garisWaktu` di pages/studio.astro. Selama tahunnya
   kosong, situs mencetak "TAHUN?" — itu juga yang ditiru pratinjau, bukan
   penanda karangan sendiri.

   `foundedYear` dulu juga tampil sebagai "SINCE 20XX" di eyebrow beranda.
   Eyebrow itu sudah diganti lencana "Spesialis coffee shop & rumah tropis",
   jadi keterangannya diperbaiki di sini — isian yang mengaku tampil di tempat
   yang sudah tidak ada adalah cara tercepat membuat panel ini berhenti
   dipercaya. */
const isian: Isian[] = [
  {
    kunci: "foundedYear",
    label: "Tahun studio berdiri",
    contoh: "2025",
    jenis: "tahun",
    grup: "Garis waktu studio",
    bantuan: "Tonggak pertama di garis waktu halaman Studio.",
    tanya: "Studionya dimulai",
    kalimat: "Satu meja, satu meja gambar, dan keputusan untuk tetap kecil dengan sengaja.",
  },
  {
    kunci: "firstCommercialYear",
    label: "Tahun proyek komersial pertama",
    contoh: "2025",
    jenis: "tahun",
    grup: "Garis waktu studio",
    bantuan: "Tonggak kedua di garis waktu halaman Studio.",
    tanya: "Proyek komersial pertama",
    kalimat: "Titik saat pekerjaannya berhenti jadi rumah saja, dan gambarnya harus menjawab kepada sebuah usaha, bukan cuma kepada sebuah keluarga.",
  },
];
---

<AdminLayout title="Identitas Studio">
  <IsiHalamanPanel
    client:load
    isian={isian}
    pratinjau="garis-waktu"
    pratinjauJudul="Seperti yang tampil di garis waktu halaman Studio"
    situs={{
      judul: "Identitas studio",
      letak: "Garis waktu di halaman Studio",
      ikon: "building",
      tautan: "/studio/",
    }}
    catatan="Nama studio, email, telepon, dan logo diurus terpisah di Pengaturan → Info Studio, karena keempatnya juga dipakai panel admin — bukan hanya halaman publik. Yang ada di sini cuma dua tahun yang tidak bisa ditebak dari data lain."
  />
</AdminLayout>
