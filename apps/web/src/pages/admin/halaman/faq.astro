---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { IsiHalamanPanel, type Isian } from "../../../components/admin/IsiHalamanPanel";

/* Pertanyaan di /faq yang jawabannya sudah benar dan sudah tayang — yang belum
   ada cuma angkanya. Selama kosong, pertanyaan itu memakai lencana "angka
   ditanyakan"; begitu terisi, lencananya padam untuk pertanyaan itu saja,
   bukan untuk ketiganya sekaligus.

   TIGA, bukan empat. "Tarif jasa" (faqTarif) dibuang dari halaman ini karena
   tarifnya sekarang DITERBITKAN di beranda lewat lib/tier.ts, dan jawaban FAQ
   soal tarif sudah ditulis ulang untuk menunjuk ke sana. Isian yang tidak lagi
   dibaca siapa pun lebih buruk daripada isian yang tidak ada: ia mengundang
   diisi, lalu diam-diam tidak muncul di mana pun.

   `kalimat` mencetak pertanyaan aslinya dari /faq dengan nilainya tersisip,
   jadi yang diketik di sini bisa dibaca sebagai jawabannya sebelum disimpan. */
const isian: Isian[] = [
  {
    kunci: "faqUangMuka",
    label: "Uang muka",
    contoh: "30% di awal tahap pertama",
    grup: "Uang",
    bantuan: 'Menjawab "Berapa yang Anda butuhkan sebelum mulai?" di halaman FAQ.',
    kalimat: "Uang muka %s, lalu pembayaran setiap kali satu tahap diserahkan.",
  },
  {
    kunci: "faqLamaKerja",
    label: "Lama pengerjaan",
    contoh: "4–6 bulan untuk rumah tinggal",
    grup: "Waktu",
    bantuan: 'Menjawab "Berapa lama pengerjaannya?".',
    kalimat: "Dari tahap pertama sampai gambar kerja selesai: %s.",
  },
  {
    kunci: "faqKunjungan",
    label: "Kunjungan ke lokasi",
    contoh: "Dua kali per tahap, lebih kalau diperlukan",
    grup: "Waktu",
    bantuan: 'Menjawab "Apakah Anda datang ke lokasi selama pembangunan?".',
    kalimat: "Kunjungan ke lokasi selama proyek berjalan: %s.",
  },
];
---

<AdminLayout title="Angka di FAQ">
  <IsiHalamanPanel
    client:load
    isian={isian}
    situs={{
      judul: "Angka di FAQ",
      letak: "Tiga jawaban di halaman Tanya Jawab",
      ikon: "info",
      tautan: "/faq/",
      tautanLabel: "Lihat halaman FAQ",
    }}
    catatan="Isi dengan kalimat pendek, bukan sekadar bilangan — yang dibaca calon klien adalah kalimatnya, dan boleh berupa rentang. Tarif jasa tidak ada di sini lagi: sejak rentangnya diumumkan di beranda, jawaban FAQ soal tarif menunjuk ke sana."
  />
</AdminLayout>
