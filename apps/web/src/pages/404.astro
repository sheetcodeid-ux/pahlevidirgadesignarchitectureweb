---
import BaseLayout from "../layouts/BaseLayout.astro";

const jalan = [
  ["/proyek", "Karya", "Tiap proyek, berikut bagian sulitnya"],
  ["/studio", "Studio", "Siapa kami, dan untuk apa kami tidak cocok"],
  ["/jurnal", "Jurnal", "Yang kami pelajari dengan cara mahal"],
  ["/faq", "Tanya jawab", "Tarif, jadwal, perizinan — dijawab apa adanya"],
  ["/kontak", "Kontak", "Percakapan pertama tidak dipungut biaya"],
  ["/progres", "Halaman proyek Anda", "Sudah jadi klien? Pakai tautan yang kami kirim"],
];
---

<BaseLayout title="Halaman tidak ditemukan" description="Alamat ini tidak ada." noindex>
  <div class="pita pita--akhir">
    <div class="dalam titik">
      <div class="nf">
        <div class="nf__k">
          <span class="nf__n">404</span>
          <div class="s16"></div>
          <h1 class="h2">Alamat ini tidak ada</h1>
          <div class="s16"></div>
          <p class="mut nf__ket">
            Tautannya salah ketik, atau ada halaman yang pindah dan tidak kami alihkan — yang
            kedua itu salah kami. Ini semua yang benar-benar ada di situs ini.
          </p>

          <div class="jalan">
            {
              jalan.map(([href, judul, ket]) => (
                <a href={href}>
                  <b>{judul}</b>
                  <span>{ket}</span>
                </a>
              ))
            }
          </div>

          <div class="s36"></div>
          <p class="dim kecil">
            Sampai ke sini dari tautan di situs ini?{" "}
            <a href="/kontak" class="tl">Beri tahu kami halamannya</a> — cuma begitu kami bisa
            menemukannya.
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* ══ 404 ═══════════════════════════════════════════════════════════════
     Halaman ini muncul justru saat orang sudah salah jalan, jadi tugasnya
     satu: mengembalikan mereka ke tempat yang benar dengan cepat. Bukan
     lelucon. */
  .nf {
    display: grid;
    place-items: center;
    min-height: calc(100vh - 66px);
    padding: 60px 20px;
  }
  .nf__k {
    max-width: 640px;
    width: 100%;
    text-align: center;
  }
  .nf__n {
    font-family: var(--judul);
    font-size: clamp(4rem, 14vw, 7rem);
    line-height: 1;
    color: var(--teks-4);
    letter-spacing: -0.02em;
  }
  .nf__ket {
    max-width: 46ch;
    margin-inline: auto;
  }
  .jalan {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 1px;
    background: var(--garis);
    border: 1px solid var(--garis);
    margin-top: 36px;
    text-align: left;
  }
  .jalan a {
    display: block;
    background: var(--kanvas);
    padding: 20px 22px;
    text-decoration: none;
    transition: background 180ms var(--e-halus);
  }
  .jalan a:hover {
    background: var(--gelap);
  }
  .jalan a:focus-visible {
    outline: none;
    box-shadow: inset 0 0 0 2px var(--cincin);
  }
  .jalan b {
    display: block;
    font-family: var(--judul);
    font-size: 16px;
    color: var(--teks);
    margin-bottom: 5px;
    font-weight: 400;
  }
  .jalan span {
    font-size: 12.5px;
    color: var(--teks-3);
    line-height: 1.55;
  }
  .jalan a:hover b {
    color: var(--aksen);
  }
</style>
