---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSettings } from "../lib/api";
const settings = await getSettings();

/* Kelima keterangan ini datang dari database, diisi pemilik lewat
   /admin/halaman/privasi. Sengaja TIDAK ada nilai bawaan: halaman privasi
   yang salah berbunyi seperti janji hukum, jadi yang belum diisi ditandai apa
   adanya, bukan ditebak. */
const badanUsaha = settings.legalEntity?.trim() || null;
const alamatResmi = settings.legalAddress?.trim() || null;
const simpanPesan = settings.retentionMessages?.trim() || null;
const simpanDokumen = settings.retentionDocuments?.trim() || null;
const hukumBerlaku = settings.governingLaw?.trim() || null;
const email = settings.email?.trim() || null;
const studio = settings.studioName?.trim() || "Dirga Pahlevi Architecture";

const bagian = [
  { id: "kirim", label: "Kalau Anda mengirim sesuatu" },
  { id: "klien", label: "Kalau Anda klien kami" },
  { id: "peramban", label: "Yang disimpan peramban Anda" },
  { id: "pihak", label: "Siapa lagi yang melihatnya" },
  { id: "simpan", label: "Berapa lama kami menyimpannya" },
  { id: "tidak", label: "Yang tidak pernah kami lakukan" },
  { id: "hak", label: "Meminta kami menghapusnya" },
  { id: "siapa", label: "Siapa yang bertanggung jawab" },
];

const pihak = [
  ["Cloudflare", "Menyajikan situs dan menyimpan gambar", "Alamat IP dan peramban Anda, seperti di situs mana pun; foto proyek"],
  ["Cloudflare Turnstile", "Menahan bot di form kontak", "Sinyal bahwa Anda manusia. Bukan isi pesan Anda"],
  ["Supabase", "Basis data dan login staf", "Pesan Anda, dan semua yang ada di halaman proyek klien"],
  ["Resend", "Mengirimkan email kami", "Alamat email Anda dan pesan yang Anda kirim"],
];

const tidak = [
  ["Tanpa analitik.", "Bukan Google Analytics, bukan penggantinya. Kami betul-betul tidak tahu berapa orang membaca halaman ini."],
  ["Tanpa piksel iklan", "dan tanpa remarketing. Tidak ada yang Anda lakukan di sini mengikuti Anda ke tempat lain."],
  ["Tanpa newsletter", "dan tanpa email pemasaran. Kami membalas yang Anda kirim; itu saja seluruh suratnya."],
  ["Tidak ada yang dijual atau dibagikan", "ke pihak mana pun di luar layanan yang disebut di atas."],
];

// Kalimat yang butuh keterangan dari pemilik. Selama belum ada, kalimatnya
// TETAP ada tapi bagian yang kosong ditandai — halaman privasi yang mengarang
// angka penyimpanan berbunyi seperti janji hukum yang tidak bisa ditepati.
const belum = "belum ditetapkan";
---

<BaseLayout
  title="Privasi"
  description="Satu form kontak, satu halaman proyek untuk klien, dan tidak ada yang lain. Tanpa analitik, tanpa piksel iklan, tanpa newsletter, dan tidak ada yang dijual ke siapa pun."
>
  <div class="pita">
    <div class="dalam titik pijar">
      <span class="pijar-lapis" aria-hidden="true"></span>
      <div class="isi isi--longgar kepala">
        <span class="label">PRIVASI</span>
        <div class="s24"></div>
        <h1 class="h1 kepala__judul">Apa yang situs ini tahu tentang Anda, dengan kata-kata biasa</h1>
        <div class="s24"></div>
        <p class="lead">
          Versi pendeknya: satu form kontak, satu halaman proyek untuk klien, dan tidak ada yang
          lain. Tanpa analitik, tanpa piksel iklan, tanpa newsletter, dan tidak ada yang dijual ke
          siapa pun. Versi panjangnya ada di bawah, dan itu juga pendek.
        </p>
      </div>
    </div>
  </div>

  <div class="pita pita--akhir">
    <div class="dalam">
      <div class="baris baris-pv">
        <div class="sel rel-pv">
          <div class="rel-pv__kop"><span class="label label--redup">DI HALAMAN INI</span></div>
          <nav id="toc" aria-label="Di halaman ini">
            {
              bagian.map((b, i) => (
                <a href={`#${b.id}`} class={i === 0 ? "kat__b kini" : "kat__b"}>
                  {b.label}
                  <span class="panah-kotak" aria-hidden="true">
                    <svg width="19" height="19" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2.6" y="2.6" width="16.8" height="16.8" rx="4.6" /><path d="M9.4 7.4 13 11l-3.6 3.6" /></svg>
                  </span>
                </a>
              ))
            }
          </nav>
        </div>

        <div class="sel sel-pv">
          <div class="pv">
            <h2 id="kirim">Kalau Anda mengirim sesuatu</h2>
            <p>
              Form kontak menanyakan <strong>nama, email, nomor telepon, lokasi tapak, apa yang
              Anda bangun, rentang anggaran, dan pesan Anda</strong>. Yang wajib hanya nama, email,
              lokasi, jenis proyek, dan pesan — sisanya ada karena membuat balasan pertama kami
              lebih berguna buat Anda.
            </p>
            <p>
              Pesan itu sampai ke kami sebagai email dan disimpan di basis data kami sendiri supaya
              bisa dicari lagi. Yang membacanya dua orang yang bekerja di sini. Tidak ada orang lain
              yang membacanya.
            </p>

            <h2 id="klien">Kalau Anda klien kami</h2>
            <p>
              Halaman proyek Anda memuat apa yang proyeknya butuhkan: gambar dan dokumen yang kami
              kirim, tagihan, tahapan, brief Anda, dan utas komentarnya. Ia juga memuat
              <strong>tautan yang membukanya</strong> — tautan itulah kuncinya, dan karena itu kami
              minta ia hanya dikirim ke orang yang memang boleh melihat proyeknya.
            </p>
            <p>
              Foto bangunan Anda disimpan pada kami. Kami bertanya dulu sebelum satu pun tampil di
              situs ini, dan <strong>“tidak” adalah jawaban yang utuh</strong> — ia tidak mengubah
              apa pun tentang cara kami bekerja dengan Anda.
            </p>

            <h2 id="peramban">Yang disimpan peramban Anda</h2>
            <p>
              Tidak ada cookie pelacak, karena memang tidak ada pelacakan. Yang tersimpan tetap di
              perangkat Anda sendiri dan tidak pernah sampai ke kami:
            </p>
            <div class="tanpa">
              <i>▸</i>
              <span><b>Pilihan bahasa Anda</b> — diingat supaya halaman klien terbuka dalam bahasa yang terakhir Anda pakai.</span>
            </div>
            <div class="tanpa">
              <i>▸</i>
              <span><b>Khusus staf:</b> token login, pilihan tema terang atau gelap untuk panel studio, dan cache singkat data panel, supaya berpindah halaman admin tidak memuat ulang semuanya.</span>
            </div>
            <p class="pv__lanjut">Menghapus data peramban menghapus semuanya, dan tidak ada yang rusak.</p>

            <h2 id="pihak">Siapa lagi yang melihatnya</h2>
            <p>
              Situs ini berjalan di atas layanan pihak lain, bukan di mesin kami sendiri. Masing-masing
              hanya melihat bagian yang ia butuhkan untuk bekerja:
            </p>
            <div class="pihak-bung">
              <table class="pihak">
                <thead>
                  <tr><th>Layanan</th><th>Gunanya</th><th>Yang sampai ke sana</th></tr>
                </thead>
                <tbody>
                  {pihak.map(([a, b, c]) => (<tr><td>{a}</td><td>{b}</td><td>{c}</td></tr>))}
                </tbody>
              </table>
            </div>
            <p>
              Keempatnya dipilih karena biasa saja, bukan karena canggih. Kalau salah satunya
              berubah, halaman ini ikut berubah.
            </p>

            <h2 id="simpan">Berapa lama kami menyimpannya</h2>
            <p>
              Pesan yang tidak berlanjut jadi proyek disimpan selama{" "}
              {simpanPesan ? <strong>{simpanPesan}</strong> : <em class="belum">{belum}</em>},
              lalu dihapus. Dokumen yang terikat pada proyek yang sudah selesai — kontrak, tagihan,
              gambar — disimpan selama{" "}
              {simpanDokumen ? <strong>{simpanDokumen}</strong> : <em class="belum">{belum}</em>},
              karena itulah catatan pekerjaan yang sudah dikerjakan dan dibayar.
            </p>

            <h2 id="tidak">Yang tidak pernah kami lakukan</h2>
            {
              tidak.map(([tebal, sisa]) => (
                <div class="tanpa">
                  <i>✓</i>
                  <span><b>{tebal}</b> {sisa}</span>
                </div>
              ))
            }

            <h2 id="hak">Meminta kami menghapusnya</h2>
            <p>
              Tulis ke {email ? <a href={`mailto:${email}`}>{email}</a> : "studio"} dan sebutkan apa
              yang ingin dihapus. Kami akan menghapusnya dan memberi tahu Anda begitu selesai. Anda
              tidak perlu menyebutkan alasan, dan itu tidak memengaruhi proyek yang sedang jalan.
            </p>
            <p>
              Satu pengecualian, disebut terus terang: dokumen yang terikat pada proyek selesai kami
              simpan selama jangka waktu di atas. Selebihnya dihapus.
            </p>

            <h2 id="siapa">Siapa yang bertanggung jawab</h2>
            <p>
              Situs ini dijalankan oleh{" "}
              {badanUsaha ? <strong>{badanUsaha}</strong> : <><strong>{studio}</strong> (<em class="belum">nama badan usaha {belum}</em>)</>}
              {alamatResmi ? <>, {alamatResmi}</> : <>, <em class="belum">alamat resmi {belum}</em></>}.
              Pertanyaan soal apa pun di halaman ini dikirim ke alamat yang sama di atas.
            </p>
            <p>
              Halaman ini tunduk pada{" "}
              {hukumBerlaku ? <strong>{hukumBerlaku}</strong> : <em class="belum">{belum}</em>}.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* ══ Privasi ═════════════════════════════════════════════════════════════ */
  .pv {
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--teks-2);
  }
  .pv > p {
    margin: 0 0 18px;
    max-width: 60ch;
  }
  .pv h2 {
    font-family: var(--judul);
    font-size: 1.4rem;
    color: var(--teks);
    line-height: 1.25;
    margin: 42px 0 14px;
    scroll-margin-top: 80px;
  }
  .pv h2:first-child {
    margin-top: 0;
  }
  .pv strong {
    color: var(--teks);
    font-weight: 600;
  }
  .pv a {
    color: var(--aksen);
    text-decoration: none;
    border-bottom: 1px solid rgba(45, 212, 191, 0.4);
  }
  .pv__lanjut {
    margin-top: 18px;
  }
  /* Keterangan yang masih ditunggu dari pemilik. Ditandai jelas — halaman
     privasi berbunyi seperti janji hukum, jadi bagian yang belum pasti tidak
     boleh menyamar sebagai bagian yang sudah pasti. */
  .belum {
    color: var(--teks-3);
    font-style: italic;
  }

  /* Tabel pihak ketiga: siapa, untuk apa, dan apa yang benar-benar sampai */
  .pihak {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    margin: 20px 0 24px;
  }
  .pihak th {
    text-align: left;
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teks-3);
    font-weight: 600;
    padding: 0 14px 12px 0;
    border-bottom: 1px solid var(--garis);
  }
  .pihak td {
    padding: 15px 14px 15px 0;
    border-bottom: 1px solid var(--garis);
    vertical-align: top;
    color: var(--teks-2);
    line-height: 1.6;
  }
  .pihak tr:last-child td {
    border-bottom: 0;
  }
  .pihak td:first-child {
    color: var(--teks);
    font-weight: 600;
    white-space: nowrap;
  }
  .pihak-bung {
    overflow-x: auto;
  }

  /* Daftar "yang TIDAK kami lakukan" — bagian paling berguna di halaman ini */
  .tanpa {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 13px 0;
    border-top: 1px solid var(--garis);
  }
  .tanpa:first-child {
    border-top: 0;
  }
  .tanpa i {
    flex: none;
    width: 16px;
    height: 16px;
    margin-top: 3px;
    color: #34d399;
  }
  .tanpa span {
    font-size: 14.5px;
    color: var(--teks-2);
    line-height: 1.6;
  }
  .tanpa b {
    color: var(--teks);
    font-weight: 600;
  }

  .baris-pv {
    grid-template-columns: 270px 1fr;
  }
  .sel-pv {
    padding: 40px 44px 52px;
  }
  .rel-pv {
    padding: 0;
    position: sticky;
    top: 0;
    align-self: start;
  }
  .rel-pv__kop {
    padding: 26px 26px 16px;
  }
  .rel-pv .kat__b {
    text-decoration: none;
    letter-spacing: normal;
    text-transform: none;
    font-size: 13.5px;
    font-weight: 500;
    padding: 16px 22px 16px 26px;
  }
  .rel-pv .kat__b.kini {
    color: var(--aksen);
    background: var(--gelap);
  }
  .rel-pv .kat__b.kini .panah-kotak {
    opacity: 1;
    transform: none;
  }
  .kepala {
    padding-top: 70px;
    padding-bottom: 48px;
  }
  .kepala__judul {
    font-size: clamp(2rem, 3.9vw, 3rem);
  }

  @media (max-width: 960px) {
    .baris-pv {
      grid-template-columns: 1fr;
    }
    .baris-pv > .rel-pv {
      position: static;
      border-bottom: 1px solid var(--garis);
    }
    .sel-pv {
      padding: 28px 20px 36px;
    }
  }
</style>

<script>
  import { relSpy } from "../lib/relspy";

  (() => {
    "use strict";
    /* Rel menandai bagian yang sedang dibaca. Matematika gulir langsung,
       bukan IntersectionObserver: observer tidak bisa diandalkan pada
       lompatan gulir yang jauh. */
    const tautan = [...document.querySelectorAll<HTMLAnchorElement>("#toc a")];
    if (!tautan.length) return;
    tautan.forEach((t) =>
      t.addEventListener("click", () => {
        tautan.forEach((x) => x.classList.remove("kini"));
        t.classList.add("kini");
      }),
    );
    const bagian = tautan
      .map((a) => document.querySelector(a.getAttribute("href") || ""))
      .filter((x): x is Element => Boolean(x));
    if (!bagian.length) return;
    relSpy({ bagian, tautan });
  })();
</script>
