---
import BaseLayout from "../layouts/BaseLayout.astro";
import { listProjects, getSettings, listTeam } from "../lib/api";
import { TAHUN_BELUM } from "../lib/menunggu";

const settings = await getSettings();

/* Semuanya dari database sekarang, diurus pemilik lewat /admin/halaman.
   Dulu di-hardcode di lib/menunggu.ts, yang berarti hanya bisa diubah dengan
   menyunting repo — dan itu tidak pernah terjadi. */
const tim = await listTeam();
const bandingSebelum = settings.beforeUrl ?? null;
const bandingSesudah = settings.afterUrl ?? null;
const kota = settings.city?.trim() || "Pontianak";
const proyek = await listProjects({ limit: 200 });

// Angka studio. Tiga yang pertama adalah keputusan, bukan hitungan — nilainya
// tetap. Yang keempat dihitung dari basis data; kalau nol, ia tampil sebagai
// penanda seperti di rancangan, karena angka yang tidak bisa ditunjukkan
// halamannya bukan angka yang layak dicetak.
const angka = [
  {
    n: "2",
    label: "Orang, seluruhnya",
    ket: "Bukan jumlah yang sedang kami usahakan bertambah. Dua adalah angka saat tidak ada satu pun pekerjaan yang dioper ke orang yang belum pernah Anda temui.",
  },
  {
    n: "~7",
    label: "Percakapan per bulan",
    ket: "Yang kami ambil hanya sebagian. Mengatakan tidak lebih awal lebih murah buat Anda daripada mengetahuinya di bulan ketiga.",
  },
  {
    n: "24 h",
    label: "Waktu balasan",
    ket: "Termasuk akhir pekan. Ini satu-satunya janji yang benar-benar bisa ditepati studio seukuran ini, jadi kami menepatinya.",
  },
  {
    n: proyek.length ? String(proyek.length) : "—",
    tunggu: proyek.length === 0,
    label: "Proyek diserahkan",
    ket: proyek.length
      ? "Tiap satu punya halamannya sendiri di situs ini. Angka yang tidak bisa Anda buka bukan angka yang layak dicetak."
      : "Sengaja dikosongkan sampai jumlah sungguhannya ada di basis data. Angka yang halamannya tidak bisa kami tunjukkan bukan angka yang layak dicetak.",
  },
];

const prinsip = [
  {
    no: "01",
    judul: "Tapaknya lebih menentukan daripada kami",
    teks: "Orientasi, angin, dinding tetangga, ke mana airnya pergi bulan Maret. Kami mulai dengan mengukur apa yang sudah ada, karena rencana yang mengabaikannya akan dikoreksi oleh bangunannya sendiri — dengan mahal, belakangan.",
  },
  {
    no: "02",
    judul: "Satu aturan material per lantai",
    teks: "Sebuah lantai terbaca sebagai satu gagasan, atau terbaca sebagai katalog. Menetapkan aturannya lebih awal itulah yang menjaga anggaran sederhana tidak terlihat sederhana.",
  },
  {
    no: "03",
    judul: "Uang itu batasan desain, bukan hal tabu",
    teks: "Kami menaruh angkanya di meja sejak panggilan pertama. Desain yang tidak sanggup Anda selesaikan bukanlah desain — itu gambar.",
  },
  {
    no: "04",
    judul: "Gambar dibuat untuk tukang, bukan untuk kami",
    teks: "Kalau kontraktor harus menelepon kami untuk memahami sebuah detail, detail itu belum selesai. Kami lebih rela menghabiskan satu minggu tambahan di atas kertas daripada di lokasi.",
  },
];

// Garis waktu. Dua tonggak pertama menunggu tahun dari pemilik; dua terakhir
// diturunkan dari proyek yang benar-benar terbit, jadi tiap tahun di sini
// bisa diperiksa terhadap halaman proyeknya sendiri.
const proyekTerlama = [...proyek].sort((a, b) => (a.year ?? 9999) - (b.year ?? 9999))[0];
const garisWaktu = [
  {
    tahun: settings.foundedYear ? String(settings.foundedYear) : TAHUN_BELUM,
    tunggu: !settings.foundedYear,
    judul: "Studionya dimulai",
    teks: "Satu meja, satu meja gambar, dan keputusan untuk tetap kecil dengan sengaja.",
  },
  {
    tahun: settings.firstCommercialYear ? String(settings.firstCommercialYear) : TAHUN_BELUM,
    tunggu: !settings.firstCommercialYear,
    judul: "Proyek komersial pertama",
    teks: "Titik saat pekerjaannya berhenti jadi rumah saja, dan gambarnya harus menjawab kepada sebuah usaha, bukan cuma kepada sebuah keluarga.",
  },
  ...(proyekTerlama
    ? [
        {
          tahun: proyekTerlama.year ? String(proyekTerlama.year) : TAHUN_BELUM,
          tunggu: !proyekTerlama.year,
          judul: `${proyekTerlama.title}${proyekTerlama.location ? `, ${proyekTerlama.location}` : ""}`,
          teks: "Proyek pertama yang didokumentasikan foto demi foto di situs ini, bukan diringkas jadi satu paragraf.",
        },
      ]
    : []),
  {
    tahun: "2026",
    judul: "Halaman klien mulai tayang",
    teks: "Tahapan, gambar, dan tagihan di satu tempat. Dibuat karena menjawab “sekarang sampai mana?” lima kali seminggu adalah persoalan desain, bukan persoalan administrasi.",
  },
];

const tidak = [
  `<b>Gambar saja, tanpa pendampingan.</b> Kalau rencananya mengambil berkasnya lalu membangun tanpa kami, studio lain akan melayani Anda lebih baik dengan biaya lebih murah.`,
  `<b>Desain dalam dua minggu.</b> Konsep saja memakan waktu lebih lama dari itu begitu tapaknya diukur dengan benar. Kami lebih rela kehilangan pekerjaannya daripada menjanjikan tanggalnya.`,
  `<b>Menyalin bangunan yang Anda lihat.</b> Kami akan membaca acuannya bersama Anda dan mengambil gagasan di baliknya, tapi salinan di tapak yang berbeda berhenti bekerja sejak hari pertama.`,
  `<b>Konsep gratis untuk membandingkan studio.</b> Percakapan pertama gratis dan akan selalu begitu. Gambar tidak, untuk siapa pun.`,
];

const bandingSiap = Boolean(bandingSebelum && bandingSesudah);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    name: "The Studio",
    url: new URL("/studio", Astro.site).href,
  },
];
---

<BaseLayout
  title="Studio"
  description={`Studio arsitektur yang sengaja dibuat kecil, berkantor di ${kota}. Anda akan bertemu orang yang menggambar, bukan perantaranya.`}
  jsonLd={jsonLd}
>
  <div class="pita">
    <div class="dalam titik pijar">
      <span class="pijar-lapis" aria-hidden="true"></span>
      <div class="isi isi--longgar">
        <span class="label masuk">STUDIO</span>
        <div class="s24"></div>
        {/* Nama kotanya datang dari setelan studio, jadi judul ini tidak
             bisa jadi satu kalimat utuh di kamus — kotanya disisipkan, dan
             yang diterjemahkan potongan di sekelilingnya. */}
        <h1 class="h1 kepala__judul">
          <span class="brs"><i><span>Studio kecil di</span> {kota}</i></span>
          <span class="brs"><i>yang lebih suka <span class="ak">menunjukkan karyanya</span></i></span>
          <span class="brs"><i>daripada menjelaskannya.</i></span>
        </h1>
        <div class="s24"></div>
        <p class="lead masuk masuk--3">Kami memang sengaja kecil. Itu bukan kerendahan hati — itu cara supaya orang yang menggambar bangunan Anda tetap orang yang membalas pesan Anda. Semua yang di bawah ini adalah apa artinya itu dalam praktik, termasuk bagian yang merepotkan kami sendiri.</p>
      </div>
    </div>
  </div>

  <div class="pita">
    <div class="dalam">
      <div class="baris b4">
        {
          angka.map((a, i) => (
            <div class="sel fak">
              <span class={a.tunggu ? "fak__n fak__n--tunggu" : "fak__n"}>{a.n}</span>
              <div class="fak__l">{a.label}</div>
              <p class="fak__k">{a.ket}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="pita">
    <div class="dalam">
      <div class="baris baris-studio">
        <div class="sel sel-teks">
          <span class="label">CARA KAMI BEKERJA</span>
          <div class="s16"></div>
          <h2 class="h2">Anda tidak perlu bertanya proyeknya sampai mana.</h2>
          <div class="s16"></div>
          <p class="mut">Sebagian besar kecemasan dalam proyek bangunan bukan soal desain, melainkan soal tidak tahu. Sekarang di tahap mana, apa yang diputuskan minggu lalu, sudah terbayar berapa, apa hal berikutnya yang menunggu saya.</p>
          <div class="s16"></div>
          <p class="mut">Karena itu tiap klien mendapat satu halaman. Tahapan, gambar, tagihan, dan seluruh percakapannya tinggal di sana. Ia diperbarui saat kami memperbaruinya, bukan saat Anda bertanya. Tidak perlu kata sandi dan tidak perlu aplikasi — tautan yang kami kirim itulah loginnya.</p>
          <div class="s24"></div>
          <a class="btn" href="/progres">Lihat cara halaman klien bekerja <span class="ar">→</span></a>
        </div>
        <div class="sel sel-ba">
          <div class="ba" id="ba">
            {/* Dua sisi pembanding. Selama fotonya belum ada, keduanya tampil
                sebagai slot berpola yang jelas berbeda, supaya penggesernya
                tetap terbaca bekerja. */}
            <div class={bandingSiap ? "ba__b" : "ba__b ba__b--built"}>
              {bandingSesudah ? (
                <img src={bandingSesudah} alt="Tapak setelah dibangun" />
              ) : (
                <span>
                  <span>FOTO — SUDAH DIBANGUN</span>
                  <small>menunggu foto dari studio</small>
                </span>
              )}
            </div>
            <div class={bandingSiap ? "ba__b ba__sebelum" : "ba__b ba__sebelum ba__b--found"} id="baSebelum">
              {bandingSebelum ? (
                <img src={bandingSebelum} alt="Tapak seperti saat ditemukan" />
              ) : (
                <span>
                  <span>FOTO — TAPAK APA ADANYA</span>
                  <small>menunggu foto dari studio</small>
                </span>
              )}
            </div>
            <span class="ba__tag ba__tag--kiri">APA ADANYA</span>
            <span class="ba__tag ba__tag--kanan">SUDAH DIBANGUN</span>
            <div class="ba__garis" id="baGaris"></div>
            <button class="ba__pegang" id="baPegang" role="slider" aria-label="Bandingkan sebelum dan sesudah"
              aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" tabindex="0">
              <svg width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 5 3.5 10 8 15M12 5l4.5 5-4.5 5" /></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="pita">
    <div class="dalam">
      <div class="isi isi--rapat">
        <span class="label">APA YANG KAMI YAKINI</span>
        <div class="s16"></div>
        <h2 class="h2">Empat sikap yang tidak kami tawar.</h2>
      </div>
      <div class="baris b2">
        {
          [prinsip.slice(0, 2), prinsip.slice(2)].map((kolom) => (
            <div class="sel">
              {kolom.map((p) => (
                <div class="prin">
                  <span class="prin__n">{p.no}</span>
                  <div>
                    <h3>{p.judul}</h3>
                    <p>{p.teks}</p>
                  </div>
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="pita">
    <div class="dalam">
      {/* Kepala seksi sengaja HANYA judul — tanpa eyebrow, tanpa paragraf
          pengantar. Acuan pemilik (refine.dev/about) memang begitu, dan ia
          memintanya eksplisit: "hanya nama dan jabatan, tidak perlu ada
          text lain". */}
      <div class="isi isi--rapat tim-kop">
        <h2 class="h2">Tim kami</h2>
      </div>
      <div class="tim-rel">
        {
          tim.map((o) => (
            <div class="tim">
              {/* Potret disajikan DUA kali dalam satu kotak: <img> sungguhan
                  di bawah, dan lapisan halftone teal di atasnya sebagai
                  background pseudo-elemen. Yang memudar saat disentuh kursor
                  cuma lapisan atasnya — memudarkan `mask-image` langsung
                  tidak bisa, nilainya tidak bisa diinterpolasi, dan hasilnya
                  bukan pudar melainkan lompat.

                  URL-nya dititipkan sebagai custom property karena
                  pseudo-elemen tidak bisa membaca atribut src. */}
              <div class={o.photoUrl ? "tim__foto" : "tim__foto tim__foto--kosong"}
                style={o.photoUrl ? `--foto:url("${o.photoUrl}")` : undefined}>
                {o.photoUrl ? (
                  <img src={o.photoUrl} alt={o.name ?? o.role} loading="lazy" decoding="async" />
                ) : (
                  <span>
                    FOTO — {o.slotLabel}
                    <small>potret 4:5</small>
                  </span>
                )}
              </div>
              <div class="tim__isi">
                <div class={o.name ? "tim__nm" : "tim__nm tunggu"}>{o.name ?? "Nama menyusul"}</div>
                <div class="tim__pr">{o.role}</div>
              </div>
            </div>
          ))
        }
      </div>
      <div class="baris">
        <div class="sel tim-catatan">
          <span class="kotak-ikon">
            <svg width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M10 4v12M4 10h12" /></svg>
          </span>
          <div>
            <div class="tim__nm">Selebihnya masuk per proyek</div>
            <p class="tim__ket tim__ket--lebar">Ahli struktur, MEP, perender, dan fotografer disewa per proyek dan dicantumkan di kredit proyek itu — bukan didaftar di sini seolah mereka duduk di ruangan ini. Anda akan tahu siapa yang menyentuh gambar Anda.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="pita">
    <div class="dalam">
      <div class="baris baris-studio">
        <div class="sel sel-teks">
          <span class="label">BAGAIMANA JALANNYA</span>
          <div class="s16"></div>
          <h2 class="h2">Versi singkatnya.</h2>
          <div class="s16"></div>
          <p class="mut">Ditulis apa adanya, bukan sebagai kisah pertumbuhan. Apa pun yang bertahun di sini seharusnya bisa diperiksa terhadap halaman proyeknya di situs ini.</p>
        </div>
        <div class="sel sel-teks">
          {
            garisWaktu.map((t, i) => (
              <div class="thn">
                <span class="thn__d"></span>
                <span class="thn__g"></span>
                <span class={t.tunggu ? "thn__t thn__t--tunggu" : "thn__t"}>{t.tahun}</span>
                {/* Tonggak ketiga judulnya nama proyek dari database, jadi
                     ia sengaja TIDAK diberi data-t — nama karya tidak
                     diterjemahkan. */}
                <div>
                  <h3>{t.judul}</h3>
                  <p>{t.teks}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <div class="pita">
    <div class="dalam">
      <div class="baris baris-studio">
        <div class="sel sel-teks">
          <span class="label">JUJURNYA</span>
          <div class="s16"></div>
          <h2 class="h2">Hal-hal yang membuat kami bukan studio yang tepat.</h2>
          <div class="s16"></div>
          <p class="mut">Membaca daftar ini memakan dua menit. Mengetahui hal yang sama di bulan ketiga jauh lebih mahal.</p>
        </div>
        <div class="sel sel-teks">
          {
            tidak.map((baris) => (
              <div class="tidak">
                <i class="kotak-ikon kotak-ikon--kecil kotak-ikon--redup">
                  <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 4l8 8M12 4l-8 8" /></svg>
                </i>
                <span set:html={baris} />
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <div class="pita pita--akhir">
    <div class="dalam titik">
      <div class="isi isi--longgar ajak">
        <h2 class="h2">Masih merasa kami studio yang tepat?</h2>
        <div class="s16"></div>
        <p class="mut ajak__lead">Ceritakan tapaknya dan anggarannya. Kalau kami bukan yang cocok, kami akan mengatakannya di balasan pertama, dan menunjukkan tempat yang lebih baik.</p>
        <div class="s24"></div>
        <div class="rowx ajak__tombol">
          <a class="btn btn--isi" href="/kontak">Mulai proyek →</a>
          <a class="btn" href="/proyek">Lihat karyanya <span class="ar">→</span></a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* ── Dari blok CSS khusus halaman di mockup yang di-ACC ──────────────── */

  /* Kartu orang TEGAK: potret besar di atas, nama dan peran di bawah —
     acuan baru dari pemilik. Menggantikan kartu mendatar 190px yang
     sebelumnya dipilih untuk menghemat tinggi pita.

     auto-fit, bukan tiga kolom tetap: studio ini dua orang, dan grid tiga
     kolom akan meninggalkan satu lubang di sebelah kanan. Dengan auto-fit ia
     jadi dua kolom sekarang dan tiga begitu orang ketiga ditambahkan lewat
     /admin, tanpa menyentuh CSS lagi. */
  .tim-kop {
    padding-bottom: 30px;
  }
  .tim-rel {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    border-top: 1px solid var(--garis);
    border-bottom: 1px solid var(--garis);
  }
  /* Penanda silang di sudut rel, sama bahasa visualnya dengan .dalam. */
  .tim-rel::before,
  .tim-rel::after {
    content: "";
    position: absolute;
    width: 9px;
    height: 9px;
    border: 1px solid var(--garis-2);
    pointer-events: none;
  }
  .tim-rel::before {
    left: -5px;
    top: -5px;
    border-right: 0;
    border-bottom: 0;
  }
  .tim-rel::after {
    right: -5px;
    bottom: -5px;
    border-left: 0;
    border-top: 0;
  }
  .tim {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 34px 30px 36px;
    border-left: 1px solid var(--garis);
  }
  .tim:first-child {
    border-left: 0;
  }
  /* Penanda silang di ujung atas dan bawah tiap garis pemisah kolom, persis
     acuan pemilik. Digambar dengan dua gradien linear di satu kotak 9x9 —
     satu batang tegak, satu batang mendatar — bukan dua pseudo-elemen
     bersarang, karena tiap kartu cuma punya dua pseudo-elemen dan keduanya
     sudah terpakai untuk ujung atas dan ujung bawah. */
  .tim:not(:first-child)::before,
  .tim:not(:first-child)::after {
    content: "";
    position: absolute;
    left: -5px;
    width: 9px;
    height: 9px;
    pointer-events: none;
    background-image:
      linear-gradient(var(--garis-2), var(--garis-2)),
      linear-gradient(var(--garis-2), var(--garis-2));
    background-size: 1px 9px, 9px 1px;
    background-position: center, center;
    background-repeat: no-repeat;
  }
  .tim:not(:first-child)::before {
    top: -5px;
  }
  .tim:not(:first-child)::after {
    bottom: -5px;
  }
  /* Potret 4:5, bukan persegi — acuan pemilik memakai potret tegak, dan
     wajah yang dipotong persegi kehilangan bahu dan jadi terbaca sebagai
     foto identitas. */
  .tim__foto {
    position: relative;
    width: 100%;
    aspect-ratio: 4/5;
    background: var(--gelap);
    display: grid;
    place-items: center;
    color: #4b4b52;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-align: center;
    padding: 12px;
    overflow: hidden;
  }
  .tim__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Abu-abu, sama seperti foto yang tampil saat disentuh di acuan. */
    filter: grayscale(1) contrast(1.06);
  }
  /* Lapisan halftone. sepia+hue-rotate+saturate adalah cara membuat duotone
     satu warna dari gambar apa pun tanpa menyiapkan aset terpisah; maskernya
     memotongnya jadi kisi titik 3px. */
  .tim__foto::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image: var(--foto);
    background-size: cover;
    background-position: center;
    filter: grayscale(1) contrast(1.15) sepia(1) hue-rotate(122deg) saturate(4.2) brightness(0.92);
    -webkit-mask-image: radial-gradient(circle at center, #000 40%, transparent 42%);
    mask-image: radial-gradient(circle at center, #000 40%, transparent 42%);
    -webkit-mask-size: 3px 3px;
    mask-size: 3px 3px;
    transition: opacity 340ms var(--e-halus);
    pointer-events: none;
  }
  /* Tanpa foto, tidak ada yang perlu di-halftone — dan var(--foto) yang
     kosong membuat lapisannya jadi kotak hitam menutupi teks penantinya. */
  .tim__foto--kosong::before {
    content: none;
  }
  @media (hover: hover) {
    .tim:hover .tim__foto::before,
    .tim:focus-within .tim__foto::before {
      opacity: 0;
    }
  }
  /* Layar sentuh tidak punya hover sama sekali. Tanpa aturan ini, pengunjung
     dari ponsel — yang jumlahnya paling banyak — tidak pernah melihat satu
     pun wajah. Jebakan #9 di CLAUDE.md versi diamnya: bukan keadaan yang
     nyangkut, melainkan keadaan yang tidak pernah tercapai. */
  @media (hover: none) {
    .tim__foto::before {
      opacity: 0;
    }
  }
  .tim__foto--kosong {
    background: repeating-linear-gradient(45deg, #1c1c20 0 6px, #161619 6px 12px);
  }
  .tim__foto small,
  .ba__b small {
    display: block;
    margin-top: 6px;
    letter-spacing: 0.06em;
    text-transform: none;
