---
import BaseLayout from "../layouts/BaseLayout.astro";
import { listProjects, getSettings, listTeam } from "../lib/api";
import { TAHUN_BELUM } from "../lib/menunggu";
import { KAMUS_STUDIO } from "../lib/i18nHalaman";

const settings = await getSettings();

/* Semuanya dari database sekarang, diurus pemilik lewat /admin/halaman.
   Dulu di-hardcode di lib/menunggu.ts, yang berarti hanya bisa diubah dengan
   menyunting repo — dan itu tidak pernah terjadi. */
const tim = await listTeam();
const bandingSebelum = settings.beforeUrl ?? null;
const bandingSesudah = settings.afterUrl ?? null;
const kota = settings.city?.trim() || "Pontianak";
const proyek = await listProjects({ limit: 200 });

// Angka studio. Tiga yang pertama adalah keputusan, bukan hitungan — nilainya
// tetap. Yang keempat dihitung dari basis data; kalau nol, ia tampil sebagai
// penanda seperti di rancangan, karena angka yang tidak bisa ditunjukkan
// halamannya bukan angka yang layak dicetak.
const angka = [
  {
    n: "2",
    label: "People, total",
    ket: "Not a headcount we are working to grow. Two is the number where nothing gets handed to someone you never met.",
  },
  {
    n: "~7",
    label: "Conversations a month",
    ket: "We take a fraction of them. Saying no early is cheaper for you than finding out in month three.",
  },
  {
    n: "24 h",
    label: "Reply time",
    ket: "Weekends included. It is the one promise a studio this size can actually keep, so we keep it.",
  },
  {
    n: proyek.length ? String(proyek.length) : "—",
    tunggu: proyek.length === 0,
    label: "Projects delivered",
    ket: proyek.length
      ? "Every one of them has a page on this site. A number you cannot open is not a number worth printing."
      : "Left blank on purpose until the real count is in the database. A number we cannot show you a page for is not a number worth printing.",
  },
];

const prinsip = [
  {
    no: "01",
    judul: "The site decides more than we do",
    teks: "Orientation, wind, the neighbour’s wall, where the water goes in March. We start by measuring what is already there, because a plan that ignores it will be corrected by the building itself — expensively, later.",
  },
  {
    no: "02",
    judul: "One material rule per level",
    teks: "A floor reads as one idea, or it reads as a catalogue. Deciding the rule early is what keeps a modest budget from looking modest.",
  },
  {
    no: "03",
    judul: "Money is a design constraint, not a taboo",
    teks: "We put the number on the table in the first call. A design you cannot afford to finish is not a design — it is a drawing.",
  },
  {
    no: "04",
    judul: "Drawings are for builders, not for us",
    teks: "If the contractor has to call us to understand a detail, the detail was not finished. We would rather spend the extra week on paper than on site.",
  },
];

// Garis waktu. Dua tonggak pertama menunggu tahun dari pemilik; dua terakhir
// diturunkan dari proyek yang benar-benar terbit, jadi tiap tahun di sini
// bisa diperiksa terhadap halaman proyeknya sendiri.
const proyekTerlama = [...proyek].sort((a, b) => (a.year ?? 9999) - (b.year ?? 9999))[0];
const garisWaktu = [
  {
    tahun: settings.foundedYear ? String(settings.foundedYear) : TAHUN_BELUM,
    tunggu: !settings.foundedYear,
    judul: "The studio starts",
    teks: "One desk, one drawing table, and the decision to stay small on purpose.",
  },
  {
    tahun: settings.firstCommercialYear ? String(settings.firstCommercialYear) : TAHUN_BELUM,
    tunggu: !settings.firstCommercialYear,
    judul: "First commercial project",
    teks: "The point where the work stopped being houses only and the drawings had to answer to a business as well as a family.",
  },
  ...(proyekTerlama
    ? [
        {
          tahun: proyekTerlama.year ? String(proyekTerlama.year) : TAHUN_BELUM,
          tunggu: !proyekTerlama.year,
          judul: `${proyekTerlama.title}${proyekTerlama.location ? `, ${proyekTerlama.location}` : ""}`,
          teks: "The first project documented photograph by photograph on this site rather than summarised in a paragraph.",
        },
      ]
    : []),
  {
    tahun: "2026",
    judul: "The client page goes live",
    teks: "Phases, drawings and invoices in one place. Built because answering “where are we?” five times a week is a design problem, not an admin one.",
  },
];

const tidak = [
  ["Drawings only, no involvement.", "If the plan is to take the file and build it without us, another studio will serve you better and charge you less."],
  ["A design in two weeks.", "Concept alone takes longer than that once the site has been measured properly. We would rather lose the job than promise the date."],
  ["Copying a building you saw.", "We will read the reference with you and take the idea underneath it, but a copy on a different site stops working on day one."],
  ["Free concepts to compare studios.", "The first conversation is free and always will be. Drawings are not, for anyone."],
];

const bandingSiap = Boolean(bandingSebelum && bandingSesudah);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "AboutPage",
    name: "The Studio",
    url: new URL("/studio", Astro.site).href,
  },
];
---

<BaseLayout
  title="The Studio"
  description={`A deliberately small architecture studio in ${kota}, Indonesia. Two people, and you will meet both.`}
  jsonLd={jsonLd}
>
  <div class="pita">
    <div class="dalam titik pijar">
      <span class="pijar-lapis" aria-hidden="true"></span>
      <div class="isi isi--longgar">
        <span class="label masuk" data-t="stuLabel">STUDIO</span>
        <div class="s24"></div>
        {/* Nama kotanya datang dari setelan studio, jadi judul ini tidak
             bisa jadi satu kalimat utuh di kamus — kotanya disisipkan, dan
             yang diterjemahkan potongan di sekelilingnya. */}
        <h1 class="h1 kepala__judul">
          <span class="brs"><i><span data-t="stuJudul1">A small studio in</span> {kota}</i></span>
          <span class="brs"><i data-t="stuJudul2">that would rather <span class="ak">show you the work</span></i></span>
          <span class="brs"><i data-t="stuJudul3">than describe it.</i></span>
        </h1>
        <div class="s24"></div>
        <p class="lead masuk masuk--3" data-t="stuLead">
          We are deliberately small. That is not modesty — it is how the person who draws your
          building stays the person who answers your messages. Everything below is what that
          actually means in practice, including the parts that are inconvenient for us.
        </p>
      </div>
    </div>
  </div>

  <div class="pita">
    <div class="dalam">
      <div class="baris b4">
        {
          angka.map((a, i) => (
            <div class="sel fak">
              <span class={a.tunggu ? "fak__n fak__n--tunggu" : "fak__n"}>{a.n}</span>
              <div class="fak__l" data-t={`stuAngka${i}L`}>{a.label}</div>
              <p class="fak__k" data-t={`stuAngka${i}K`}>{a.ket}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="pita">
    <div class="dalam">
      <div class="baris baris-studio">
        <div class="sel sel-teks">
          <span class="label" data-t="stuKerja">HOW WE WORK</span>
          <div class="s16"></div>
          <h2 class="h2" data-t="stuKerjaJudul">You do not have to ask where the project is.</h2>
          <div class="s16"></div>
          <p class="mut" data-t="stuKerjaP1">
            Most of the anxiety in a building project is not about design. It is about not knowing.
            Which stage are we in, what was decided last week, how much has been paid, what is the
            next thing waiting on me.
          </p>
          <div class="s16"></div>
          <p class="mut" data-t="stuKerjaP2">
            So every client gets a page. Phases, drawings, invoices, and the comments thread all
            live there. It updates when we update it, not when you ask. It needs no password and no
            app — the link we send you is the login.
          </p>
          <div class="s24"></div>
          <a class="btn" href="/progres" data-t="stuLihatPortal">See how the client page works <span class="ar">→</span></a>
        </div>
        <div class="sel sel-ba">
          <div class="ba" id="ba">
            {/* Dua sisi pembanding. Selama fotonya belum ada, keduanya tampil
                sebagai slot berpola yang jelas berbeda, supaya penggesernya
                tetap terbaca bekerja. */}
            <div class={bandingSiap ? "ba__b" : "ba__b ba__b--built"}>
              {bandingSesudah ? (
                <img src={bandingSesudah} alt="The site after construction" />
              ) : (
                <span>
                  <span data-t="stuFotoJadi">PHOTO — BUILT</span>
                  <small data-t="stuFotoTunggu">waiting for the studio’s photograph</small>
                </span>
              )}
            </div>
            <div class={bandingSiap ? "ba__b ba__sebelum" : "ba__b ba__sebelum ba__b--found"} id="baSebelum">
              {bandingSebelum ? (
                <img src={bandingSebelum} alt="The site as found" />
              ) : (
                <span>
                  <span data-t="stuFotoAwal">PHOTO — SITE AS FOUND</span>
                  <small data-t="stuFotoTunggu">waiting for the studio’s photograph</small>
                </span>
              )}
            </div>
            <span class="ba__tag ba__tag--kiri" data-t="stuTagAwal">AS FOUND</span>
            <span class="ba__tag ba__tag--kanan" data-t="stuTagJadi">BUILT</span>
            <div class="ba__garis" id="baGaris"></div>
            <button class="ba__pegang" id="baPegang" role="slider" aria-label="Compare before and after"
              aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" tabindex="0">
              <svg width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 5 3.5 10 8 15M12 5l4.5 5-4.5 5" /></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="pita">
    <div class="dalam">
      <div class="isi isi--rapat">
        <span class="label" data-t="stuYakin">WHAT WE BELIEVE</span>
        <div class="s16"></div>
        <h2 class="h2" data-t="stuYakinJudul">Four positions we do not negotiate.</h2>
      </div>
      <div class="baris b2">
        {
          [prinsip.slice(0, 2), prinsip.slice(2)].map((kolom) => (
            <div class="sel">
              {kolom.map((p) => (
                <div class="prin">
                  <span class="prin__n">{p.no}</span>
                  <div>
                    <h3 data-t={`stuPrinsip${p.no}J`}>{p.judul}</h3>
                    <p data-t={`stuPrinsip${p.no}T`}>{p.teks}</p>
                  </div>
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="pita">
    <div class="dalam">
      <div class="isi isi--rapat">
        <span class="label" data-t="stuTim">OUR TEAM</span>
        <div class="s16"></div>
        <h2 class="h2" data-t="stuTimJudul">Two people, and you will meet both.</h2>
        <div class="s16"></div>
        <p class="mut tim__intro" data-t="stuTimLead">
          There is no account manager between you and the person drawing. The same two names appear
          on the first call, on the drawings, and on the message you send at nine on a Sunday.
        </p>
      </div>
      <div class="tim-rel">
        {
          tim.map((o) => (
            <div class="tim">
              {/* Potret disajikan DUA kali dalam satu kotak: <img> sungguhan
                  di bawah, dan lapisan halftone teal di atasnya sebagai
                  background pseudo-elemen. Yang memudar saat disentuh kursor
                  cuma lapisan atasnya — memudarkan `mask-image` langsung
                  tidak bisa, nilainya tidak bisa diinterpolasi, dan hasilnya
                  bukan pudar melainkan lompat.

                  URL-nya dititipkan sebagai custom property karena
                  pseudo-elemen tidak bisa membaca atribut src. */}
              <div class={o.photoUrl ? "tim__foto" : "tim__foto tim__foto--kosong"}
                style={o.photoUrl ? `--foto:url("${o.photoUrl}")` : undefined}>
                {o.photoUrl ? (
                  <img src={o.photoUrl} alt={o.name ?? o.role} loading="lazy" decoding="async" />
                ) : (
                  <span>
                    PHOTO — {o.slotLabel}
                    <small data-t="stuPotret">portrait 4:5</small>
                  </span>
                )}
              </div>
              <div class="tim__isi">
                <div class={o.name ? "tim__nm" : "tim__nm tunggu"}>{o.name ?? "Name to follow"}</div>
                <div class={o.name ? "tim__pr" : "tim__pr tim__pr--tunggu"}>{o.role}</div>
                {o.bio && <p class="tim__ket">{o.bio}</p>}
              </div>
            </div>
          ))
        }
      </div>
      <div class="baris">
        <div class="sel tim-catatan">
          <span class="kotak-ikon">
            <svg width="17" height="17" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M10 4v12M4 10h12" /></svg>
          </span>
          <div>
            <div class="tim__nm" data-t="stuLainnya">Everyone else comes in by project</div>
            <p class="tim__ket tim__ket--lebar" data-t="stuLainnyaKet">
              Structural engineers, MEP, renderers and a photographer are hired per project and
              named in that project’s credits — not listed here as if they sat in this room. You
              will know who touched your drawings.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="pita">
    <div class="dalam">
      <div class="baris baris-studio">
        <div class="sel sel-teks">
          <span class="label" data-t="stuRiwayat">HOW IT WENT</span>
          <div class="s16"></div>
          <h2 class="h2" data-t="stuRiwayatJudul">The short version.</h2>
          <div class="s16"></div>
          <p class="mut" data-t="stuRiwayatLead">
            Written as it happened, not as a growth story. Anything with a year on it should be
            checkable against a project page on this site.
          </p>
        </div>
        <div class="sel sel-teks">
          {
            garisWaktu.map((t, i) => (
              <div class="thn">
                <span class="thn__d"></span>
                <span class="thn__g"></span>
                <span class={t.tunggu ? "thn__t thn__t--tunggu" : "thn__t"}>{t.tahun}</span>
                {/* Tonggak ketiga judulnya nama proyek dari database, jadi
                     ia sengaja TIDAK diberi data-t — nama karya tidak
                     diterjemahkan. */}
                <div>
                  <h3 data-t={i === 2 ? undefined : `stuTonggak${i}J`}>{t.judul}</h3>
                  <p data-t={`stuTonggak${i}T`}>{t.teks}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <div class="pita">
    <div class="dalam">
      <div class="baris baris-studio">
        <div class="sel sel-teks">
          <span class="label" data-t="stuJujur">HONESTLY</span>
          <div class="s16"></div>
          <h2 class="h2" data-t="stuJujurJudul">Things we are not the right studio for.</h2>
          <div class="s16"></div>
          <p class="mut" data-t="stuJujurLead">
            Reading this list costs you two minutes. Finding out the same thing in month three costs
            considerably more.
          </p>
        </div>
        <div class="sel sel-teks">
          {
            tidak.map(([judul, teks], i) => (
              <div class="tidak">
                <i class="kotak-ikon kotak-ikon--kecil kotak-ikon--redup">
                  <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 4l8 8M12 4l-8 8" /></svg>
                </i>
                <span data-t={`stuTidak${i}`}>
                  <b>{judul}</b> {teks}
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  <div class="pita pita--akhir">
    <div class="dalam titik">
      <div class="isi isi--longgar ajak">
        <h2 class="h2" data-t="stuAjakJudul">Still the right studio for you?</h2>
        <div class="s16"></div>
        <p class="mut ajak__lead" data-t="stuAjakLead">
          Tell us the site and the budget. If we are not the right fit we will say so in the first
          reply, and point you somewhere better.
        </p>
        <div class="s24"></div>
        <div class="rowx ajak__tombol">
          <a class="btn btn--isi" href="/kontak" data-t="mulaiProyekPanah">Start a project <span class="ar">→</span></a>
          <a class="btn" href="/proyek" data-t="stuLihatKarya">See the work <span class="ar">→</span></a>
        </div>
      </div>
    </div>
  </div>
  <script type="application/json" id="kamus-halaman" set:html={JSON.stringify(KAMUS_STUDIO)} is:inline />
</BaseLayout>

<style>
  /* ── Dari blok CSS khusus halaman di mockup yang di-ACC ──────────────── */

  /* Kartu orang TEGAK: potret besar di atas, nama dan peran di bawah —
     acuan baru dari pemilik. Menggantikan kartu mendatar 190px yang
     sebelumnya dipilih untuk menghemat tinggi pita.

     auto-fit, bukan tiga kolom tetap: studio ini dua orang, dan grid tiga
     kolom akan meninggalkan satu lubang di sebelah kanan. Dengan auto-fit ia
     jadi dua kolom sekarang dan tiga begitu orang ketiga ditambahkan lewat
     /admin, tanpa menyentuh CSS lagi. */
  .tim-rel {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  /* Penanda silang di sudut rel, sama bahasa visualnya dengan .dalam. */
  .tim-rel::before,
  .tim-rel::after {
    content: "";
    position: absolute;
    width: 9px;
    height: 9px;
    border: 1px solid var(--garis-2);
    pointer-events: none;
  }
  .tim-rel::before {
    left: -5px;
    top: -5px;
    border-right: 0;
    border-bottom: 0;
  }
  .tim-rel::after {
    right: -5px;
    bottom: -5px;
    border-left: 0;
    border-top: 0;
  }
  .tim {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 26px 26px 28px;
    border-left: 1px solid var(--garis);
  }
  .tim:first-child {
    border-left: 0;
  }
  .tim__foto {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    background: var(--gelap);
    display: grid;
    place-items: center;
    color: #4b4b52;
    font-size: 10px;
    letter-spacing: 0.14em;
    text-align: center;
    padding: 12px;
    overflow: hidden;
  }
  .tim__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Abu-abu, sama seperti foto yang tampil saat disentuh di acuan. */
    filter: grayscale(1) contrast(1.06);
  }
  /* Lapisan halftone. sepia+hue-rotate+saturate adalah cara membuat duotone
     satu warna dari gambar apa pun tanpa menyiapkan aset terpisah; maskernya
     memotongnya jadi kisi titik 3px. */
  .tim__foto::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image: var(--foto);
    background-size: cover;
    background-position: center;
    filter: grayscale(1) contrast(1.15) sepia(1) hue-rotate(122deg) saturate(4.2) brightness(0.92);
    -webkit-mask-image: radial-gradient(circle at center, #000 40%, transparent 42%);
    mask-image: radial-gradient(circle at center, #000 40%, transparent 42%);
    -webkit-mask-size: 3px 3px;
    mask-size: 3px 3px;
    transition: opacity 340ms var(--e-halus);
    pointer-events: none;
  }
  /* Tanpa foto, tidak ada yang perlu di-halftone — dan var(--foto) yang
     kosong membuat lapisannya jadi kotak hitam menutupi teks penantinya. */
  .tim__foto--kosong::before {
    content: none;
  }
  @media (hover: hover) {
    .tim:hover .tim__foto::before,
    .tim:focus-within .tim__foto::before {
      opacity: 0;
    }
  }
  /* Layar sentuh tidak punya hover sama sekali. Tanpa aturan ini, pengunjung
     dari ponsel — yang jumlahnya paling banyak — tidak pernah melihat satu
     pun wajah. Jebakan #9 di CLAUDE.md versi diamnya: bukan keadaan yang
     nyangkut, melainkan keadaan yang tidak pernah tercapai. */
  @media (hover: none) {
    .tim__foto::before {
      opacity: 0;
    }
  }
  .tim__foto--kosong {
    background: repeating-linear-gradient(45deg, #1c1c20 0 6px, #161619 6px 12px);
  }
  .tim__foto small,
  .ba__b small {
    display: block;
    margin-top: 6px;
    letter-spacing: 0.06em;
    text-transform: none;
    opacity: 0.6;
  }
  .tim-catatan {
    display: flex;
    gap: 18px;
    align-items: flex-start;
    padding: 26px 32px;
  }
  /* Teks pengganti di lapisan pembanding: satu saja, jangan dua yang terpotong
     di tengah oleh garis pemisah. */
  .ba__sebelum span {
    display: none;
  }
  .tim__isi {
    padding: 18px 0 0;
  }
  .tim__nm {
    font-family: var(--judul);
    font-size: 17px;
    font-weight: 600;
    color: var(--teks);
  }
  .tim__pr {
    font-size: 12px;
    color: var(--aksen);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-top: 5px;
    font-weight: 600;
  }
  .tim__pr--tunggu {
    color: var(--teks-3);
  }
  .tim__ket {
    margin-top: 10px;
    font-size: 13px;
    color: var(--teks-2);
    line-height: 1.6;
  }
  .tim__ket--lebar {
    max-width: 74ch;
  }
  .tim__intro {
    max-width: 62ch;
  }

  /* Angka studio. Hanya yang bisa dibuktikan; sisanya bertanda tunggu. */
  .fak {
    padding: 26px 24px;
  }
  .fak__n {
    font-family: var(--judul);
    font-size: 34px;
    color: var(--teks);
    line-height: 1;
  }
  .fak__n--tunggu {
    color: var(--teks-3);
  }
  .fak__l {
    margin-top: 10px;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teks-3);
  }
  .fak__k {
    margin-top: 8px;
    font-size: 12.5px;
    color: var(--teks-2);
    line-height: 1.55;
  }

