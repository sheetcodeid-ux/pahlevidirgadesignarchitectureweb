</style>

<script>
  (() => {
    "use strict";

    /* Muncul saat digulir — SATU ARAH, tidak pernah disembunyikan lagi saat naik */
    if (window.IntersectionObserver) {
      const io = new IntersectionObserver(
        (e) =>
          e.forEach((x) => {
            if (x.isIntersecting) {
              x.target.classList.add("tampil");
              io.unobserve(x.target);
            }
          }),
        { rootMargin: "0px 0px -8% 0px" },
      );
      document.querySelectorAll(".rv").forEach((n) => io.observe(n));
    }

    /* ── Pembanding sebelum/sesudah ─────────────────────────────────────────
       Dipakai keyboard juga: panah kiri/kanan menggeser 4%, Home/End ke ujung. */
    const ba = document.getElementById("ba");
    const pegang = document.getElementById("baPegang");
    if (!ba || !pegang) return;
    let pos = 50;
    /* Satu variabel saja: clip-path, garis, dan pegangan semuanya membaca --pos
       dari CSS sistem. Menyalinnya sebagai tiga gaya inline berarti tiga tempat
       yang bisa lepas sendiri-sendiri. */
    const pasang = (p: number) => {
      pos = Math.max(0, Math.min(100, p));
      ba.style.setProperty("--pos", pos + "%");
      pegang.setAttribute("aria-valuenow", String(Math.round(pos)));
    };
    pasang(50);
    const dariX = (x: number) => {
      const r = ba.getBoundingClientRect();
      return ((x - r.left) / r.width) * 100;
    };
    let seret = false;
    ba.addEventListener("pointerdown", (e) => {
      seret = true;
      ba.setPointerCapture(e.pointerId);
      pasang(dariX(e.clientX));
    });
    ba.addEventListener("pointermove", (e) => {
      if (seret) pasang(dariX(e.clientX));
    });
    const lepas = () => {
      seret = false;
    };
    ba.addEventListener("pointerup", lepas);
    ba.addEventListener("pointercancel", lepas);
    pegang.addEventListener("keydown", (e) => {
      const k = e.key;
      if (k === "ArrowLeft") pasang(pos - 4);
      else if (k === "ArrowRight") pasang(pos + 4);
      else if (k === "Home") pasang(0);
      else if (k === "End") pasang(100);
      else return;
      e.preventDefault();
    });
  })();
</script>
