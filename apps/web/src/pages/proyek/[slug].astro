---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { listProjects, getProject, CATEGORY_LABELS, type Project } from "../../lib/api";

// Satu halaman statis per proyek published, dibangun saat deploy.
export async function getStaticPaths() {
  const projects = await listProjects({ limit: 200 });

  const detailed = await Promise.all(
    projects.map(async (summary) => (await getProject(summary.slug)) ?? summary),
  );

  return detailed.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;

const facts = [
  { label: "Lokasi", value: [project.location, project.city].filter(Boolean).join(", ") },
  { label: "Tahun", value: project.year?.toString() },
  { label: "Kategori", value: CATEGORY_LABELS[project.category] },
  { label: "Klien", value: project.client },
  { label: "Luas", value: project.areaSqm ? `${project.areaSqm} m²` : undefined },
  { label: "Arsitek utama", value: project.leadArchitect },
].filter((fact) => fact.value);

const situs = Astro.site;
const alamatHalaman = new URL(Astro.url.pathname, situs).href;

// Satu proyek arsitektur paling tepat dijelaskan sebagai CreativeWork:
// ia bukan artikel dan bukan produk yang dijual. Remah roti dipasang
// terpisah supaya Google bisa menampilkan jalur Beranda › Proyek › Judul
// di hasil pencarian, bukan URL mentah.
const dataProyek = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    "@id": alamatHalaman,
    name: project.title,
    url: alamatHalaman,
    ...(project.summary ? { description: project.summary } : {}),
    ...(project.coverImageUrl ? { image: project.coverImageUrl } : {}),
    ...(project.year ? { dateCreated: String(project.year) } : {}),
    genre: CATEGORY_LABELS[project.category],
    ...(project.location || project.city
      ? { locationCreated: { "@type": "Place", name: [project.location, project.city].filter(Boolean).join(", ") } }
      : {}),
    creator: { "@id": new URL("/#studio", situs).href },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Beranda", item: situs?.href },
      { "@type": "ListItem", position: 2, name: "Proyek", item: new URL("/proyek/", situs).href },
      { "@type": "ListItem", position: 3, name: project.title, item: alamatHalaman },
    ],
  },
];
---

<BaseLayout
  title={project.seoTitle ?? project.title}
  description={project.seoDescription ?? project.summary}
  image={project.coverImageUrl}
  jsonLd={dataProyek}
>
  <article>
    {
      project.coverImageUrl && (
        <img
          class="cover"
          src={project.coverImageUrl}
          alt={`Foto utama proyek ${project.title}`}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      )
    }

    <header class="shell section">
      <p class="eyebrow">{CATEGORY_LABELS[project.category]}</p>
      <h1>{project.title}</h1>
      {project.subtitle && <p class="lede">{project.subtitle}</p>}
    </header>

    <div class="shell body">
      <div class="prose">
        {project.summary && <p class="lede">{project.summary}</p>}
        {project.description && <p>{project.description}</p>}
      </div>

      {
        facts.length > 0 && (
          <dl class="facts">
            {facts.map((fact) => (
              <div>
                <dt>{fact.label}</dt>
                <dd>{fact.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>

    {
      project.images && project.images.length > 0 && (
        <section class="shell section gallery">
          {project.images.map((image) => (
            <figure>
              <img
                src={image.url}
                alt={image.altText ?? `Dokumentasi proyek ${project.title}`}
                width={image.width}
                height={image.height}
                loading="lazy"
                decoding="async"
              />
              {image.caption && <figcaption>{image.caption}</figcaption>}
            </figure>
          ))}
        </section>
      )
    }

    {
      project.materials && project.materials.length > 0 && (
        <section class="shell section materials">
          <h2 class="materials__judul">Dibuat dengan</h2>
          <p class="materials__ket">Bahan utama yang dipakai di proyek ini.</p>
          <ul class="materials__grid">
            {project.materials.map((material) => (
              <li class="materials__item">
                <img
                  src={material.url}
                  alt={material.altText ?? `Material proyek ${project.title}`}
                  width={material.width}
                  height={material.height}
                  loading="lazy"
                  decoding="async"
                />
                {material.caption && <span class="materials__nama">{material.caption}</span>}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <nav class="shell back">
      <a href="/proyek">← Semua proyek</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--surface-raised);
  }

  header h1 {
    margin-bottom: 1.5rem;
  }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  @media (max-width: 48rem) {
    .body {
      grid-template-columns: 1fr;
    }
  }

  .facts {
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .facts > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
  }

  .facts dt {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .facts dd {
    margin: 0;
    font-size: 0.9rem;
    text-align: right;
  }

  .gallery {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .gallery figure {
    margin: 0;
  }

  .gallery figcaption {
    font-size: 0.85rem;
    color: var(--text-faint);
    padding-top: 0.75rem;
  }

  /* Material — deretan kecil, sengaja berbeda dari galeri.
     
     Galeri memakai foto selebar kolom karena isinya karya yang harus
     dinikmati. Material bukan itu: yang dibaca pengunjung adalah NAMANYA
     ("batu andesit", "kayu jati"), fotonya cuma penunjuk rupa. Menampilkan
     keduanya sebesar galeri akan membuat contoh batu setara dengan foto
     bangunannya. */
  .materials__judul {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin: 0;
  }

  .materials__ket {
    color: var(--text-muted);
    margin: 0.35rem 0 clamp(1.5rem, 3vw, 2.25rem);
  }

  .materials__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(11rem, 100%), 1fr));
    gap: clamp(1rem, 2.5vw, 1.75rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .materials__item {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  /* aspect-ratio, bukan tinggi tetap: kotaknya harus tetap persegi di lebar
     kolom mana pun — jebakan yang sudah tercatat di CLAUDE.md. */
  .materials__item img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--radius-md);
    border: 1px solid var(--border);
  }

  .materials__nama {
    font-size: 0.85rem;
    color: var(--text-body);
  }

  .back {
    padding-bottom: clamp(var(--space-7), 8vw, var(--space-8));
    font-size: 0.85rem;
  }
</style>
