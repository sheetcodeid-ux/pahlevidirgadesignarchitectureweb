---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  listProjects,
  getProject,
  getSettings,
  KATEGORI_LABEL,
  type Project, subjudulBerguna } from "../../lib/api";
import { BELUM_ADA } from "../../lib/menunggu";

export async function getStaticPaths() {
  const projects = await listProjects({ limit: 200 });

  /* Daftar TIDAK memuat description, materials, maupun SEO — itu milik
     endpoint detail. Halaman ini dulu memakai baris daftar apa adanya, jadi
     "The project", "Materials", dan kedua tag SEO selalu kosong di situs yang
     tayang, tanpa satu pun galat. Sekarang tiap halaman mengambil detailnya
     sendiri.

     Kalau detailnya gagal diambil, build DIGAGALKAN. Daftarnya baru saja
     bilang proyek ini ada, jadi detail yang kosong berarti API-nya bermasalah
     — dan Workers Static Assets MENGGANTI seluruh aset, jadi build yang
     "berhasil" dengan halaman setengah isi menimpa halaman yang sudah benar
     (jebakan nomor 12 di CLAUDE.md). */
  const lengkap = await Promise.all(projects.map(async (baris) => {
    const detail = await getProject(baris.slug);
    if (!detail) throw new Error(`Detail proyek "${baris.slug}" gagal diambil — build dihentikan.`);
    return detail;
  }));

  return lengkap.map((project) => ({
    params: { slug: project.slug },
    props: { project, semua: projects },
  }));
}

interface Props {
  project: Project;
  semua: Project[];
}

const { project, semua } = Astro.props;
const settings = await getSettings();
const studio = settings.studioName?.trim() || "Dirga Pahlevi Architecture";

// Isi panjang. Skema saat ini menyimpannya sebagai SATU kolom teks, jadi yang
// bisa dilakukan dengan jujur adalah memecahnya per baris kosong jadi
// paragraf. Struktur dua bagian di rancangan yang di-ACC ("The brief" dan
// "What we did") butuh dua kolom sendiri — belum ada, dan tidak saya karang.
const paragraf = (project.description ?? "")
  .split(/\n\s*\n/)
  .map((s) => s.trim())
  .filter(Boolean);

const foto = [...(project.images ?? [])].sort((a, b) => a.sortOrder - b.sortOrder);
const bahan = [...(project.materials ?? [])].sort((a, b) => a.sortOrder - b.sortOrder);

// Daftar isi hanya memuat bagian yang benar-benar ada di halaman ini.
const bagian = [
  paragraf.length ? { id: "cerita", label: "Tentang proyek" } : null,
  bahan.length ? { id: "bahan", label: "Material" } : null,
  foto.length ? { id: "galeri", label: "Galeri" } : null,
  { id: "kredit", label: "Kredit" },
].filter((x): x is { id: string; label: string } => x !== null);

// Kredit. Peran yang belum punya nama TETAP ditampilkan dengan penanda,
// sesuai rancangan — kredit fotografer khususnya wajib kalau fotonya bukan
// milik studio. Nama-namanya diisi dari lib/menunggu.ts.
interface BarisKredit {
  dt: string;
  dd: string;
  tunggu?: boolean;
}
/* Ketiga nama ini dulu di-hardcode kosong di lib/menunggu.ts, jadi SETIAP
   proyek mencetak "Name to be credited" — termasuk yang fotografernya sudah
   jelas. Sekarang datang dari kolomnya sendiri, diisi pemilik per proyek. */
const kredit: BarisKredit[] = [
  { dt: "Arsitektur", dd: project.leadArchitect || studio },
  ...(project.year ? [{ dt: "Tahun", dd: String(project.year) }] : []),
  { dt: "Fotografi", dd: project.photographer || BELUM_ADA, tunggu: !project.photographer },
  { dt: "Kontraktor", dd: project.contractor || BELUM_ADA, tunggu: !project.contractor },
  { dt: "Pencahayaan", dd: project.lightingDesigner || BELUM_ADA, tunggu: !project.lightingDesigner },
  {
    dt: "Klien",
    dd: project.client || "Tidak disebutkan atas permintaan klien",
    tunggu: !project.client,
  },
];
// Kredit dibagi rata ke tiga kolom, seperti rancangannya.
const kolomKredit: BarisKredit[][] = [[], [], []];
kredit.forEach((k, i) => kolomKredit[i % 3].push(k));

const lain = semua.filter((p) => p.slug !== project.slug).slice(0, 2);

const fakta = [
  { label: "LOKASI", nilai: project.location || project.city },
  { label: "SELESAI", nilai: project.year ? String(project.year) : null, mono: true },
  { label: "JENIS", nilai: KATEGORI_LABEL[project.category] },
  { label: "LUAS", nilai: project.areaSqm ? `${project.areaSqm.toLocaleString("id-ID")} m²` : null, mono: true },
].filter((f) => f.nilai);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    name: project.title,
    url: new URL(`/proyek/${project.slug}`, Astro.site).href,
    ...(project.summary ? { abstract: project.summary } : {}),
    ...(project.description ? { description: project.description } : {}),
    ...(project.year ? { dateCreated: String(project.year) } : {}),
    ...(project.coverImageUrl ? { image: project.coverImageUrl } : {}),
    creator: { "@type": "Organization", name: studio },
    ...(project.location || project.city
      ? { locationCreated: { "@type": "Place", name: project.location || project.city } }
      : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Work", item: new URL("/proyek", Astro.site).href },
      {
        "@type": "ListItem",
        position: 2,
        name: project.title,
        item: new URL(`/proyek/${project.slug}`, Astro.site).href,
      },
    ],
  },
];
---

<BaseLayout
  title={project.seoTitle ?? project.title}
  description={project.seoDescription ?? project.summary}
  image={project.coverImageUrl}
  jsonLd={jsonLd}
>
  <div class="pita">
    <div class="dalam">
      <div class="isi judul-blok">
        <span class="dim kecil">
          <a class="remah" href="/proyek">Karya</a> <span class="dim">/</span>
          {KATEGORI_LABEL[project.category]} <span class="dim">/</span>
          <span class="mut">{project.title}</span>
        </span>
        <div class="s24"></div>
        <h1 class="h1 judul-blok__h1">{project.title}</h1>
        {
          /* subjudulBerguna, bukan project.subtitle langsung: subjudul yang
             isinya sama persis dengan judul akan menumpuk judul yang sama dua
             baris di sini. Aturannya sama dengan beranda, dari satu fungsi. */
          subjudulBerguna(project) && (
            <>
              <div class="s16"></div>
              <p class="tagline">{subjudulBerguna(project)}</p>
            </>
          )
        }
      </div>
      {
        fakta.length > 0 && (
          <div class={`baris b${Math.min(fakta.length, 4)} fakta`}>
            {fakta.map((f) => (
              <div class="sel">
                <span class="label label--redup">{f.label}</span>
                <div class="s6"></div>
                <span class={f.mono ? "hs mono" : "hs"}>{f.nilai}</span>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </div>

  {
    project.coverImageUrl && (
      <div class="pita">
        <div class="dalam">
          <div class="foto foto--utama">
            <img src={project.coverImageUrl} alt={project.title} width="1600" height="900" fetchpriority="high" decoding="async" />
          </div>
        </div>
      </div>
    )
  }

  {
    (paragraf.length > 0 || bahan.length > 0) && (
      <div class="pita">
        <div class="dalam">
          <div class="baris baris-toc">
            <div class="sel toc toc--rapat">
              <div class="toc__kop">
                <span class="label label--redup">DI HALAMAN INI</span>
              </div>
              <nav id="toc" aria-label="Di halaman ini">
                {bagian.map((b, i) => (
                  <a href={`#${b.id}`} class={i === 0 ? "kat__b kini" : "kat__b"}>
                    {b.label}
                    <span class="panah-kotak" aria-hidden="true">
                      <svg width="19" height="19" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2.6" y="2.6" width="16.8" height="16.8" rx="4.6" /><path d="M9.4 7.4 13 11l-3.6 3.6" /></svg>
                    </span>
                  </a>
                ))}
              </nav>
              <div class="toc__bagi">
                <span class="label label--redup">BAGIKAN</span>
                <div class="s10"></div>
                <div class="rowx">
                  <button class="pil" type="button" id="salinTautan">Salin tautan</button>
                </div>
              </div>
            </div>

            <div class="sel teks-panel">
              {paragraf.length > 0 && (
                <div class="isi-teks">
                  <h2 class="h3" id="cerita">Tentang proyek</h2>
                  {paragraf.map((p) => (
                    <p class="mut">{p}</p>
                  ))}
                </div>
              )}

              {bahan.length > 0 && (
                <>
                  <div class="s24"></div>
                  <div class="isi-teks"><h2 class="h3" id="bahan">Materials</h2></div>
                  <div class="s16"></div>
                  <div class="bahan-kisi">
                    {bahan.map((m) => (
                      <div class="sel bahan-sel">
                        <span class="hs bahan-nama">{m.caption || m.altText || "Material"}</span>
                        {m.caption && m.altText && (
                          <>
                            <div class="s6"></div>
                            <span class="dim kecil">{m.altText}</span>
                          </>
                        )}
                      </div>
                    ))}
                  </div>
                </>
              )}
            </div>
          </div>
        </div>
      </div>
    )
  }

  {
    foto.length > 0 && (
      <div class="pita" id="galeri">
        <div class="dalam">
          <div class="isi isi--rapat galeri-kop">
            <span class="label">
              GALERI · {foto.length} FOTO
            </span>
            <span class="dim kecil">seret · gulir · tombol panah</span>
          </div>
          <div class="strip strip--galeri" id="swStrip">
            {foto.map((f, i) => (
              <div class="foto foto--strip">
                <img src={f.url} alt={f.altText ?? ""} loading={i < 2 ? "eager" : "lazy"} decoding="async" width="1600" height="900" />
                {f.caption && <span class="foto__ket">{f.caption}</span>}
              </div>
            ))}
          </div>
          <div class="rel"><i id="swProg"></i></div>
          {/* Rel pemilih foto. Dulu hanya nomor 01..10 di atas latar bergaris
              miring — pemilik melaporkannya sebagai "kotak kecil 1-10 tidak
              ada gambarnya, harusnya ada". Memang harus: satu-satunya gunanya
              adalah melompat ke foto tertentu, dan nomor tidak memberi tahu
              foto mana. Sekarang tiap kotak memuat fotonya sendiri, nomornya
              turun jadi penanda kecil di sudut. */}
          <div class="film" id="swFilm" aria-label="Pilih foto">
            {foto.map((f, i) => (
              <button type="button" data-ke={i} aria-current={i === 0 ? "true" : "false"}
                aria-label={`Photograph ${i + 1} of ${foto.length}`}>
                {/* Versi kecil (400px, WebP), bukan fotonya. Kotak ini
                    120x62 sementara foto besarnya 2560px — memakainya di sini
                    berarti peramban mendekode sekitar dua puluh kali piksel
                    yang dipakainya, sepuluh kali di halaman yang sama.

                    `?? f.url` disengaja: foto yang diunggah sebelum kolom
                    thumb_key ada tidak punya versi kecil, dan halaman ini
                    harus tetap menampilkannya. fetchpriority="low" tetap
                    dipertahankan supaya foto yang sedang dilihat orang
                    menang duluan memperebutkan jalur unduh. */}
                <img src={f.thumbUrl ?? f.url} alt="" loading="lazy" decoding="async"
                  fetchpriority="low" width="160" height="90" />
                <span class="film__no">{String(i + 1).padStart(2, "0")}</span>
              </button>
            ))}
          </div>
          <div class="isi isi--rapat">
            <span class="dim kecil" id="swInfo" role="status" aria-live="polite">
              1 / {foto.length}{foto[0].caption ? ` — ${foto[0].caption}` : ""}
            </span>
          </div>
        </div>
      </div>
    )
  }

  <div class="pita" id="kredit">
    <div class="dalam">
      <div class="isi isi--rapat"><span class="label">KREDIT</span></div>
      <div class="baris b3">
        {
          kolomKredit.map((kolom) => (
            <div class="sel">
              <dl class="kredit">
                {kolom.map((k) => (
                  <>
                    <dt>{k.dt}</dt>
                    <dd class={k.tunggu ? "dim" : undefined}>{k.dd}</dd>
                  </>
                ))}
              </dl>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  {
    lain.length > 0 && (
      <div class="pita">
        <div class="dalam">
          <div class="isi isi--rapat"><span class="label">KARYA LAIN</span></div>
          <div class="baris b2">
            {lain.map((p) => (
              <a class="sel pk pk--tautan" href={`/proyek/${p.slug}`}>
                <div class="pk__bung">
                  <div class="foto pk__foto">
                    {p.coverImageUrl ? (
                      <img src={p.coverImageUrl} alt="" loading="lazy" decoding="async" width="640" height="360" />
                    ) : (
                      <span>NO COVER YET</span>
                    )}
                  </div>
                  <span class="pk__aksi">Buka proyek</span>
                </div>
                <div class="pk__isi">
                  <span class="label label--redup">
                    {[KATEGORI_LABEL[p.category], p.year].filter(Boolean).join(" · ").toUpperCase()}
                  </span>
                  <div class="s10"></div>
                  <span class="pk__nm">{p.title}</span>
                </div>
                <span class="pk__gr"></span>
              </a>
            ))}
            {lain.length === 1 && (
              <div class="sel sel--kosong pk-kosong">
                <span class="dim kecil">
                  This cell fills itself
                  <br />
                  as soon as a third project is published
                </span>
              </div>
            )}
          </div>
        </div>
      </div>
    )
  }

  <div class="pita pita--akhir">
    <div class="dalam titik pijar">
      <span class="pijar-lapis" aria-hidden="true"></span>
      <div class="isi ajak">
        <h2 class="h2 ajak__judul">
          Membangun sesuatu yang harus <span class="ak">lebih dari satu hal</span>?
        </h2>
        <div class="s24"></div>
        <div class="rowx ajak__tombol">
          <a class="btn btn--dot" href="/kontak">Mulai proyek <span class="ar">→</span></a>
          <a class="btn" href="/proyek">Lihat semua karya <span class="ar">→</span></a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* ── Dari blok CSS khusus halaman di mockup yang di-ACC ─────────────────
     Aturan di bawah ini tidak boleh ditulis ulang dari ingatan: ia yang
     menentukan lebar tagline, ukuran teks daftar isi, dan bentuk kredit. */
  .isi-teks {
    max-width: 64ch;
  }
  .isi-teks p {
    margin-bottom: 18px;
  }
  .isi-teks h2 {
    margin: 34px 0 12px;
  }
  .toc {
    position: sticky;
    top: 0;
    align-self: start;
  }
  /* Daftar isi memakai pola rel kategori: baris penuh, pemisah bertanda ⊢⊣,
     chevron berkotak pada baris aktif. */
  #toc a {
    text-decoration: none;
    font-size: 12.5px;
  }
  #toc a.kini {
    color: var(--aksen);
    background: var(--gelap);
  }
  #toc a.kini .panah-kotak {
    opacity: 1;
    transform: none;
  }
  #toc a:last-child {
    border-bottom: 0;
  }
  #toc a:last-child::after {
    display: none;
  }
  .kredit dt {
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--teks-3);
    margin-bottom: 5px;
  }
  .kredit dd {
    margin: 0 0 18px;
    font-size: 14px;
    color: var(--teks-2);
  }
  .tagline {
    font-family: var(--judul);
    font-size: clamp(1.3rem, 2.2vw, 1.75rem);
    line-height: 1.4;
    color: var(--teks);
    max-width: 26ch;
  }

  /* Lebar rel daftar isi milik halaman ini, bukan sistem. */
  .baris-toc {
    grid-template-columns: 250px 1fr;
  }
  .toc--rapat {
    padding: 0;
  }
  .toc__kop {
    padding: 26px 26px 18px;
  }
  .toc__bagi {
    padding: 26px;
  }
  .judul-blok {
    padding-bottom: 34px;
  }
  .judul-blok__h1 {
    font-size: clamp(2.2rem, 4.4vw, 3.4rem);
  }
  .remah {
    color: inherit;
    text-decoration: none;
  }
  .remah:hover {
    color: var(--aksen);
  }
  .fakta {
    border-top: 1px solid var(--garis);
  }
  .teks-panel {
    padding: 44px 40px;
  }
  .foto--utama {
    aspect-ratio: var(--rasio-foto);
  }
  .foto--utama img,
  .foto--strip img,
  .pk__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .foto--strip {
    height: 420px;
    aspect-ratio: var(--rasio-foto);
    flex: none;
  }
  .strip--galeri {
    border-top: 1px solid var(--garis);
  }
  .galeri-kop {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    flex-wrap: wrap;
  }
  .bahan-kisi {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(210px, 100%), 1fr));
    border: 1px solid var(--garis);
  }
  .bahan-sel {
    padding: 20px 22px;
    min-width: 0;
  }
  .bahan-nama {
    font-size: 14px;
  }

  /* Kartu "proyek lain" adalah tautan sungguhan; di mockup ia <article>. */
  .pk--tautan {
    padding: 0;
    color: inherit;
    text-decoration: none;
    display: block;
  }
  .pk__foto {
    height: 190px;
  }
  .pk__isi {
    padding: 22px 24px 26px;
  }
  .pk-kosong {
    display: grid;
    place-items: center;
    min-height: 200px;
  }
  .pk-kosong span {
    text-align: center;
    padding: 24px;
  }
  .ajak {
    padding-block: 84px;
    text-align: center;
  }
  .ajak__judul {
    max-width: 22ch;
    margin-inline: auto;
  }
  .ajak__tombol {
    justify-content: center;
  }

  @media (max-width: 900px) {
    .baris-toc {
      grid-template-columns: 1fr;
    }
    .baris-toc > .toc {
      position: static;
      border-bottom: 1px solid var(--garis);
    }
    .teks-panel {
      padding: 28px 20px;
    }
  }
</style>

<script>
  import { relSpy } from "../../lib/relspy";
  import { pantauStrip } from "../../lib/strip";

  import { bukaLightbox } from "../../lib/lightbox";

  (() => {
    "use strict";
    const diam = matchMedia("(prefers-reduced-motion: reduce)").matches;

    /* ── Daftar isi lengket ────────────────────────────────────────────────
       Ditandai dari matematika gulir langsung, bukan IntersectionObserver:
       observer tidak bisa diandalkan pada lompatan gulir yang jauh. */
    const tautan = [...document.querySelectorAll<HTMLAnchorElement>("#toc a")];
    tautan.forEach((t) =>
      t.addEventListener("click", () => {
        tautan.forEach((x) => x.classList.remove("kini"));
        t.classList.add("kini");
      }),
    );
    const bagian = tautan
      .map((a) => document.querySelector(a.getAttribute("href") || ""))
      .filter((x): x is Element => Boolean(x));
    relSpy({ bagian, tautan });

    /* ── Salin tautan ──────────────────────────────────────────────────── */
    const salin = document.getElementById("salinTautan");
    salin?.addEventListener("click", async () => {
      const semula = salin.textContent;
      try {
        await navigator.clipboard.writeText(location.href);
        salin.textContent = "Copied";
      } catch {
        // Clipboard bisa ditolak peramban (izin, konteks tak aman). Jangan
        // mengaku berhasil — tunjukkan apa yang harus disalin sendiri.
        salin.textContent = "Press Ctrl/Cmd + C";
      }
      setTimeout(() => (salin.textContent = semula), 2200);
    });

    /* ── Galeri ───────────────────────────────────────────────────────── */
    const strip = document.getElementById("swStrip");
    const prog = document.getElementById("swProg");
    const film = document.getElementById("swFilm");
    const info = document.getElementById("swInfo");
    if (!strip || !prog || !film || !info) return;
    const kartu = [...strip.children] as HTMLElement[];
    const ket = kartu.map((k) => k.querySelector(".foto__ket")?.textContent?.trim() ?? "");
    const semuaFoto = kartu.map((k, i) => {
      const img = k.querySelector("img") as HTMLImageElement | null;
      return { url: img?.currentSrc || img?.src || "", caption: ket[i] || null, altText: img?.alt || null };
    });
    kartu.forEach((k) => { const i = k.querySelector("img"); if (i) i.style.cursor = "zoom-in"; });

    pantauStrip({
      strip, prog, film, info,
      teks: (ke, jumlah) => `${ke + 1} / ${jumlah}${ket[ke] ? ` — ${ket[ke]}` : ""}`,
    });
    film.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest("button");
      if (!b) return;
      strip.scrollTo({ left: kartu[Number(b.dataset.ke)].offsetLeft, behavior: diam ? "auto" : "smooth" });
    });

    let seret = false;
    let seretJauh = false;
    let mx = 0;
    let my = 0;
    let kiri = 0;
    let fotoMulai = -1;
    strip.addEventListener("pointerdown", (e) => {
      /* Dicatat untuk SEMUA jenis penunjuk, bukan cuma tetikus: yang dipakai
         membuka penampil adalah pasangan pointerdown/pointerup, dan di layar
         sentuh justru itu satu-satunya yang tersedia. */
      mx = e.clientX;
      my = e.clientY;
      const el = (e.target as HTMLElement).closest(".foto");
      fotoMulai = el ? kartu.indexOf(el as HTMLElement) : -1;

      // Seret dengan tetikus. Di layar sentuh, gulir bawaan sudah menangani
      // ini dan menimpanya justru membuat geser jadi tersendat.
      if (e.pointerType !== "mouse") return;
      seret = true;
      seretJauh = false;
      kiri = strip.scrollLeft;
      strip.classList.add("tarik");
      strip.setPointerCapture(e.pointerId);
    });
    strip.addEventListener("pointermove", (e) => {
      if (!seret) return;
      strip.scrollLeft = kiri - (e.clientX - mx);
      if (Math.abs(e.clientX - mx) > 6) seretJauh = true;
    });
    const lepas = () => {
      if (seret) {
        seret = false;
        strip.classList.remove("tarik");
      }
    };
    /* Membuka penampil dari pointerup, BUKAN dari click.
       strip.setPointerCapture() di atas membelokkan peristiwa click ke strip
       itu sendiri, jadi listener di masing-masing foto tidak pernah kena —
       terukur: penampilnya tidak terbuka sama sekali, tanpa satu pun galat.
       Jarak 8px membedakan ketukan dari seretan; tanpa itu, tiap kali strip
       diseret penampilnya ikut terbuka begitu tombol dilepas. */
    strip.addEventListener("pointerup", (e) => {
      const jarak = Math.hypot(e.clientX - mx, e.clientY - my);
      const ke = fotoMulai;
      fotoMulai = -1;
      lepas();
      if (ke >= 0 && jarak < 8 && !seretJauh) bukaLightbox(semuaFoto, ke);
    });
    strip.addEventListener("pointercancel", () => { fotoMulai = -1; lepas(); });
    strip.tabIndex = 0;
    strip.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
      e.preventDefault();
      strip.scrollBy({ left: (e.key === "ArrowRight" ? 1 : -1) * 460, behavior: diam ? "auto" : "smooth" });
    });
  })();
</script>
