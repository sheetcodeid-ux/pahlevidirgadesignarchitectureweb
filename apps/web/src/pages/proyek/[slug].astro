---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  listProjects,
  getSettings,
  CATEGORY_LABELS_EN,
  type Project,
} from "../../lib/api";

export async function getStaticPaths() {
  const projects = await listProjects({ limit: 200 });
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project, semua: projects },
  }));
}

interface Props {
  project: Project;
  semua: Project[];
}

const { project, semua } = Astro.props;
const settings = await getSettings();
const studio = settings.studioName?.trim() || "Dirga Pahlevi Architecture";

// Isi panjang. Skema saat ini menyimpannya sebagai SATU kolom teks, jadi yang
// bisa dilakukan dengan jujur adalah memecahnya per baris kosong jadi
// paragraf. Struktur dua bagian di rancangan yang di-ACC ("The brief" dan
// "What we did") butuh dua kolom sendiri — belum ada, dan tidak saya karang.
const paragraf = (project.description ?? "")
  .split(/\n\s*\n/)
  .map((s) => s.trim())
  .filter(Boolean);

const foto = [...(project.images ?? [])].sort((a, b) => a.sortOrder - b.sortOrder);
const bahan = [...(project.materials ?? [])].sort((a, b) => a.sortOrder - b.sortOrder);

// Daftar isi hanya memuat bagian yang benar-benar ada di halaman ini.
const bagian = [
  paragraf.length ? { id: "cerita", label: "The project" } : null,
  bahan.length ? { id: "bahan", label: "Materials" } : null,
  foto.length ? { id: "galeri", label: "Gallery" } : null,
  { id: "kredit", label: "Credits" },
].filter((x): x is { id: string; label: string } => x !== null);

// Kredit: hanya baris yang datanya ada. Empat baris "Name to be credited" di
// mockup adalah penanda bahwa datanya belum ada — di situs yang tayang itu
// cuma membuat halaman tampak belum selesai.
const kredit = [
  { dt: "Architecture", dd: project.leadArchitect || studio },
  project.year ? { dt: "Year", dd: String(project.year) } : null,
  project.client ? { dt: "Client", dd: project.client } : null,
  project.areaSqm ? { dt: "Area", dd: `${project.areaSqm.toLocaleString("en-US")} m²` } : null,
].filter((x): x is { dt: string; dd: string } => x !== null);

const lain = semua.filter((p) => p.slug !== project.slug).slice(0, 2);

const fakta = [
  { label: "LOCATION", nilai: project.location || project.city },
  { label: "COMPLETED", nilai: project.year ? String(project.year) : null, mono: true },
  { label: "TYPE", nilai: CATEGORY_LABELS_EN[project.category] },
  { label: "AREA", nilai: project.areaSqm ? `${project.areaSqm.toLocaleString("en-US")} m²` : null, mono: true },
].filter((f) => f.nilai);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    name: project.title,
    url: new URL(`/proyek/${project.slug}`, Astro.site).href,
    ...(project.summary ? { abstract: project.summary } : {}),
    ...(project.description ? { description: project.description } : {}),
    ...(project.year ? { dateCreated: String(project.year) } : {}),
    ...(project.coverImageUrl ? { image: project.coverImageUrl } : {}),
    creator: { "@type": "Organization", name: studio },
    ...(project.location || project.city
      ? { locationCreated: { "@type": "Place", name: project.location || project.city } }
      : {}),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Work", item: new URL("/proyek", Astro.site).href },
      {
        "@type": "ListItem",
        position: 2,
        name: project.title,
        item: new URL(`/proyek/${project.slug}`, Astro.site).href,
      },
    ],
  },
];
---

<BaseLayout
  title={project.seoTitle ?? project.title}
  description={project.seoDescription ?? project.summary}
  image={project.coverImageUrl}
  jsonLd={jsonLd}
>
  <div class="pita">
    <div class="dalam">
      <div class="isi judul-blok">
        <span class="dim kecil">
          <a class="remah" href="/proyek">Work</a> <span class="dim">/</span>
          {CATEGORY_LABELS_EN[project.category]} <span class="dim">/</span>
          <span class="mut">{project.title}</span>
        </span>
        <div class="s24"></div>
        <h1 class="h1 judul-blok__h1">{project.title}</h1>
        {
          project.subtitle && (
            <>
              <div class="s16"></div>
              <p class="tagline">{project.subtitle}</p>
            </>
          )
        }
      </div>
      {
        fakta.length > 0 && (
          <div class={`baris b${Math.min(fakta.length, 4)} fakta`}>
            {fakta.map((f) => (
              <div class="sel">
                <span class="label label--redup">{f.label}</span>
                <div class="s6"></div>
                <span class={f.mono ? "hs mono" : "hs"}>{f.nilai}</span>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </div>

  {
    project.coverImageUrl && (
      <div class="pita">
        <div class="dalam">
          <div class="foto foto--utama">
            <img src={project.coverImageUrl} alt={project.title} width="1600" height="900" fetchpriority="high" decoding="async" />
          </div>
        </div>
      </div>
    )
  }

  {
    (paragraf.length > 0 || bahan.length > 0) && (
      <div class="pita">
        <div class="dalam">
          <div class="baris baris-toc">
            <div class="sel toc toc--rapat">
              <div class="toc__kop">
                <span class="label label--redup">ON THIS PAGE</span>
              </div>
              <nav id="toc" aria-label="On this page">
                {bagian.map((b, i) => (
                  <a href={`#${b.id}`} class={i === 0 ? "kat__b kini" : "kat__b"}>
                    {b.label}
                    <span class="panah-kotak" aria-hidden="true">
                      <svg width="19" height="19" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="2.6" y="2.6" width="16.8" height="16.8" rx="4.6" /><path d="M9.4 7.4 13 11l-3.6 3.6" /></svg>
                    </span>
                  </a>
                ))}
              </nav>
              <div class="toc__bagi">
                <span class="label label--redup">SHARE</span>
                <div class="s10"></div>
                <div class="rowx">
                  <button class="pil" type="button" id="salinTautan">Copy link</button>
                </div>
              </div>
            </div>

            <div class="sel teks-panel">
              {paragraf.length > 0 && (
                <div class="isi-teks">
                  <h2 class="h3" id="cerita">The project</h2>
                  {paragraf.map((p) => (
                    <p class="mut">{p}</p>
                  ))}
                </div>
              )}

              {bahan.length > 0 && (
                <>
                  <div class="s24"></div>
                  <div class="isi-teks"><h2 class="h3" id="bahan">Materials</h2></div>
                  <div class="s16"></div>
                  <div class="bahan-kisi">
                    {bahan.map((m) => (
                      <div class="sel bahan-sel">
                        <span class="hs bahan-nama">{m.caption || m.altText || "Material"}</span>
                        {m.caption && m.altText && (
                          <>
                            <div class="s6"></div>
                            <span class="dim kecil">{m.altText}</span>
                          </>
                        )}
                      </div>
                    ))}
                  </div>
                </>
              )}
            </div>
          </div>
        </div>
      </div>
    )
  }

  {
    foto.length > 0 && (
      <div class="pita" id="galeri">
        <div class="dalam">
          <div class="isi isi--rapat galeri-kop">
            <span class="label">
              GALLERY · {foto.length} {foto.length === 1 ? "PHOTOGRAPH" : "PHOTOGRAPHS"}
            </span>
            <span class="dim kecil">drag · scroll · arrow keys</span>
          </div>
          <div class="strip strip--galeri" id="swStrip">
            {foto.map((f, i) => (
              <div class="foto foto--strip">
                <img src={f.url} alt={f.altText ?? ""} loading={i < 2 ? "eager" : "lazy"} decoding="async" width="1600" height="900" />
                {f.caption && <span class="foto__ket">{f.caption}</span>}
              </div>
            ))}
          </div>
          <div class="rel"><i id="swProg"></i></div>
          <div class="film" id="swFilm" aria-label="Choose a photo">
            {foto.map((_, i) => (
              <button type="button" data-ke={i} aria-current={i === 0 ? "true" : "false"}>
                {String(i + 1).padStart(2, "0")}
              </button>
            ))}
          </div>
          <div class="isi isi--rapat">
            <span class="dim kecil" id="swInfo" role="status" aria-live="polite">
              1 / {foto.length}{foto[0].caption ? ` — ${foto[0].caption}` : ""}
            </span>
          </div>
        </div>
      </div>
    )
  }

  <div class="pita" id="kredit">
    <div class="dalam">
      <div class="isi isi--rapat"><span class="label">CREDITS</span></div>
      <div class={`baris b${Math.min(kredit.length, 3)}`}>
        {
          kredit.map((k) => (
            <div class="sel">
              <dl class="kredit">
                <dt>{k.dt}</dt>
                <dd>{k.dd}</dd>
              </dl>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  {
    lain.length > 0 && (
      <div class="pita">
        <div class="dalam">
          <div class="isi isi--rapat"><span class="label">MORE WORK</span></div>
          <div class="baris b2">
            {lain.map((p) => (
              <a class="sel pk pk--tautan" href={`/proyek/${p.slug}`}>
                <div class="pk__bung">
                  <div class="foto pk__foto">
                    {p.coverImageUrl ? (
                      <img src={p.coverImageUrl} alt="" loading="lazy" decoding="async" width="640" height="360" />
                    ) : (
                      <span>NO COVER YET</span>
                    )}
                  </div>
                  <span class="pk__aksi">Open project</span>
                </div>
                <div class="pk__isi">
                  <span class="label label--redup">
                    {[CATEGORY_LABELS_EN[p.category], p.year].filter(Boolean).join(" · ").toUpperCase()}
                  </span>
                  <div class="s10"></div>
                  <span class="pk__nm">{p.title}</span>
                </div>
                <span class="pk__gr"></span>
              </a>
            ))}
            {lain.length === 1 && (
              <div class="sel sel--kosong pk-kosong">
                <span class="dim kecil">
                  This cell fills itself
                  <br />
                  as soon as a third project is published
                </span>
              </div>
            )}
          </div>
        </div>
      </div>
    )
  }

  <div class="pita pita--akhir">
    <div class="dalam titik pijar">
      <span class="pijar-lapis" aria-hidden="true"></span>
      <div class="isi ajak">
        <h2 class="h2 ajak__judul">
          Building something that has to be <span class="ak">more than one thing</span>?
        </h2>
        <div class="s24"></div>
        <div class="rowx ajak__tombol">
          <a class="btn btn--isi" href="/kontak">Start a project <span class="ar">→</span></a>
          <a class="btn" href="/proyek">See all work <span class="ar">→</span></a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* ── Dari blok CSS khusus halaman di mockup yang di-ACC ─────────────────
     Aturan di bawah ini tidak boleh ditulis ulang dari ingatan: ia yang
     menentukan lebar tagline, ukuran teks daftar isi, dan bentuk kredit. */
  .isi-teks {
    max-width: 64ch;
  }
  .isi-teks p {
    margin-bottom: 18px;
  }
  .isi-teks h2 {
    margin: 34px 0 12px;
  }
  .toc {
    position: sticky;
    top: 0;
    align-self: start;
  }
  /* Daftar isi memakai pola rel kategori: baris penuh, pemisah bertanda ⊢⊣,
     chevron berkotak pada baris aktif. */
  #toc a {
    text-decoration: none;
    font-size: 12.5px;
  }
  #toc a.kini {
    color: var(--aksen);
    background: var(--gelap);
  }
  #toc a.kini .panah-kotak {
    opacity: 1;
    transform: none;
  }
  #toc a:last-child {
    border-bottom: 0;
  }
  #toc a:last-child::after {
    display: none;
  }
  .kredit dt {
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--teks-3);
    margin-bottom: 5px;
  }
  .kredit dd {
    margin: 0 0 18px;
    font-size: 14px;
    color: var(--teks-2);
  }
  .tagline {
    font-family: var(--judul);
    font-size: clamp(1.3rem, 2.2vw, 1.75rem);
    line-height: 1.4;
    color: var(--teks);
    max-width: 26ch;
  }

  /* Lebar rel daftar isi milik halaman ini, bukan sistem. */
  .baris-toc {
    grid-template-columns: 250px 1fr;
  }
  .toc--rapat {
    padding: 0;
  }
  .toc__kop {
    padding: 26px 26px 18px;
  }
  .toc__bagi {
    padding: 26px;
  }
  .judul-blok {
    padding-bottom: 34px;
  }
  .judul-blok__h1 {
    font-size: clamp(2.2rem, 4.4vw, 3.4rem);
  }
  .remah {
    color: inherit;
    text-decoration: none;
  }
  .remah:hover {
    color: var(--aksen);
  }
  .fakta {
    border-top: 1px solid var(--garis);
  }
  .teks-panel {
    padding: 44px 40px;
  }
  .foto--utama {
    aspect-ratio: var(--rasio-foto);
  }
  .foto--utama img,
  .foto--strip img,
  .pk__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .foto--strip {
    height: 420px;
    aspect-ratio: var(--rasio-foto);
    flex: none;
  }
  .strip--galeri {
    border-top: 1px solid var(--garis);
  }
  .galeri-kop {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px;
    flex-wrap: wrap;
  }
  .bahan-kisi {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(210px, 100%), 1fr));
    border: 1px solid var(--garis);
  }
  .bahan-sel {
    padding: 20px 22px;
    min-width: 0;
  }
  .bahan-nama {
    font-size: 14px;
  }

  /* Kartu "proyek lain" adalah tautan sungguhan; di mockup ia <article>. */
  .pk--tautan {
    padding: 0;
    color: inherit;
    text-decoration: none;
    display: block;
  }
  .pk__foto {
    height: 190px;
  }
  .pk__isi {
    padding: 22px 24px 26px;
  }
  .pk-kosong {
    display: grid;
    place-items: center;
    min-height: 200px;
  }
  .pk-kosong span {
    text-align: center;
    padding: 24px;
  }
  .ajak {
    padding-block: 84px;
    text-align: center;
  }
  .ajak__judul {
    max-width: 22ch;
    margin-inline: auto;
  }
  .ajak__tombol {
    justify-content: center;
  }

  @media (max-width: 900px) {
    .baris-toc {
      grid-template-columns: 1fr;
    }
    .baris-toc > .toc {
      position: static;
      border-bottom: 1px solid var(--garis);
    }
    .teks-panel {
      padding: 28px 20px;
    }
  }
</style>

<script>
  (() => {
    "use strict";
    const diam = matchMedia("(prefers-reduced-motion: reduce)").matches;

    /* ── Daftar isi lengket ────────────────────────────────────────────────
       Ditandai dari matematika gulir langsung, bukan IntersectionObserver:
       observer tidak bisa diandalkan pada lompatan gulir yang jauh. */
    const tautan = [...document.querySelectorAll<HTMLAnchorElement>("#toc a")];
    tautan.forEach((t) =>
      t.addEventListener("click", () => {
        tautan.forEach((x) => x.classList.remove("kini"));
        t.classList.add("kini");
      }),
    );
    const bagian = tautan
      .map((a) => document.querySelector(a.getAttribute("href") || ""))
      .filter((x): x is Element => Boolean(x));
    if (bagian.length) {
      const GARIS = () => innerHeight * 0.14;
      const tandai = () => {
        let ke = 0;
        bagian.forEach((b, k) => {
          if (b.getBoundingClientRect().top <= GARIS() + 1) ke = k;
        });
        // Bagian terakhir tidak pernah melewati garis kalau halamannya sudah
        // mentok di bawah — tanpa ini ia tidak pernah menyala.
        if (innerHeight + scrollY >= document.body.scrollHeight - 4) ke = bagian.length - 1;
        tautan.forEach((t, k) => t.classList.toggle("kini", k === ke));
      };
      addEventListener("scroll", tandai, { passive: true });
      addEventListener("resize", tandai);
      tandai();
    }

    /* ── Salin tautan ──────────────────────────────────────────────────── */
    const salin = document.getElementById("salinTautan");
    salin?.addEventListener("click", async () => {
      const semula = salin.textContent;
      try {
        await navigator.clipboard.writeText(location.href);
        salin.textContent = "Copied";
      } catch {
        // Clipboard bisa ditolak peramban (izin, konteks tak aman). Jangan
        // mengaku berhasil — tunjukkan apa yang harus disalin sendiri.
        salin.textContent = "Press Ctrl/Cmd + C";
      }
      setTimeout(() => (salin.textContent = semula), 2200);
    });

    /* ── Galeri ───────────────────────────────────────────────────────── */
    const strip = document.getElementById("swStrip");
    const prog = document.getElementById("swProg");
    const film = document.getElementById("swFilm");
    const info = document.getElementById("swInfo");
    if (!strip || !prog || !film || !info) return;
    const kartu = [...strip.children] as HTMLElement[];
    const ket = kartu.map((k) => k.querySelector(".foto__ket")?.textContent?.trim() ?? "");

    function hitung() {
      const maks = strip!.scrollWidth - strip!.clientWidth;
      const rasio = maks > 0 ? strip!.scrollLeft / maks : 0;
      const lebar = Math.max(8, (strip!.clientWidth / strip!.scrollWidth) * 100);
      prog!.style.width = lebar + "%";
      prog!.style.marginLeft = rasio * (100 - lebar) + "%";
      let ke = 0;
      kartu.forEach((el, i) => {
        if (el.offsetLeft - strip!.scrollLeft <= 40) ke = i;
      });
      info!.textContent = `${ke + 1} / ${kartu.length}${ket[ke] ? ` — ${ket[ke]}` : ""}`;
      [...film!.children].forEach((b, i) => b.setAttribute("aria-current", String(i === ke)));
    }
    strip.addEventListener("scroll", hitung, { passive: true });
    film.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest("button");
      if (!b) return;
      strip.scrollTo({ left: kartu[Number(b.dataset.ke)].offsetLeft, behavior: diam ? "auto" : "smooth" });
    });

    let seret = false;
    let mx = 0;
    let kiri = 0;
    strip.addEventListener("pointerdown", (e) => {
      // Hanya tetikus. Di layar sentuh, gulir bawaan sudah menangani ini dan
      // menimpanya justru membuat geser jadi tersendat.
      if (e.pointerType !== "mouse") return;
      seret = true;
      mx = e.clientX;
      kiri = strip.scrollLeft;
      strip.classList.add("tarik");
      strip.setPointerCapture(e.pointerId);
    });
    strip.addEventListener("pointermove", (e) => {
      if (seret) strip.scrollLeft = kiri - (e.clientX - mx);
    });
    const lepas = () => {
      if (seret) {
        seret = false;
        strip.classList.remove("tarik");
      }
    };
    strip.addEventListener("pointerup", lepas);
    strip.addEventListener("pointercancel", lepas);
    strip.tabIndex = 0;
    strip.addEventListener("keydown", (e) => {
      if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
      e.preventDefault();
      strip.scrollBy({ left: (e.key === "ArrowRight" ? 1 : -1) * 460, behavior: diam ? "auto" : "smooth" });
    });
    hitung();
    addEventListener("resize", hitung);
  })();
</script>
