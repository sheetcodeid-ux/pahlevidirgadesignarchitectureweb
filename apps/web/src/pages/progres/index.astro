.ringkas{display:flex;justify-content:space-between;gap:20px;padding:14px 0;
  border-top:1px solid var(--garis);font-size:14px}
.ringkas:first-of-type{border-top:2px solid var(--garis-2)}
.ringkas b{font-variant-numeric:tabular-nums}
/* Bukan toska: warna itu berarti "beres" di sistem ini, dan sisa tagihan
   bukan sesuatu yang sudah beres. Penekanannya lewat ukuran saja. */
.ringkas--sisa b{color:var(--teks);font-size:17px}

/* Riwayat pembaruan */
.upd{display:grid;grid-template-columns:104px 1fr;gap:0 20px;padding:0 0 26px;position:relative}
.upd:last-child{padding-bottom:0}
.upd__w{font-size:12px;color:var(--teks-3);padding-top:2px;line-height:1.5}
