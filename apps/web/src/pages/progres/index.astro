/* Pemutar pesan suara — <audio> asli akan dipakai di kode; di sini bentuknya */
.suara{display:flex;align-items:center;gap:12px;background:var(--gelap);
  border:1px solid var(--garis);padding:11px 14px;margin-top:12px}
.suara__p{flex:none;width:32px;height:32px;border-radius:99px;background:var(--aksen);
  color:#18181B;display:grid;place-items:center;border:0;cursor:pointer}
.suara__bar{flex:1;height:3px;background:var(--sel-2);position:relative;min-width:80px}
.suara__bar i{position:absolute;left:0;top:0;bottom:0;width:34%;background:var(--aksen)}
.suara__w{font-size:11.5px;color:var(--teks-3);font-variant-numeric:tabular-nums}

/* Thread komentar */
.thr{margin-top:14px;border-left:2px solid var(--garis);padding-left:16px}
.thr__k{padding:9px 0;border-top:1px solid var(--garis)}
.thr__k:first-child{border-top:0;padding-top:0}
.thr__w{font-size:11px;color:var(--teks-3);margin-bottom:3px}
.thr__w b{color:var(--teks-2);font-weight:600}
.thr__b{font-size:13.5px;color:var(--teks-2);line-height:1.6}

/* Tagihan */
.tag-t{width:100%;border-collapse:collapse;font-size:14px}
.tag-t th{text-align:left;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;
  color:var(--teks-3);font-weight:600;padding:0 0 12px;border-bottom:1px solid var(--garis)}
.tag-t td{padding:15px 0;border-bottom:1px solid var(--garis);color:var(--teks-2);
  vertical-align:top}
.tag-t tr:last-child td{border-bottom:0}
.tag-t .nom{text-align:right;color:var(--teks);font-variant-numeric:tabular-nums;
  white-space:nowrap}
