  margin:0 auto 13px;border:2px solid var(--sel-2);background:var(--kanvas);
  color:transparent;position:relative}
.tahap__d svg{display:block}
.tahap__l--lewat .tahap__d{background:var(--isi);border-color:var(--isi);color:#062B25}
/* Cincin luar digambar sebagai lapisan PADAT sewarna kanvas, lalu warnanya di
   atasnya. Kalau memakai box-shadow tembus pandang, garis rel terlihat
   menembus titiknya — persis bug yang dilaporkan. */
.tahap__l--kini .tahap__d{border-color:var(--aksen);background:var(--aksen);color:#062B25}
.tahap__l--kini .tahap__d::before{content:"";position:absolute;inset:-7px;border-radius:99px;
  background:var(--kanvas);z-index:-2}
.tahap__l--kini .tahap__d::after{content:"";position:absolute;inset:-7px;border-radius:99px;
  background:rgba(45,212,191,.20);z-index:-1}
.tahap__n{display:block;font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;
  color:var(--teks-3);font-weight:600}
.tahap__l--lewat .tahap__n{color:var(--teks-2)}
.tahap__l--kini .tahap__n{color:var(--aksen)}
.tahap__t{display:block;margin-top:6px;font-size:11px;color:var(--teks-3);
  font-variant-numeric:tabular-nums}
.tahap__l--kini .tahap__t{color:var(--teks-2)}
/* z-index 0 sudah cukup: relnya disisipkan SESUDAH kolomnya di DOM, jadi tanpa
   .tahap__l{z-index:1} ia menang urutan cat dan menggores titiknya. */
.tahap__g{position:absolute;height:2px;background:var(--garis-2);z-index:0}
.tahap__g--isi{background:var(--isi)}

/* Ringkasan di bawah rel: tahap ke berapa, dan apa yang sedang dikerjakan */
.tahap-kaki{display:flex;gap:22px;align-items:flex-start;flex-wrap:wrap;
  padding:20px 34px 24px;border-top:1px solid var(--garis)}
.tahap-kaki__n{font-family:var(--judul);font-size:15px;color:var(--teks);white-space:nowrap}
.tahap-kaki__k{flex:1;min-width:240px;font-size:13.5px;color:var(--teks-2);line-height:1.6}
.batang{display:block;height:5px;background:var(--sel);position:relative;overflow:hidden;
  min-width:120px;margin-top:8px}
.batang i{display:block}
.batang i{position:absolute;left:0;top:0;bottom:0;background:var(--isi)}

/* "Yang menunggu Anda" — alasan halaman ini ada */
.tugas{display:flex;gap:14px;align-items:flex-start;padding:18px 0;
