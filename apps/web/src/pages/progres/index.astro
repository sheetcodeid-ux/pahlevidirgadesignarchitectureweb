.rangka-b::after{content:"";position:absolute;inset:0;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.06),transparent);
  animation:sapu 1.4s linear infinite}
@keyframes sapu{from{transform:translateX(-100%)}to{transform:translateX(100%)}}
@media (prefers-reduced-motion:reduce){.rangka-b::after{animation:none}}

/* Sampul: <img> begitu proyeknya punya foto, kotak berlabel kalau belum. */
.sampul img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}

/* Isian di halaman ini (catatan revisi, balasan, brief) — .isian sudah ada di
   publik.css; yang belum cuma bentuk textarea-nya. */
textarea.isian{min-height:96px;resize:vertical;line-height:1.6;font-family:var(--tubuh)}
.aksi-galat{color:var(--merah);font-size:12.5px;margin-top:8px}
.aksi-ok{color:var(--cincin);font-size:12.5px;margin-top:8px}

/* Bilah portal: bukan navigasi pemasaran. Klien di sini sudah masuk lewat
   tautannya sendiri, jadi yang berguna adalah identitas proyek + bahasa. */
.pbar{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.pbar__id{display:flex;align-items:center;gap:9px}
.bhs{display:inline-flex;border:1px solid var(--garis-2);border-radius:var(--r);overflow:hidden}
.bhs button{appearance:none;background:transparent;border:0;font-family:var(--tubuh);
  font-size:11.5px;font-weight:600;letter-spacing:.06em;color:var(--teks-3);padding:7px 12px;
  cursor:pointer;transition:all 180ms var(--e-halus)}
.bhs button + button{border-left:1px solid var(--garis-2)}
.bhs button[aria-pressed="true"]{background:rgba(45,212,191,.12);color:var(--aksen)}
.bhs button:hover{color:var(--teks)}

/* ── Tahap ────────────────────────────────────────────────────────────────
   Klien membuka halaman ini terutama untuk melihat baris ini, jadi tiap
   langkah membawa tanggalnya sendiri, bukan cuma nama. Titik yang sudah lewat
   memakai centang: bentuk terbaca lebih cepat daripada warna, dan tetap
   terbaca oleh orang yang tidak membedakan hijau. */
.tahap{display:grid;grid-auto-flow:column;grid-auto-columns:1fr;position:relative}
.tahap__l{position:relative;z-index:1;padding:26px 14px 22px;text-align:center;
  border-left:1px solid var(--garis)}
.tahap__l:first-child{border-left:0}
