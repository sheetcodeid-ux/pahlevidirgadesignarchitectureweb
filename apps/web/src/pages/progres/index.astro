.tugas__t{font-size:14.5px;font-weight:600;color:var(--teks);margin-bottom:4px}
.tugas__k{font-size:13px;color:var(--teks-2);line-height:1.6}
.tugas a{color:var(--aksen);text-decoration:none;border-bottom:1px solid rgba(45,212,191,.4)}

/* Dokumen */
.dok{border-top:1px solid var(--garis);padding:20px 0}
.dok:first-child{border-top:0;padding-top:0}
