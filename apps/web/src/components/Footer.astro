---
import { getSettings } from "../lib/api";

const settings = await getSettings();
const nama = settings.studioName?.trim() || "Dirga Pahlevi Architecture";
const tahun = new Date().getFullYear();
const kota = settings.city?.trim() || "Indonesia";

// Nomor Indonesia ditulis pemilik dengan 0 di depan; wa.me menolak bentuk itu
// dan minta format internasional tanpa tanda apa pun.
const waTautan = (nomor: string) => {
  const angka = nomor.replace(/[^\d+]/g, "");
  const intl = angka.startsWith("+") ? angka.slice(1) : angka.startsWith("0") ? `62${angka.slice(1)}` : angka;
  return `https://wa.me/${intl}`;
};

const situs = [
  { href: "/proyek", label: "Karya" },
  { href: "/studio", label: "Studio" },
  { href: "/jurnal", label: "Jurnal" },
  { href: "/kontak", label: "Kontak" },
];
const klien = [
  { href: "/progres", label: "Portal proyek" },
  { href: "/bukti", label: "Bukti pembayaran" },
  { href: "/faq", label: "Tanya jawab" },
];
// Baris kontak yang datanya belum diisi pemilik DIHILANGKAN, bukan ditulis
// kosong — tautan mati lebih buruk daripada tautan yang tidak ada.
const kontak = [
  settings.email ? { href: `mailto:${settings.email}`, label: settings.email } : null,
  settings.phone ? { href: waTautan(settings.phone), label: "WhatsApp" } : null,
  settings.instagramUrl ? { href: settings.instagramUrl, label: "Instagram" } : null,
].filter((x): x is { href: string; label: string } => x !== null);

const luar = (href: string) => /^https?:\/\//.test(href);
---

<div class="pita pita--akhir">
  <div class="dalam">
    <div class="baris b4">
      <div class="sel">
        <span class="rowx kaki-merek">
          {
            settings.logoUrl ? (
              <img src={settings.logoUrl} alt="" width="18" height="18" class="kaki-logo" />
            ) : (
              <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M10 1.5 18 6v8l-8 4.5L2 14V6l8-4.5Z" stroke="#2DD4BF" stroke-width="1.6" />
              </svg>
            )
          }
          <span class="label kaki-nama">{nama.toUpperCase()}</span>
        </span>
        <div class="s16"></div>
        <p class="dim kecil"><span>Studio arsitektur</span><br />{kota}</p>
      </div>

      <div class="sel">
        <span class="label label--redup">SITUS</span>
        <div class="s16"></div>
        <ul class="kaki-tautan">
          {situs.map((t) => (<li><a href={t.href}>{t.label}</a></li>))}
        </ul>
      </div>

      <div class="sel">
        <span class="label label--redup">KLIEN</span>
        <div class="s16"></div>
        <ul class="kaki-tautan">
          {klien.map((t) => (<li><a href={t.href}>{t.label}</a></li>))}
        </ul>
      </div>

      <div class="sel">
        <span class="label label--redup">KONTAK</span>
        <div class="s16"></div>
        {
          kontak.length ? (
            <ul class="kaki-tautan">
              {kontak.map((t) => (
                <li>
                  <a
                    href={t.href}
                    rel={luar(t.href) ? "noopener noreferrer" : undefined}
                    target={luar(t.href) ? "_blank" : undefined}
                  >
                    {t.label}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="dim kecil">Detail kontak diatur di panel studio.</p>
          )
        }
      </div>
    </div>

    <div class="baris">
      <div class="sel kaki-bawah">
        <span class="dim kecil">© {tahun} {nama}</span>
        <a class="dim kecil kaki-privasi" href="/privasi">Privasi</a>
      </div>
    </div>
  </div>
</div>

<style>
  /* publik.css tidak menyetel <a> secara global — sengaja, supaya tiap
     komponen memutuskan sendiri. Konsekuensinya tautan kaki yang tidak
     diberi aturan akan tampil biru bergaris bawah bawaan peramban. */
  /* Ukuran huruf harus di <li>, bukan cuma di <a>: kotak baris <li>
     memakai strut miliknya sendiri, jadi <li> 15px berisi <a> 13px tetap
     setinggi 15px×1,65. Di mockup ini satu <p> ber-<br>, dan selisihnya
     langsung jadi 13px di tinggi kaki. */
  .kaki-tautan {
    list-style: none;
    /* Padding saja membuat sasaran bersinggungan tepat di tepinya. Jarak 2px
       antar-baris memisahkannya tanpa menambah tinggi yang terasa. */
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
    font-size: 13px;
    line-height: 1.65;
  }
  .kaki-tautan a {
    display: inline-block;
    color: var(--teks-2);
    text-decoration: none;
    /* Di mockup isi kaki halaman TEKS BIASA (<p> + <br>) yang tidak bisa
       diklik sama sekali, jadi ia tidak punya masalah sasaran sentuh untuk
       dipecahkan. Begitu dijadikan tautan sungguhan, sepuluh sasaran setinggi
       21px berdempet tanpa jarak — terukur, dan di ponsel itu salah-tekan.
       WCAG 2.5.8 minta 24×24px; padding 3px membawanya ke 27px dengan
       ongkos tinggi yang paling kecil. */
    padding-block: 3px;
    /* Alamat email studio 220px dan tidak punya satu pun titik patah alami:
       di 390px ia mendorong dokumen jadi 432px. Di mockup isinya cuma
       "hello@…" sehingga tidak pernah terjadi — ini baru muncul dengan data
       sungguhan. */
    overflow-wrap: anywhere;
    max-width: 100%;
  }
  .kaki-tautan a:hover {
    color: var(--aksen);
  }
  .kaki-tautan a:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px var(--cincin);
  }
  .kaki-merek {
    gap: 9px;
  }
  .kaki-logo {
    width: 18px;
    height: 18px;
    flex: none;
    object-fit: contain;
  }
  .kaki-nama {
    letter-spacing: 0.14em;
  }
  .kaki-bawah {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    padding: 20px 32px;
  }
  .kaki-privasi {
    text-decoration: none;
  }
  .kaki-privasi:hover {
    color: var(--aksen);
  }
</style>
