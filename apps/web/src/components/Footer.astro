---
import { getSettings } from "../lib/api";

const year = new Date().getFullYear();
const settings = await getSettings();
const keterangan = settings.tagline || (settings.city ? `Arsitektur & Interior — ${settings.city}` : "Arsitektur & Interior — Indonesia");
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <div>
      <p class="footer-name">{settings.studioName}</p>
      <p class="footer-note">{keterangan}</p>
    </div>
    <div>
      {settings.email && (
        <p class="footer-note">
          <a href={`mailto:${settings.email}`}>{settings.email}</a>
        </p>
      )}
      <p class="footer-note">&copy; {year}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: clamp(var(--space-7), 8vw, var(--space-8));
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    padding-block: 3rem;
  }

  .footer-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
  }

  .footer-note {
    font-size: 0.85rem;
    color: var(--text-faint);
    margin: 0;
  }
</style>
