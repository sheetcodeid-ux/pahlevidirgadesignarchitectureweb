---
import { CATEGORY_LABELS, type Project } from "../lib/api";

interface Props {
  project: Project;
  /** Kartu pertama di viewport dimuat eager supaya LCP tidak tertunda. */
  priority?: boolean;
  /**
   * Tingkat judul kartu. Bawaannya h3 karena di beranda kartu berada di bawah
   * judul seksi; di halaman arsip tidak ada seksi di atasnya, jadi h3 membuat
   * kerangka judul melompat h1 → h3.
   */
  level?: 2 | 3;
}

const { project, priority = false, level = 3 } = Astro.props;
const Judul = `h${level}` as "h2" | "h3";
const meta = [project.city ?? project.location, project.year].filter(Boolean).join(" · ");
---

<li class="card" data-category={project.category}>
  <a href={`/proyek/${project.slug}`}>
    {
      project.coverImageUrl ? (
        <img
          src={project.coverImageUrl}
          alt={`Foto proyek ${project.title}`}
          loading={priority ? "eager" : "lazy"}
          decoding="async"
          fetchpriority={priority ? "high" : "auto"}
        />
      ) : (
        <div class="placeholder" aria-hidden="true" />
      )
    }
    <div class="caption">
      <p class="category">{CATEGORY_LABELS[project.category]}</p>
      <Judul>{project.title}</Judul>
      {meta && <p class="meta">{meta}</p>}
    </div>
  </a>
</li>

<style>
  .card a {
    display: block;
    text-decoration: none;
  }

  .card img,
  .placeholder {
    aspect-ratio: 4 / 3;
    width: 100%;
    object-fit: cover;
    background: var(--surface-raised);
    transition: opacity 0.3s ease;
  }

  .card a:hover img {
    opacity: 0.88;
  }

  .caption {
    padding-top: 1rem;
  }

  /* Judul dipatok ke bentuk h3 apa pun tingkatnya. Tingkat judul di sini
     urusan kerangka halaman, bukan urusan ukuran huruf — kartu di arsip harus
     terlihat persis sama dengan kartu di beranda. */
  .caption :is(h2, h3) {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--text-xl);
    line-height: 1.25;
    letter-spacing: normal;
  }

  .category {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-faint);
    margin: 0 0 0.35rem;
  }

  .meta {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0.35rem 0 0;
  }
</style>
