---
import { getSettings } from "../lib/api";

const settings = await getSettings();
const nama = settings.studioName?.trim() || "Dirga Pahlevi Architecture";

// Wordmark di pita nav memakai bentuk pendek — kata generik di ekor nama
// ("Architecture", "Studio") dibuang supaya tidak memakan setengah bilah.
// Kalau pemilik mengganti nama studionya, ini tetap ikut; yang tetap
// dibuang cuma ekornya.
const EKOR = /\s+(architecture|architects|architect|studio|design|designs)$/i;
const wordmark = nama.replace(EKOR, "").toUpperCase();

const tautan = [
  { href: "/proyek", label: "Work", t: "navWork" },
  { href: "/studio", label: "Studio", t: "navStudio" },
  { href: "/jurnal", label: "Journal", t: "navJournal" },
  { href: "/kontak", label: "Contact", t: "navContact" },
];

const kini = Astro.url.pathname;
const aktif = (href: string) =>
  href === "/" ? kini === "/" : kini === href || kini.startsWith(href + "/");

---

<a href="#isi" class="lompat" data-t="lompat">Skip to content</a>
<div class="bar-atas" id="barAtas"></div>

<div class="pita pita--awal nav" id="nav">
  <div class="dalam">
    <div class="isi isi--rapat nav-utama nav-baris">
      <a href="/" class="merek" aria-label={`${nama}, ke beranda`}>
        {
          settings.logoUrl ? (
            <img src={settings.logoUrl} alt="" class="merek__logo" width="20" height="20" />
          ) : (
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M10 1.5 18 6v8l-8 4.5L2 14V6l8-4.5Z" stroke="#2DD4BF" stroke-width="1.6" />
              <path
                d="M10 6.5 14 9v4l-4 2.2L6 13V9l4-2.5Z"
                fill="#2DD4BF"
                fill-opacity=".25"
                stroke="#2DD4BF"
                stroke-width="1.2"
              />
            </svg>
          )
        }
        <span class="label merek__teks">{wordmark}</span>
      </a>

      <nav class="rowx nav-lipat nav-tautan" aria-label="Main">
        {
          tautan.map((t) => (
            <a href={t.href} aria-current={aktif(t.href) ? "page" : undefined} data-t={t.t}>
              {t.label}
            </a>
          ))
        }
      </nav>

      <span class="rowx nav-kanan">
        {/* Pemisah tegak antara tautan navigasi dan kelompok aksi, mengikuti
            acuan pemilik. Disembunyikan bersama .nav-lipat di ponsel — di
            sana kelompok kirinya memang tidak ada. */}
        <span class="nav-pisah nav-lipat" aria-hidden="true"></span>
        <span class="bhs nav-lipat" role="group" aria-label="Language">
          <button type="button" data-bhs="en" aria-pressed="true">EN</button>
          <button type="button" data-bhs="id" aria-pressed="false">ID</button>
        </span>
        <a class="btn btn--isi btn--dot nav-lipat" href="/kontak" data-t="mulaiProyek">Start a project</a>
        <button class="nav-tombol" id="bukaLaci" aria-label="Open menu" aria-expanded="false">
          <svg width="19" height="19" viewBox="0 0 20 20" stroke="currentColor" stroke-width="1.6"
            ><path d="M2 6h16M2 14h16"></path></svg
          >
        </button>
      </span>
    </div>
  </div>
</div>

<dialog class="laci" id="laci" aria-label="Menu">
  <div class="laci__kop">
    <span class="label merek__teks">{wordmark}</span>
    <button class="nav-tombol laci__x" id="tutupLaci" aria-label="Close menu">
      <svg width="19" height="19" viewBox="0 0 20 20" stroke="currentColor" stroke-width="1.6"
        ><path d="M5 5l10 10M15 5L5 15"></path></svg
      >
    </button>
  </div>
  {tautan.map((t) => (<a href={t.href}><span data-t={t.t}>{t.label}</span> <span class="ak">→</span></a>))}
  <div class="laci__kaki">
        <a class="btn btn--isi btn--dot btn--penuh" href="/kontak" data-t="mulaiProyekPanah">Start a project →</a>
        <div class="s16"></div>
        {/* Pengalihnya juga di laci: di ponsel yang di bilah atas disembunyikan
            .nav-lipat, dan tanpa ini bahasa tidak bisa diganti dari ponsel
            sama sekali. */}
        <span class="bhs" role="group" aria-label="Language">
          <button type="button" data-bhs="en" aria-pressed="true">EN</button>
          <button type="button" data-bhs="id" aria-pressed="false">ID</button>
        </span>
  </div>
</dialog>

<style>
  /* Gaya khusus chrome nav. Sisanya — .pita, .dalam, .isi, .status, .btn —
     datang dari publik.css dan sengaja TIDAK diulang di sini. */
  /* Tiga kolom, bukan flex: tautan harus duduk di TENGAH BILAH — bukan di
     tengah sisa ruang setelah merek. Dengan flex, panjang wordmark studio
     ikut menggeser tautannya, dan wordmark itu datang dari setelan yang bisa
     diubah pemilik kapan saja.

     Kolomnya disebut satu per satu supaya di ponsel — waktu tautan tengah
     kena display:none — merek tetap di kiri dan aksinya tetap di kanan,
     bukan naik ke kolom yang kosong. */
  .nav-baris {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 28px;
  }
  .merek {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 0;
  }

  .merek__logo {
    width: 20px;
    height: 20px;
    flex: none;
    object-fit: contain;
  }
  .merek__teks {
    letter-spacing: 0.14em;
  }
  .merek {
    grid-column: 1;
    justify-self: start;
  }
  .nav-tautan {
    grid-column: 2;
    justify-self: center;
    gap: 24px;
  }
  .nav-kanan {
    grid-column: 3;
    justify-self: end;
  }
  .laci__kop {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid var(--garis);
  }
  /* .nav-tombol disembunyikan di layar lebar oleh publik.css; tombol tutup
     di dalam laci harus tetap ada berapa pun lebar layarnya. */
  .laci__x {
    display: grid;
  }
  .laci__kaki {
    padding: 24px;
  }
</style>

<script>
  (() => {
    "use strict";
    const nav = document.getElementById("nav");
    const laci = document.getElementById("laci") as HTMLDialogElement | null;
    const buka = document.getElementById("bukaLaci");
    const tutup = document.getElementById("tutupLaci");
    if (!nav || !laci || !buka || !tutup) return;

    /* Nav yang menyingkir saat menggulir ke bawah.
     *
     * Bar kemajuan TIDAK lagi diurus di sini: ia digerakkan timeline gulir
     * milik CSS (lihat .bar-atas di publik.css). Versi lama membaca
     * `document.body.scrollHeight` lalu menulis `bar.style.width` di tiap
     * peristiwa gulir — baca-tulis-baca yang MEMAKSA layout sinkron tiap
     * frame. Terukur 203 kali layout per satu lintasan gulir beranda, dan
     * itulah "gulir pertama tertahan" yang dilaporkan pemilik: pada lintasan
     * pertama gambarnya baru berdatangan, jadi tiap layout paksa benar-benar
     * menata ulang halaman penuh alih-alih memakai hasil sebelumnya.
     *
     * Yang tersisa di bawah hanya membaca `scrollY` — nilai yang memang sudah
     * dipegang peramban dan tidak memicu layout apa pun — lalu menyentuh DOM
     * di dalam rAF, jadi paling banyak sekali tulis per frame.
     *
     * Peramban yang belum mendukung `animation-timeline` (Firefox saat ini)
     * tidak dapat bar kemajuannya. Itu hiasan, bukan isi — dan menghidupkan
     * kembali jalur JS-nya berarti mengembalikan persis kebiasaan yang baru
     * saja dibuang. */
    let lalu = 0;
    let antre = false;
    addEventListener(
      "scroll",
      () => {
        if (antre) return;
        antre = true;
        requestAnimationFrame(() => {
          antre = false;
          const y = scrollY;
          if (y > 140 && y > lalu) nav.classList.add("nav--sembunyi");
          else if (y < lalu) nav.classList.remove("nav--sembunyi");
          lalu = y;
        });
      },
      { passive: true },
    );

    buka.addEventListener("click", () => {
      laci.showModal();
      buka.setAttribute("aria-expanded", "true");
    });
    tutup.addEventListener("click", () => laci.close());
    laci.addEventListener("close", () => buka.setAttribute("aria-expanded", "false"));
    laci.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => laci.close()));
  })();
</script>
