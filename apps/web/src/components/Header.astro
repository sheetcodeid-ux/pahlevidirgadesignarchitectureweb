---
import { ThemeToggle } from "./ui/ThemeToggle";
import { getSettings } from "../lib/api";

const links = [
  { href: "/proyek", label: "Proyek" },
  { href: "/tentang", label: "Tentang" },
  { href: "/faq", label: "FAQ" },
  { href: "/kontak", label: "Kontak" },
];

const current = Astro.url.pathname;
const settings = await getSettings();
const nama = settings.studioName?.trim() || "Dirga Pahlevi Architecture";
---

<header class="site-header">
  <div class="shell">
    <div class="header-pill">
      {/* Nama studio diberi lantai. Kalau API membalas bentuk yang tak terduga,
          tautan ini jadi kotak kosong yang bisa diklik tanpa satu pun teks —
          dan pembaca layar cuma menyebutnya "tautan". aria-label menjaga
          namanya tetap ada apa pun yang dibalas API. */}
      <a href="/" class="wordmark" aria-label={`${nama}, ke beranda`}>
        {settings.logoUrl && <img src={settings.logoUrl} alt="" class="wordmark__logo" />}
        {nama}
      </a>

      <nav class="header-nav" aria-label="Navigasi utama">
        <ul>
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={current.startsWith(link.href) ? "page" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="header-actions">
        <ThemeToggle client:load />
      </div>
    </div>
  </div>
</header>

<style>
  /* Bar mengambang, bukan menempel ke tepi — jarak atasnya bagian dari
     kotak sticky ini sendiri, supaya konten yang lewat di baliknya tetap
     terlihat sekilas lewat celahnya, bukan disembunyikan warna solid. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    padding-top: var(--space-4);
  }

  .header-pill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    flex-wrap: wrap;
    padding: 0.85rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    backdrop-filter: blur(10px);
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 1.2rem;
    letter-spacing: 0.02em;
    text-decoration: none;
    flex: none;
  }

  .wordmark__logo {
    width: 1.75rem;
    height: 1.75rem;
    flex: none;
    border-radius: var(--radius-sm);
    object-fit: cover;
  }

  .header-nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .header-nav ul {
    display: flex;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header-nav a {
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-muted);
  }

  .header-nav a:hover,
  .header-nav a[aria-current="page"] {
    color: var(--text-strong);
  }

  .header-actions {
    display: flex;
    align-items: center;
    flex: none;
  }

  @media (max-width: 40rem) {
    .header-pill {
      justify-content: center;
    }

    .header-nav {
      order: 3;
      flex: 1 0 100%;
      justify-content: center;
    }
  }
</style>
