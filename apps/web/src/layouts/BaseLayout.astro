---
// Situs publik memakai sistem visualnya sendiri (kisi cetak biru, sudut siku,
// warna refine.dev) — BUKAN global.css/components.css milik panel admin.
// AdminLayout tetap memuat rantai lamanya; keduanya tidak pernah bertemu di
// satu halaman, jadi nama tokennya boleh sama-sama hidup.
import "../styles/publik.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { gambarBagikan, getSettings } from "../lib/api";
import { KAMUS_UMUM } from "../lib/i18n";

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Data terstruktur tambahan khusus halaman ini (proyek, remah roti). */
  jsonLd?: unknown[];
}

const {
  title,
  description = "An architecture studio in Pontianak, Indonesia, working on hospitality interiors and tropical houses for the equatorial climate.",
  image,
  noindex = false,
  jsonLd = [],
} = Astro.props;

const settings = await getSettings();
const fotoCadangan = await gambarBagikan();

const canonical = new URL(Astro.url.pathname, Astro.site);
const studioName = settings.studioName || "Dirga Pahlevi Architecture";

// Gambar kartu bagikan, berjenjang: yang diminta halaman dulu, lalu foto
// proyek unggulan, baru logo studio. Foto sengaja didahulukan dari logo —
// yang membuat orang membuka tautan di WhatsApp adalah bangunannya, bukan
// lambangnya. Gambar dari R2 sudah absolut dan tidak boleh diubah; `new URL`
// dengan basis situs justru merusaknya. Yang perlu dijadikan absolut hanya
// path relatif milik situs sendiri.
const absolut = (u: string) => (/^https?:\/\//.test(u) ? u : new URL(u, Astro.site).href);
const kandidatGambar = image ?? fotoCadangan ?? settings.logoUrl ?? undefined;
const ogImage = kandidatGambar ? absolut(kandidatGambar) : undefined;

// Profil studio untuk mesin pencari. Kolom yang belum diisi pemilik
// dihilangkan, bukan dikirim kosong — field kosong lebih buruk daripada
// tidak ada field, karena mesin pencari menganggapnya jawaban.
// Mesin pencari membaca nomor dalam format internasional. Nomor Indonesia
// ditulis pemilik dengan 0 di depan; itu diubah ke +62 hanya untuk data
// terstruktur — yang tampil di halaman tetap seperti yang dia ketik.
const telepon = (nomor: string) => {
  const angka = nomor.replace(/[^\d+]/g, "");
  return angka.startsWith("0") ? `+62${angka.slice(1)}` : angka;
};

// addressRegion tidak ada di setelan studio, jadi ia ditulis tangan di sini.
// Karena itu ia hanya boleh ikut selama kotanya masih Pontianak — kalau
// pemilik pindah kota, provinsi tebakan lebih buruk daripada tidak ada.
const kota = settings.city ?? "Pontianak";
const provinsi = kota.toLowerCase() === "pontianak" ? { addressRegion: "Kalimantan Barat" } : {};

const kontakStudio = {
  "@context": "https://schema.org",
  "@type": "ArchitecturalService",
  "@id": new URL("/#studio", Astro.site).href,
  name: studioName,
  url: Astro.site?.href,
  areaServed: settings.city ?? "Pontianak, Kalimantan Barat",
  ...(settings.tagline ? { description: settings.tagline } : {}),
  ...(settings.email ? { email: settings.email } : {}),
  ...(settings.phone ? { telephone: telepon(settings.phone) } : {}),
  ...(settings.logoUrl ? { logo: absolut(settings.logoUrl), image: absolut(settings.logoUrl) } : {}),
  ...(settings.instagramUrl ? { sameAs: [settings.instagramUrl] } : {}),
  address: {
    "@type": "PostalAddress",
    ...(settings.address ? { streetAddress: settings.address } : {}),
    addressLocality: kota,
    ...provinsi,
    addressCountry: "ID",
  },
};

const dataTerstruktur = [kontakStudio, ...jsonLd];
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — {studioName}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={studioName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />

    {/* Menyalakan penanda `js` SEBELUM badan halaman dilukis. Keadaan awal
        animasi masuk (transparan, turun 18px) hanya berlaku di bawah penanda
        ini — jadi tanpa JS halamannya tetap terbaca penuh, dan dengan JS
        tidak pernah ada kedipan "terlihat lalu disembunyikan". */}
    <script is:inline>document.documentElement.classList.add("js");</script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />


    {
      dataTerstruktur.map((data) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
      ))
    }
  </head>

  <body>
    <Header />
    <main id="isi">
      <slot />
    </main>
    <Footer />
    {/* ═══ PENGALIH BAHASA ══════════════════════════════════════════════
        Menukar isi tiap elemen bertanda data-t. Yang INGGRIS tidak disimpan
        di kamus: ia sudah ada di markup, dan disimpan sendiri oleh skrip ini
        sebelum penukaran pertama — jadi kembali ke EN selalu mengembalikan
        kalimat yang persis sama, bukan salinan yang bisa menyimpang.

        is:inline + define:vars: kamusnya perlu ikut ke halaman, dan halaman
        ini statis, jadi tidak ada tempat lain untuk menaruhnya. */}
    <script is:inline define:vars={{ KAMUS_UMUM }}>
      (() => {
        "use strict";
        const KUNCI = "situs:bhs";

        /* Kamus khusus halaman, kalau halamannya menyediakan. Beranda memuat
           seluruh kalimat pemasarannya sendiri lewat tag ini. */
        let kamus = KAMUS_UMUM;
        const tambahan = document.getElementById("kamus-halaman");
        if (tambahan && tambahan.textContent) {
          try { kamus = { ...KAMUS_UMUM, ...JSON.parse(tambahan.textContent) }; }
          catch { /* JSON rusak: kamus umum saja, halaman tetap jalan */ }
        }

        const elemen = document.querySelectorAll("[data-t]");

        function pasang(bhs) {
          elemen.forEach((el) => {
            /* Simpan aslinya SEKALI, saat pertama disentuh. Kalau disimpan di
               akhir penukaran, yang tersimpan sudah versi Indonesianya. */
            if (el.dataset.en === undefined) el.dataset.en = el.innerHTML;
            const id = kamus[el.dataset.t];
            if (bhs === "id" && id !== undefined) el.innerHTML = id;
            else el.innerHTML = el.dataset.en;
          });
          document.documentElement.lang = bhs === "id" ? "id" : "en";
          document.querySelectorAll("[data-bhs]").forEach((b) =>
            b.setAttribute("aria-pressed", String(b.dataset.bhs === bhs)));
        }

        let bhs = "en";
        try { if (localStorage.getItem(KUNCI) === "id") bhs = "id"; } catch { /* diblokir */ }
        if (bhs === "id") pasang("id");
        else document.querySelectorAll("[data-bhs]").forEach((b) =>
          b.setAttribute("aria-pressed", String(b.dataset.bhs === "en")));

        document.querySelectorAll("[data-bhs]").forEach((b) =>
          b.addEventListener("click", () => {
            const pilih = b.dataset.bhs === "id" ? "id" : "en";
            pasang(pilih);
            try { localStorage.setItem(KUNCI, pilih); } catch { /* diblokir */ }
          }));
      })();
    </script>

    <script is:inline>
      /* ── Gulir yang dicuri penampung mendatar ──────────────────────────
         Gejalanya yang dilaporkan pemilik: "dari atas geser ke bawah seperti
         tertahan sedikit lalu jump ke bawah", tertahannya di bagian klien
         terpilih. Sebabnya bukan patah-patah — frame-nya baik-baik saja.

         Sebabnya penampung yang bisa digulir MENDATAR (galeri foto, bilah
         tab). Gerakan dua jari di trackpad tidak pernah lurus; begitu ada
         sedikit komponen mendatar, peramban mengunci SELURUH gerakan itu ke
         penampung mendatar yang sedang dilewati kursor — termasuk komponen
         tegaknya. Halamannya lalu berhenti maju sampai gerakannya habis,
         baru melompat menyusul.

         Terukur di beranda, kursor di tengah layar, gerakan turun 110px
         serong 6px: halaman berhenti di scrollY 1650 (persis di pita KLIEN
         TERPILIH) dan tidak maju lagi — 25 dari 40 putaran roda hilang,
         sementara galerinya bergeser sendiri 15px.

         Yang TIDAK menolong, sudah diuji satu per satu: scroll-snap
         proximity, mematikan snap sama sekali, dan overscroll-behavior-x —
         ketiganya tetap 25/40 macet, karena penguncian itu terjadi sebelum
         snap ikut bicara. Yang menolong hanya meneruskan komponen tegaknya
         sendiri: 0 dari 40 macet, halaman maju 4400px.

         Syaratnya passive:false — tanpa itu preventDefault diabaikan diam-
         diam. Dan hanya gerakan yang DIDOMINASI tegak yang diambil alih;
         geseran mendatar sungguhan tetap milik galerinya. */
      (() => {
        "use strict";
        const mendatar = (el) => {
          const g = getComputedStyle(el).overflowX;
          return (g === "auto" || g === "scroll") && el.scrollWidth > el.clientWidth + 2;
        };
        addEventListener("wheel", (e) => {
          if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
          let el = e.target instanceof Element ? e.target : null;
          for (; el && el !== document.body; el = el.parentElement) {
            /* Penampung yang bisa digulir TEGAK berhak atas gerakan ini —
               jangan dirampas darinya (mis. dialog panjang, laci menu). */
            const g = getComputedStyle(el).overflowY;
            if ((g === "auto" || g === "scroll") && el.scrollHeight > el.clientHeight + 2) return;
            if (mendatar(el)) break;
          }
          if (!el || el === document.body) return;
          e.preventDefault();
          /* deltaMode 1 berarti satuannya BARIS, bukan piksel — Firefox
             memakainya. Tanpa penyetaraan ini gulirnya jadi 15x lebih pelan. */
          const px = e.deltaMode === 1 ? e.deltaY * 16 : e.deltaMode === 2 ? e.deltaY * innerHeight : e.deltaY;
          scrollBy({ top: px, behavior: "instant" });
        }, { passive: false });
      })();
    </script>
  </body>
</html>
