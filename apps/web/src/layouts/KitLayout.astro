---
import "../styles/global.css";
import "../styles/kit.css";
import "../styles/kit-komponen.css";
/* overlay.css (sistem lama) TIDAK dimuat lagi: seluruh dialog, menu, dan
   toast halaman kit kini komponen kit (components/kit/Overlay, Toast) yang
   gayanya di kit-komponen.css. Kalau ada kelas .ov-* yang muncul di halaman
   kit, itu sisa komponen lama — dan ia akan tergambar tanpa gaya (jebakan #5). */
import "../styles/terbit-kit.css";
import { ClientRouter } from "astro:transitions";
import { RelKit } from "../components/admin/RelKit";
import { KepalaKit } from "../components/admin/KepalaKit";
import { KakiHalaman } from "../components/kit/Item";
import { Remah, type SatuRemah } from "../components/kit/Remah";
import { CAP_BUILD } from "../lib/capBuild";

/* =============================================================================
   Kerangka panel admin versi KIT — frame Coinest.

   Hidup BERDAMPINGAN dengan AdminLayout, tidak menggantikannya. Halaman
   dipindahkan satu per satu (P4), dan yang belum pindah tetap memakai
   kerangka lama; itu rencana yang sudah ditulis di CLAUDE.md sejak awalan
   `k-` dipilih. Menukar AdminLayout sekaligus berarti keempat belas halaman
   berubah dalam satu putaran, dan tidak satu pun sempat diukur.

   Ukuran kerangkanya, dari frame 1440 lebar:

     rel samping   0 → 192        latar #ECF4E9
     talang kiri   192 → 220      28
     kolom konten  220 → 1412     1192
     talang kanan  1412 → 1440    28
     kepala        y22, tinggi 38
     badan         mulai y80      (jarak 20 dari kepala)
     kaki          y1028,2        (jarak 22,7 dari dasar badan)

   Latar halamannya PUTIH; yang mint cuma rel sampingnya. Membaca itu dari
   SVG-nya menyesatkan — di sana ada rect mint 1440x1072 DAN rect putih
   1440x1072, dan yang menang tergantung urutan gambar. Yang menjawab
   melihat framenya sebagai gambar.
   ============================================================================= */

interface Props {
  title: string;
  /** Judul di kepala halaman. Jatuh ke `title` kalau kosong. */
  judul?: string;
  /** Alamat tombol panah kembali di kiri judul — frame detail Coinest. */
  kembali?: string;
  /**
   * Rel kanan 305px — frame "37. Insights". Isinya TIDAK lewat slot: island
   * halamannya mengisinya lewat portal ke `#kl-relkanan`, supaya data yang
   * sama tidak diambil dua island (dan cache cuma ditulis pemiliknya,
   * jebakan #8).
   */
  relKanan?: boolean;
  /**
   * Remah di atas isi — hanya halaman DETAIL (yang punya `kembali`): di sana
   * rel samping tidak menandai letaknya, dan "Detail Tulisan" sendirian tidak
   * bilang tulisan itu milik bagian mana. Halaman daftar tidak memakainya;
   * rel sudah menandai barisnya.
   */
  remah?: SatuRemah[];
}

const { title, judul, kembali, relKanan, remah } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<!-- transition:animate="none" di <html>: tanpa ini router memakai animasi
     bawaan (pudar silang) untuk SELURUH dokumen kecuali <main>, dan judul di
     kepala halaman tergambar tumpang-tindih ±120 ms ("Tugas" di atas "Info
     Studio") tiap pindah menu — dilaporkan pemilik sebagai "efek". -->
<html lang="id" data-theme="light" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} — Admin Dirga Pahlevi Architecture</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Urbanist:wght@400;500;600;700&display=swap"
    />

    <ClientRouter fallback="none" />

    <script is:inline>
      (function () {
        try {
          var simpan = localStorage.getItem("tema");
          var sistem = window.matchMedia("(prefers-color-scheme: light)").matches
            ? "light"
            : "dark";
          document.documentElement.setAttribute("data-theme", simpan || sistem);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>

    <script is:inline>
      (function () {
        // Tema. Astro menyalin atribut <html> dari dokumen baru, dan dokumen
        // baru selalu berisi data-theme="light" hasil build.
        document.addEventListener("astro:before-swap", function (e) {
          var tema = document.documentElement.getAttribute("data-theme");
          if (tema) e.newDocument.documentElement.setAttribute("data-theme", tema);
        });
        // Overlay yang sedang terbuka menempel di <body> lewat portal, di luar
        // bagian yang ikut ditukar.
        document.addEventListener("astro:before-preparation", function () {
          document.dispatchEvent(new KeyboardEvent("keydown", { key: "Escape", bubbles: true }));
        });
      })();
    </script>

    {/* Halaman tujuan dihangatkan saat kursor menyentuh tautannya —
        HTML, CSS, dan modul island-nya. Lihat lib/hangat.ts. */}
    <script>
      import { pasangHangat } from "../lib/hangat";
      pasangHangat();
    </script>
  </head>

  <body class="kl-body">
    <a href="#konten" class="sr-only">Lewati ke konten</a>

    <div class={relKanan ? "kl kl--relkanan" : "kl"}>
      {/* transition:persist — rel samping tidak dipasang ulang tiap pindah
          halaman. Ia tidak punya keadaan internal, tapi memasang ulang 12
          baris ikon SVG di tiap klik menu adalah kerja yang tidak menghasilkan
          apa-apa. */}
      <RelKit client:load transition:persist path={path} namaStudio="Dirga Pahlevi" />

      <div class="kl__utama">
        {/* Selalu dihidrasi: tombol Terbitkan di dalamnya hidup dari JavaScript
            (status build, polling). Stempel build dipanggang ke HTML di sini,
            sama seperti AdminLayout — panel ini hasil build yang sama dengan
            situs publiknya, jadi ia satu-satunya yang tahu umur dirinya. */}
        <KepalaKit client:load judul={judul ?? title} kembali={kembali} dibangunPada={CAP_BUILD} />

        {remah && <Remah jalur={remah} className="kl__remah" />}

        <main id="konten" class={remah ? "kl__isi kl__isi--remah" : "kl__isi"} transition:animate="none">
          <slot />
        </main>

        <KakiHalaman
          hakCipta={`© ${new Date().getFullYear()} Dirga Pahlevi Architecture`}
          tautan={[
            { label: "Kebijakan Privasi", href: "/privasi" },
            { label: "Pertanyaan Umum", href: "/faq" },
            { label: "Kontak", href: "/kontak" },
          ]}
        />
      </div>
      {relKanan && <aside id="kl-relkanan" class="kl__relkanan" aria-label="Ringkasan halaman"></aside>}
    </div>
  </body>
</html>

<style is:global>
  /* Latar halaman abu tipis (--k-latar), kartu putih di atasnya. Frame
     Coinest berlatar putih; diganti atas permintaan pemilik ("latar putih
     terasa mati"). Yang mint tetap cuma rel sampingnya. */
  .kl-body {
    margin: 0;
    background: var(--k-latar);
    font-family: var(--font-sans);
  }

  .kl {
    /* 240, bukan 192 milik frame Coinest. Rel 192 dirancang untuk label
       Inggris yang pendek; terukur di sini 17 dari 32 label menu terpotong
       ("Terima Pem…", "Pengatu…", "Pesan M…") — label terpanjang, "Terima
       Pembayaran", butuh 127px sementara barisnya cuma menyisakan 84. Pada
       240 seluruhnya tampil utuh. Satu-satunya tempat angka ini disetel:
       latar mint di bawah dan lebar rel membacanya dari variabel yang sama.
       Galeri kit (/admin/kit) tetap 192 karena dipakai membandingkan
       komponennya dengan frame.

       Rel yang 48px lebih lebar berarti kolom konten 48px lebih SEMPIT pada
       lebar layar yang sama. Seluruh titik-patah halaman kit (1240, 1360,
       1200, 1100, 1000, 60rem) dirancang untuk rel 192, jadi semuanya ikut
       digeser +48 (1288, 1408, 1248, 1148, 1048, 63rem) — tata letak tablet
       tetap menyala pada lebar KONTEN yang sama seperti sebelumnya. Tanpa
       itu, di antara 1241 dan 1288 halaman tetap bertata-letak desktop di
       kolom yang lebih sempit dari yang pernah diuji: tombol "Tambah tugas"
       terukur keluar kartunya 21px pada 1280. Kalau angka 240 ini diubah,
       geser titik-patah itu sebesar selisihnya. 40rem tidak ikut: di
       bawahnya rel sudah jadi menu geser. */
    --kl-rel: 240px;
    display: flex;
    min-height: 100vh;
    /* Mint rel sampingnya dilukis DI SINI juga, bukan cuma di .k-sisi.
       Sebabnya: .k-sisi menempel (`sticky`) dan karena itu setinggi viewport,
       sementara halamannya lebih panjang — jadi mintnya berhenti di tengah
       jalan dan sisanya putih. Terlihat jelas di tangkapan layar halaman
       penuh. Gradien ini setinggi .kl, yang memang ikut isi halaman. */
    background: linear-gradient(
      to right,
      var(--brand-soft) 0 var(--kl-rel, 192px),
      transparent var(--kl-rel, 192px)
    );
  }
  /* Rel samping menempel; isinya yang bergulir. Tanpa ini menu ikut hilang ke
     atas di halaman yang panjang — dan di frame Coinest rel itu setinggi
     kanvas, jadi ia memang tidak pernah bergulir. */
  /* `.kl #kl-rel` — berid, bukan `.kl .k-sisi`: galeri UI Component memuat
     contoh SisiNav di dalam .kl, dan aturan berkelas ikut membuat contoh itu
     menempel setinggi layar (terukur 240x900). BUKAN `.kl > .k-sisi` — jebakan #1 di CLAUDE.md. RelKit
     dihidrasi (`client:load`), jadi Astro membungkusnya dengan
     `<astro-island>` ber-`display: contents`. Tata letaknya berperilaku
     seolah rel itu anak langsung .kl, tapi bagi selektor CSS pembungkusnya
     tetap ada — dan seluruh aturan di bawah ini diam-diam tidak pernah
     menyala. Gejalanya: rel setinggi ISINYA (600) alih-alih setinggi
     viewport, dan mintnya berhenti di tengah halaman. */
  .kl #kl-rel {
    position: sticky;
    top: 0;
    flex: none;
    width: var(--kl-rel);
    height: 100vh;
    /* Rel lengket setinggi layar HARUS bergulir sendiri. Dengan kelompok
       Situs Publik terbuka, baris terakhir berakhir di y936 — di layar
       setinggi 800 (MacBook dengan bilah peramban) baris Pengaturan dan
       Keluar tergambar di bawah tepi layar, dan karena relnya lengket,
       menggulir halaman tidak pernah membawanya naik. */
    overflow-y: auto;
    overscroll-behavior: contain;
    /* Batang gulirnya disembunyikan. Di Windows (komputer kantor) batang
       klasik 17px muncul begitu relnya meluap dan memotong setiap label menu
       17px lebih pendek; di macOS batangnya melayang dan tidak memakan
       tempat. Menggulir tetap jalan lewat roda, trackpad, sentuh, dan Tab. */
    scrollbar-width: none;
  }
  .kl #kl-rel::-webkit-scrollbar { display: none; }
  .kl__logo {
    display: block;
    padding-top: 30px;
    font-size: var(--k-t16);
    font-weight: var(--k-bold);
    color: var(--brand);
  }

  .kl__utama {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
    /* 22 atas / 28 samping / 24 bawah — talang framenya. */
    padding: 22px 28px 24px;
  }
  /* 20 dari kepala ke badan, 22,7 dari badan ke kaki. Keduanya diukur dari
     framenya, bukan dipilih: kepala berakhir di y60 dan badan mulai y80;
     badan berakhir 1005,5 dan tinta kaki mulai 1028,2. */
  .kl__isi {
    flex: 1;
    margin-top: 20px;
  }
  .kl__remah { margin-top: 14px; }
  .kl__isi--remah { margin-top: 12px; }
  .kl__utama > .k-kakihal {
    margin-top: 22.7px;
  }

  /* Rel kanan frame 37: 305 lebar, bergaris kiri, isinya 248 di x+29. Ia
     menempel seperti rel kiri, dan bergulir sendiri kalau isinya lebih tinggi
     dari layar. */
  .kl__relkanan {
    position: sticky;
    top: 0;
    flex: none;
    align-self: flex-start;
    width: 305px;
    height: 100vh;
    padding: 25.5px 28px 24px 28px;
    overflow-y: auto;
    scrollbar-width: thin;
  }
  /* Garis kiri rel kanan dilukis di .kl, bukan di rel-nya — alasan yang sama
     dengan mint rel kiri: rel yang menempel setinggi viewport, halamannya
     lebih panjang, dan garisnya berhenti di tengah jalan. */
  .kl--relkanan {
    background:
      /* 100% - 304: persentase posisi dihitung dari (lebar - 1px), jadi garis 1px ini jatuh tepat di x tepi kiri rel (lebar - 305). */
      linear-gradient(var(--border), var(--border)) calc(100% - 304px) 0 / 1px 100% no-repeat,
      linear-gradient(to right, var(--brand-soft) 0 var(--kl-rel, 192px), transparent var(--kl-rel, 192px));
  }
  .kl--relkanan .kl__utama { padding-right: 27px; }
  /* Di bawah 1408 (1360 + selisih rel) rel kanan memakan terlalu banyak dari kolom konten — pada
     1280 kartu "Baru Diubah" tinggal 160px teks; isinya ringkasan yang juga
     bisa dicapai dari keping kategori di atas. */
  @media (max-width: 1408px) {
    .kl__relkanan { display: none; }
    .kl--relkanan {
      background: linear-gradient(to right, var(--brand-soft) 0 var(--kl-rel, 192px), transparent var(--kl-rel, 192px));
    }
    .kl--relkanan .kl__utama { padding-right: 28px; }
  }

  /* --- Ponsel: rel samping jadi menu geser ---------------------------------
     SEMENTARA, atas pilihan pemilik, sampai frame Mobile Coinest diekspor —
     bentuknya mengikuti menu geser panel lama yang sudah di-ACC, bukan
     dikarang dari frame. Sebelumnya rel tetap 192px di layar 390, isinya
     tinggal ~160px, dan halaman bisa digeser 134px ke samping — terukur di
     ketiga belas halaman kit.

     Keadaannya milik RelKit (menutup sendiri saat pindah halaman, Esc, atau
     layar melebar); tombolnya di kepala halaman. */
  .k-kepalahal .kl__menu { display: none; }
  /* 56rem, bukan 40rem seperti semula. Rel 240 menyisakan kolom konten
     cuma 488px pada layar 768 (iPad tegak) — lima halaman terukur bisa
     digeser mendatar di sana, dan delapan belas pada 700; build produksi
     dengan rel 192 sudah bocor pada 700. Di bawah 896 menu geser memberi
     konten seluruh lebar layar (736 pada 768), lebih lega daripada yang
     pernah ada. Padding dan kepala dua baris TETAP milik ponsel (40rem) —
     tablet masih punya ruang untuk kepala sebaris. Angka ini harus sama
     dengan PONSEL di RelKit. */
  @media (max-width: 56rem) {
    .kl { background: none; }
    .kl #kl-rel {
      position: fixed;
      top: 0;
      left: 0;
      z-index: 81;
      height: 100vh;
      height: 100dvh;
      overflow-y: auto;
      overscroll-behavior: contain;
      transform: translateX(-100%);
      /* visibility, bukan cuma geser: rel yang tergeser keluar layar tetap
         bisa dicapai Tab, dan fokus yang hilang ke luar layar adalah cacat
         yang tidak kelihatan sama sekali. */
      visibility: hidden;
      transition: transform 0.2s ease, visibility 0s linear 0.2s;
    }
    .kl #kl-rel.is-buka {
      transform: none;
      visibility: visible;
      transition: transform 0.2s ease;
    }
    .k-kepalahal .kl__menu { display: grid; }
  }
  @media (max-width: 40rem) {
    /* Padding ponsel SENGAJA tidak disetel di sini. Dulu ada
       `padding: 16px 16px 24px`, tapi blok 1248 di bawah juga cocok di
       ponsel dan datang belakangan, jadi yang selalu berlaku 22/20 — dan
       itulah yang sudah di-ACC dan tayang. Aturan yang tidak pernah menyala
       lebih menyesatkan daripada tidak ada. */
    /* Kepala: baris kedua (cari + tombol bulat) selebar layar, kotak cari
       yang mengalah — 237 + tiga tombol 38 tidak muat di 358. */
    .kl-body .k-kepalahal__kanan { flex: 1 1 100%; gap: 10px; }
    .kl-body .k-kepalahal__kanan > .k-cari { flex: 1 1 auto; width: auto; min-width: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .kl #kl-rel { transition: none; }
  }
  /* Tirai menu geser: `.ov-scrim` overlay lama (warna per tema sudah ada di
     sana), satu lapis di bawah relnya. */
  .kl__tirai { z-index: 80; }

  /* Di bawah lebar frame rel sampingnya menyempit jadi ikon saja. Halaman
     admin ini tidak pernah dibuka dari ponsel oleh staf — tapi dibuka dari
     laptop kecil, dan di situ 192 + 1192 + talang tidak muat. */
  @media (max-width: 1248px) {
    .kl__utama {
      padding: 22px 20px 24px;
    }
  }
</style>
