# Salin ke apps/api/.env untuk development lokal.
# Di production nilai-nilai ini diisi lewat Cloud Run env vars + Secret Manager.

# --- Aplikasi ---------------------------------------------------------
APP_ENV=development
PORT=8080
ALLOWED_ORIGINS=http://localhost:4321

# --- Supabase ---------------------------------------------------------
# Connection string POOLER (port 6543, mode transaction). Ambil di
# Supabase Dashboard > Project Settings > Database > Connection pooling.
DATABASE_URL=postgresql://postgres.ddzuzokkqofrpkpokcfa:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

SUPABASE_URL=https://ddzuzokkqofrpkpokcfa.supabase.co
# Settings > API. JANGAN pernah dikirim ke browser.
SUPABASE_SERVICE_ROLE_KEY=
# Settings > API > anon/publishable key. Dipakai backend untuk menukar email
# dan kata sandi dengan token; tetap tidak pernah sampai ke browser, karena
# login pun berjalan lewat API Go.
SUPABASE_ANON_KEY=
# Settings > API > JWT Settings > JWT Secret.
SUPABASE_JWT_SECRET=

# --- Cloudflare R2 ----------------------------------------------------
# Akun pahlevidirgadesignarchitecture — bukan akun Sheetcode.
R2_ACCOUNT_ID=cf6a6bde45d3fd8a93463e6cc7e71aa1
# R2 > Manage API tokens > Create Account API token, izin Object Read & Write,
# dibatasi ke bucket pahlevidirga-media. Secret hanya ditampilkan sekali.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pahlevidirga-media
# Bucket sudah dibuat di lokasi APAC dengan CORS untuk presigned upload.
#
# Sementara memakai domain r2.dev bawaan Cloudflare. Ini SEMENTARA: r2.dev
# kena rate limit dan tidak untuk produksi. Begitu domain sendiri aktif,
# pasang custom domain media.<domain> di bucket lalu ganti nilai di bawah.
R2_PUBLIC_BASE_URL=https://pub-e4c6ca03e74842e195bb46bc8445269f.r2.dev

# --- Cloudflare Turnstile --------------------------------------------
# Widget "Form kontak pahlevidirga" sudah dibuat, mode managed.
# Sitekey (publik, boleh masuk browser): 0x4AAAAAAEZs0rw-a5wLca7C
# Secret key diambil sendiri di dashboard: Turnstile > widget > Settings.
# Kosongkan saat development untuk melewati verifikasi.
TURNSTILE_SECRET_KEY=

# --- Email (Resend) ---------------------------------------------------
RESEND_API_KEY=
INQUIRY_NOTIFY_TO=studio@pahlevidirga.com
INQUIRY_FROM=website@pahlevidirga.com

# --- Privasi ----------------------------------------------------------
# String acak panjang. Tanpa ini, hash IP di tabel inquiries dikosongkan.
# Generate: openssl rand -hex 32
IP_HASH_SALT=

# --- Frontend (apps/web/.env) ----------------------------------------
# PUBLIC_API_BASE_URL=http://localhost:8080
# PUBLIC_SITE_URL=http://localhost:4321
# PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEZs0rw-a5wLca7C
